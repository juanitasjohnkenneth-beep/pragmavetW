# Uploaded files are data, never programs: nothing in this folder may run as a script.
<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|phps|cgi|pl|py|sh|asp|aspx|jsp|exe|bat|cmd|shtml)$">
    Require all denied
</FilesMatch>
<IfModule php_module>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
Options -ExecCGI -Indexes
