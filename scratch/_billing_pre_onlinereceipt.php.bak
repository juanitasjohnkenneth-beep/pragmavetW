<?php
if (session_status() === PHP_SESSION_NONE) {
    session_start();
}
include("dbconnection.php");
include("paymongo_config.php");

if (!isset($_SESSION['user_id'])) {
    header("Location: index.php");
    exit();
}
include_once("includes/rbac_guard.php");
include_once("includes/service_prices.php");
// RBAC: Client Portal access control
$user_role = rbac_get_role();
if (!in_array($user_role, ['user', 'client'])) {
    header("Location: " . rbac_home_url($user_role));
    exit();
}

$user_id   = (int)$_SESSION['user_id'];
$user_name = $_SESSION['user'] ?? 'Valued Client';

$domain = (isset($_SERVER['HTTPS']) && $_SERVER['HTTPS'] === 'on' ? 'https' : 'http') . '://' . ($_SERVER['HTTP_HOST'] ?? 'localhost') . '/pragmavet';

// JS redirect utility
function billing_redirect($url) {
    echo '<!DOCTYPE html><html><head>'
       . '<meta http-equiv="refresh" content="0;url=' . htmlspecialchars($url, ENT_QUOTES) . '">'
       . '<script>window.location.replace(' . json_encode($url) . ');</script>'
       . '</head><body></body></html>';
    exit();
}

// Ensure required billing columns exist
$billingCols = [
    'downpayment_amount'  => "DECIMAL(10,2) NOT NULL DEFAULT 0",
    'downpayment_status'  => "VARCHAR(20) NOT NULL DEFAULT 'Unpaid'",
    'downpayment_paid_at' => 'DATETIME DEFAULT NULL',
    'is_boarding'         => 'TINYINT(1) NOT NULL DEFAULT 0',
];
foreach ($billingCols as $col => $def) {
    $r = $conn->query("SHOW COLUMNS FROM billing LIKE '$col'");
    if ($r && $r->num_rows === 0) {
        $conn->query("ALTER TABLE billing ADD COLUMN `$col` $def");
    }
}

// ── Auto-generate billing entries for Approved / Completed appointments without a bill ──
$unbilled_appts = $conn->query("
    SELECT a.id, a.pet_name, a.service_type, a.status 
    FROM appointments a 
    LEFT JOIN billing b ON b.appointment_id = a.id 
    WHERE a.user_id = $user_id 
      AND a.status IN ('Approved', 'Completed') 
      AND b.id IS NULL
");
if ($unbilled_appts && $unbilled_appts->num_rows > 0) {
    while ($ua = $unbilled_appts->fetch_assoc()) {
        $amount = sp_price($conn, $ua['service_type']); // price set by the admin in System Settings
        
        $p_status = ($ua['status'] === 'Completed') ? 'Paid' : 'Unpaid';
        $ins_stmt = $conn->prepare("INSERT INTO billing (appointment_id, total_amount, payment_status, is_boarding, downpayment_status) VALUES (?, ?, ?, 0, 'Unpaid')");
        if ($ins_stmt) {
            $ins_stmt->bind_param("ids", $ua['id'], $amount, $p_status);
            $ins_stmt->execute();
        }
    }
}

// ── Auto-generate billing entries for Boarding Reservations without a bill ──
$unbilled_boarding = $conn->query("
    SELECT br.id, br.pet_name, br.appointment_date, br.end_date, br.status 
    FROM boarding_reservations br 
    LEFT JOIN billing b ON b.boarding_res_id = br.id AND b.is_boarding = 1 
    WHERE br.user_id = $user_id 
      AND br.status NOT IN ('Cancelled', 'Rejected') 
      AND b.id IS NULL
");
if ($unbilled_boarding && $unbilled_boarding->num_rows > 0) {
    while ($ub = $unbilled_boarding->fetch_assoc()) {
        $days = max(1, round((strtotime($ub['end_date']) - strtotime($ub['appointment_date'])) / 86400));
        $total = round($days * sp_boarding_rate($conn), 2);
        $dp = round($total * 0.30, 2);
        $ins_stmt = $conn->prepare("INSERT INTO billing (boarding_res_id, appointment_id, total_amount, downpayment_amount, is_boarding, downpayment_status, payment_status) VALUES (?, NULL, ?, ?, 1, 'Unpaid', 'Unpaid')");
        if ($ins_stmt) {
            $ins_stmt->bind_param("idd", $ub['id'], $total, $dp);
            $ins_stmt->execute();
        }
    }
}

// ── Initiate PayMongo Payment Checkout ──
if (isset($_GET['initpay'], $_GET['invoice_id'])) {
    $invoice_id = (int)$_GET['invoice_id'];
    $pay_type   = $_GET['initpay']; // 'full', 'downpayment', or 'balance'
    if (!in_array($pay_type, ['full', 'downpayment', 'balance'], true)) $pay_type = 'full';

    $row = $conn->query("
        SELECT b.*, 
               br.id as res_id, br.appointment_date as b_start, br.end_date as b_end, br.pet_name as b_pet,
               a.id as appt_id, a.pet_name as a_pet, a.service_type as a_service
        FROM billing b
        LEFT JOIN boarding_reservations br ON b.boarding_res_id = br.id
        LEFT JOIN appointments a ON b.appointment_id = a.id
        WHERE b.id = $invoice_id
          AND (a.user_id = $user_id OR br.user_id = $user_id)
    ")->fetch_assoc();

    if ($row && $row['payment_status'] === 'Paid') {
        $_SESSION['message']  = 'This invoice is already paid.';
        $_SESSION['msg_type'] = 'info';
    } elseif ($row) {
        $total = (float)$row['total_amount'];
        $is_boarding = (int)$row['is_boarding'] === 1;

        if ($is_boarding) {
            $dp = (float)$row['downpayment_amount'];
            if ($dp <= 0) $dp = round($total * 0.30, 2);
            $paid_dp   = in_array($row['downpayment_status'] ?? '', ['Paid', 'Partial'], true) ? (float)$row['downpayment_amount'] : 0;
            $remaining = max(0, $total - $paid_dp);

            if ($pay_type === 'downpayment') {
                $charge = $dp;
                $label  = 'PragmaVet Boarding (30% Downpayment) - ' . ($row['b_pet'] ?? 'Pet');
            } elseif ($pay_type === 'balance') {
                $charge = $remaining;
                $label  = 'PragmaVet Boarding (Remaining Balance) - ' . ($row['b_pet'] ?? 'Pet');
            } else {
                $charge = $total;
                $label  = 'PragmaVet Boarding (Full Payment) - ' . ($row['b_pet'] ?? 'Pet');
            }
        } else {
            $credit = (($row['downpayment_status'] ?? '') === 'Paid') ? (float)$row['downpayment_amount'] : 0;
            $charge = max(0, round($total - $credit, 2)); // reservation fee already paid is deducted
            $label  = 'PragmaVet ' . ($row['a_service'] ?? 'Clinic Service') . ' - ' . ($row['a_pet'] ?? 'Pet');
        }

        $result = paymongo_create_checkout(
            $charge, $label,
            $domain . '/billing.php?pm_success=' . $pay_type . '&invoice_id=' . $invoice_id,
            $domain . '/billing.php?pm_cancelled=1',
            ['invoice_id' => (string)$invoice_id, 'type' => $pay_type]
        );

        if (isset($result['url'])) {
            $_SESSION['pm_checkout'][$invoice_id] = ['id' => $result['id'] ?? null, 'type' => $pay_type];
            billing_redirect($result['url']);
        }
        $_SESSION['message']  = 'Payment gateway error: ' . ($result['error'] ?? 'Please try again later.');
        $_SESSION['msg_type'] = 'danger';
    } else {
        $_SESSION['message']  = 'Invoice record not found.';
        $_SESSION['msg_type'] = 'danger';
    }
    billing_redirect('billing.php');
}

// ── PayMongo Success Return Callback ──
if (isset($_GET['pm_success'], $_GET['invoice_id'])) {
    $invoice_id = (int)$_GET['invoice_id'];
    $pending    = $_SESSION['pm_checkout'][$invoice_id] ?? null;
    $type       = $pending['type'] ?? '';
    $now        = date('Y-m-d H:i:s');

    // Only trust the return URL if PayMongo confirms this checkout session was paid
    $verified = false;
    if ($pending) {
        if (DEMO_MODE) {
            $verified = true;
        } elseif (!empty($pending['id'])) {
            $cs = paymongo_retrieve_checkout($pending['id']);
            $attrs = $cs['data']['attributes'] ?? [];
            if (($attrs['payment_intent']['attributes']['status'] ?? '') === 'succeeded') $verified = true;
            foreach (($attrs['payments'] ?? []) as $p) {
                if (($p['attributes']['status'] ?? '') === 'paid') $verified = true;
            }
        }
    }

    $bRow = $verified ? $conn->query("
        SELECT b.* FROM billing b
        LEFT JOIN appointments a ON b.appointment_id = a.id
        LEFT JOIN boarding_reservations br ON b.boarding_res_id = br.id
        WHERE b.id = $invoice_id AND (a.user_id = $user_id OR br.user_id = $user_id)
    ")->fetch_assoc() : null;
    if (!$bRow) {
        $_SESSION['message']  = 'We could not confirm this payment with PayMongo. If you were charged, please contact the clinic.';
        $_SESSION['msg_type'] = 'danger';
    }
    if ($bRow) {
        unset($_SESSION['pm_checkout'][$invoice_id]);
        $is_boarding = (int)$bRow['is_boarding'] === 1;
        $total = (float)$bRow['total_amount'];
        $dp = (float)$bRow['downpayment_amount'];
        if ($dp <= 0) $dp = round($total * 0.30, 2);

        if ($is_boarding) {
            $res_id = (int)($bRow['boarding_res_id'] ?? 0);
            if ($type === 'downpayment') {
                $conn->query("UPDATE billing SET downpayment_status='Paid', downpayment_amount=$dp, downpayment_paid_at='$now' WHERE id=$invoice_id");
                if ($res_id) $conn->query("UPDATE boarding_reservations SET status='Approved' WHERE id=$res_id AND status='Pending'");
                $_SESSION['message'] = 'Downpayment received! Pet boarding reservation is officially approved.';
            } else {
                $conn->query("UPDATE billing SET payment_status='Paid', amount_paid=total_amount, payment_method='PayMongo', paid_at='$now' WHERE id=$invoice_id");
                if ($res_id) $conn->query("UPDATE boarding_reservations SET status='Approved' WHERE id=$res_id AND status='Pending'");
                $_SESSION['message'] = 'Full payment confirmed! Reservation is fully settled.';
            }
        } else {
            // Appointment visit payment
            $conn->query("UPDATE billing SET payment_status='Paid', amount_paid=total_amount, payment_method='PayMongo', paid_at=NOW() WHERE id=$invoice_id");
            if (!empty($bRow['appointment_id'])) {
                $conn->query("UPDATE appointments SET status='Approved' WHERE id={$bRow['appointment_id']} AND status='Pending'");
            }
            $_SESSION['message'] = 'Payment confirmed! Thank you for choosing PragmaVet.';
        }
        $_SESSION['msg_type'] = 'success';
    }
    header('Location: billing.php');
    exit();
}

// ── PayMongo Cancelled Callback ──
if (isset($_GET['pm_cancelled'])) {
    $_SESSION['message']  = 'Checkout cancelled. No charges were made.';
    $_SESSION['msg_type'] = 'warning';
    header('Location: billing.php');
    exit();
}

// ── Unified Query: Fetch All Client Invoices (Appointments & Boarding) ──
$invoices_query = "
    SELECT 
        b.id AS invoice_id,
        b.total_amount,
        COALESCE(b.payment_status, 'Unpaid') AS payment_status,
        COALESCE(b.downpayment_status, 'Unpaid') AS downpayment_status,
        COALESCE(b.downpayment_amount, 0) AS downpayment_amount,
        b.downpayment_paid_at,
        b.created_at AS bill_date,
        b.is_boarding,
        
        -- Appointment details
        a.id AS appointment_id,
        a.pet_name AS appt_pet,
        a.service_type AS appt_service,
        a.appointment_date AS appt_date,
        a.appointment_time AS appt_time,
        a.status AS appt_status,
        u_doc.fullname AS doctor_name,
        
        -- Boarding details
        br.id AS boarding_id,
        br.pet_name AS board_pet,
        br.appointment_date AS checkin_date,
        br.end_date AS checkout_date,
        br.cage_number,
        br.status AS board_status
    FROM billing b
    LEFT JOIN appointments a ON b.appointment_id = a.id
    LEFT JOIN users u_doc ON a.doctor_id = u_doc.id
    LEFT JOIN boarding_reservations br ON b.boarding_res_id = br.id
    WHERE (a.user_id = $user_id OR br.user_id = $user_id)
      AND (a.status IS NULL OR a.status NOT IN ('Cancelled', 'Rejected'))
      AND (br.status IS NULL OR br.status NOT IN ('Cancelled', 'Rejected'))
    ORDER BY b.created_at DESC, b.id DESC
";
$invoices_result = $conn->query($invoices_query);
$invoices = [];
$total_paid = 0.0;
$total_unpaid = 0.0;
$pending_count = 0;

if ($invoices_result && $invoices_result->num_rows > 0) {
    while ($inv = $invoices_result->fetch_assoc()) {
        $is_b = (int)$inv['is_boarding'] === 1;
        $amt  = (float)$inv['total_amount'];
        $dp   = (float)$inv['downpayment_amount'];
        if ($is_b && $dp <= 0) $dp = round($amt * 0.30, 2);
        
        $p_status  = $inv['payment_status'];
        $dp_status = $inv['downpayment_status'];

        // Financial metrics computation
        if ($p_status === 'Paid') {
            $total_paid += $amt;
        } elseif ($dp_status === 'Paid' && $dp > 0) {
            $total_paid += $dp;
            $total_unpaid += max(0, $amt - $dp);
            $pending_count++;
        } else {
            $total_unpaid += $amt;
            $pending_count++;
        }

        $inv['computed_dp'] = $dp;
        $inv['remaining_balance'] = max(0, $amt - $dp);
        $invoices[] = $inv;
    }
}
?>
