<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
// Filter invoices by category
function filterInvoices(category, btnElement) {
    // Update active button state
    document.querySelectorAll('#filterBtnGroup .filter-btn').forEach(btn => btn.classList.remove('active'));
    if (btnElement) btnElement.classList.add('active');

    const items = document.querySelectorAll('.invoice-item');
    let count = 0;

    items.forEach(item => {
        const type = item.getAttribute('data-type');
        const status = item.getAttribute('data-status');

        let match = false;
        if (category === 'all') match = true;
        else if (category === 'appointment' && type === 'appointment') match = true;
        else if (category === 'boarding' && type === 'boarding') match = true;
        else if (category === 'paid' && status === 'paid') match = true;
        else if (category === 'unpaid' && status === 'unpaid') match = true;

        if (match) {
            item.style.display = '';
            count++;
        } else {
            item.style.display = 'none';
        }
    });

    const visibleCountEl = document.getElementById('visibleCount');
    if (visibleCountEl) visibleCountEl.textContent = count;
}

// Open printable receipt modal with invoice payload
function openReceiptModal(inv) {
    const isBoarding = parseInt(inv.is_boarding) === 1;
    const pet = isBoarding ? inv.board_pet : inv.appt_pet;
    const service = isBoarding ? 'Pet Boarding & Care' : (inv.appt_service || 'Veterinary Service');
    const total = parseFloat(inv.total_amount).toFixed(2);
    const isPaid = inv.payment_status === 'Paid';
    const isDpPaid = isBoarding && inv.downpayment_status === 'Paid';
    const dp = parseFloat(inv.computed_dp || 0).toFixed(2);
    const rem = parseFloat(inv.remaining_balance || 0).toFixed(2);

    let statusPill = isPaid 
        ? '<span class="badge-paid"><i class="fa fa-check-circle"></i> Paid in Full</span>'
        : (isDpPaid ? '<span class="badge-dp"><i class="fa fa-circle-half-stroke"></i> Downpayment Paid</span>' : '<span class="badge-pending"><i class="fa fa-clock"></i> Payment Due</span>');

    const schedule = isBoarding 
        ? `${inv.checkin_date} to ${inv.checkout_date}`
        : (inv.appt_date || inv.bill_date);

        let payButtonsHtml = "";
    if (!isPaid) {
        if (isBoarding && !isDpPaid) {
            payButtonsHtml = `
                <div class="d-flex gap-2 w-100 mt-3 pt-3" style="border-top: 1px solid #eef2f6;">
                    <a href="billing.php?initpay=downpayment&invoice_id=${inv.invoice_id}" class="btn-pay-now flex-fill text-center" style="text-decoration:none;">
                        <i class="fa fa-shield-halved"></i> Pay 30% DP (&#8369;${dp})
                    </a>
                    <a href="billing.php?initpay=full&invoice_id=${inv.invoice_id}" class="btn-pay-now flex-fill text-center" style="background:#ffffff; color:#2563eb; border: 1.5px solid #2563eb; text-decoration:none;">
                        Pay Full
                    </a>
                </div>
            `;
        } else if (isBoarding && isDpPaid) {
            payButtonsHtml = `
                <div class="w-100 mt-3 pt-3" style="border-top: 1px solid #eef2f6;">
                    <a href="billing.php?initpay=balance&invoice_id=${inv.invoice_id}" class="btn-pay-now w-100 d-block text-center" style="text-decoration:none;">
                        <i class="fa fa-credit-card"></i> Pay Balance (&#8369;${rem})
                    </a>
                </div>
            `;
        } else {
            payButtonsHtml = `
                <div class="w-100 mt-3 pt-3" style="border-top: 1px solid #eef2f6;">
                    <a href="billing.php?initpay=full&invoice_id=${inv.invoice_id}" class="btn-pay-now w-100 d-block text-center" style="text-decoration:none;">
                        <i class="fa fa-credit-card"></i> Pay Now (&#8369;${inv.downpayment_status === 'Paid' && parseFloat(inv.computed_dp) > 0 ? rem : total})
                    </a>
                </div>
            `;
        }
    }

    let html = `
        <div style="background: #f8fafc; border: 1px solid #eef2f6; border-radius: 14px; padding: 18px; margin-bottom: 20px;">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted" style="font-size: 13px;">Invoice Number</span>
                <span class="fw-bold" style="color: #0f172a; font-size: 15px;">#INV-${String(inv.invoice_id).padStart(5, '0')}</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted" style="font-size: 13px;">Invoice Date</span>
                <span class="fw-semibold" style="color: #334155; font-size: 13px;">${inv.bill_date || 'N/A'}</span>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted" style="font-size: 13px;">Payment Status</span>
                <div>${statusPill}</div>
            </div>
        </div>

        <div class="mb-3" style="font-size: 13.5px; color: #475569;">
            <div class="mb-2"><strong>Client:</strong> <?= htmlspecialchars($user_name) ?></div>
            <div class="mb-2"><strong>Patient Pet:</strong> ${pet || 'N/A'}</div>
            <div class="mb-2"><strong>Service:</strong> ${service}</div>
            <div class="mb-2"><strong>Date / Schedule:</strong> ${schedule}</div>
            ${isBoarding && inv.cage_number ? `<div class="mb-2"><strong>Room/Cage:</strong> Unit #${inv.cage_number}</div>` : ''}
            ${!isBoarding && inv.doctor_name ? `<div class="mb-2"><strong>Doctor:</strong> ${inv.doctor_name}</div>` : ''}
        </div>

        <div style="border-top: 1px dashed #cbd5e1; border-bottom: 1px dashed #cbd5e1; padding: 14px 0; margin-bottom: 16px;">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span style="color: #64748b; font-size: 13px;">Service Fee Subtotal:</span>
                <span class="fw-bold" style="color: #0f172a; font-size: 15px;">₱${total}</span>
            </div>
            ${isBoarding ? `
                <div class="d-flex justify-content-between align-items-center mb-1 text-muted" style="font-size: 12px;">
                    <span>30% Required Downpayment:</span>
                    <span>₱${dp}</span>
                </div>
                ${isDpPaid && !isPaid ? `
                <div class="d-flex justify-content-between align-items-center text-primary fw-semibold" style="font-size: 12.5px;">
                    <span>Remaining Balance Due:</span>
                    <span>₱${rem}</span>
                </div>` : ''}
            ` : ''}
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <span class="fw-bold" style="font-size: 16px; color: #0f172a;">${isPaid ? 'Total Paid:' : 'Total Payable:'}</span>
            <span class="fw-bold" style="font-size: 24px; color: #2563eb;">₱${isDpPaid && !isPaid ? rem : total}</span>
        </div>
        ${payButtonsHtml}
    `;

    document.getElementById('printableReceiptArea').innerHTML = html;
    const modal = new bootstrap.Modal(document.getElementById('receiptModal'));
    modal.show();
}
</script>

<?php include_once("includes/reminder_popup.php"); ?>
