        .brand-name      { font-size: 22px; font-weight: 800; color: #fff; letter-spacing: -0.4px; }
        .user-welcome-card { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; padding: 14px 16px; margin-bottom: 20px; }
        .user-welcome-card .greeting  { font-size: 12px; color: #94a3b8; font-weight: 500; }
        .user-welcome-card .user-title { font-weight: 700; color: #fff; font-size: 14.5px; margin-top: 2px; }
