<!-- Auto Dismiss Alerts -->
<script>
setTimeout(function() {
    let alerts = document.querySelectorAll('.alert');
    alerts.forEach(a => {
        a.classList.remove('show');
        setTimeout(() => a.parentElement.remove(), 500);
    });
}, 3000);
</script>
