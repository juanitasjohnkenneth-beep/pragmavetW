<?php
session_start();
include("dbconnection.php");

$user_role = $_SESSION['role'] ?? '';
$is_admin = ($user_role === 'admin');
$is_owner = ($user_role === 'clinic_owner' || $user_role === 'owner');
$is_staff = ($user_role === 'staff');
$is_doctor = ($user_role === 'doctor');

if(!isset($_SESSION['user_id']) || (!$is_admin && !$is_owner && !$is_staff && !$is_doctor)){
    header("Location: index.php");
    exit();
}

// Log Vitals
if(isset($_POST['log_vitals'])) {
    $pet_id   = (int)$_POST['pet_id'];
    $temp     = (float)$_POST['temperature'];
    $hr       = (int)$_POST['heart_rate'];
    $notes    = $_POST['notes'];

    $stmt = $conn->prepare("INSERT INTO monitoring(pet_id, temperature, heart_rate, notes) VALUES(?,?,?,?)");
    $stmt->bind_param("idis", $pet_id, $temp, $hr, $notes);

    if($stmt->execute()){
        $_SESSION['message'] = "Vital signs recorded successfully.";
        $_SESSION['msg_type'] = "success";
    } else {
        $_SESSION['message'] = "Error recording vitals.";
        $_SESSION['msg_type'] = "danger";
    }
    header("Location: admin_monitoring.php");
    exit();
}

// â”€â”€ Fetch pets for dropdown (registered pets + currently boarded pets via cage) â”€â”€
$pets_query = $conn->query("
    SELECT DISTINCT p.id, p.name, p.species
    FROM pets p
    ORDER BY p.name ASC
");

// â”€â”€ Fetch currently boarded pets (live cage synced view) â”€â”€
$boarded_query = $conn->query("
    SELECT br.id as res_id, br.cage_number, br.pet_name, br.appointment_date, br.end_date,
           br.status, br.cctv_link, br.cctv_enabled,
           u.fullname as owner_name,
           (SELECT m.temperature FROM monitoring m
            JOIN pets p2 ON m.pet_id=p2.id
            WHERE p2.name = br.pet_name
            ORDER BY m.recorded_at DESC LIMIT 1) as last_temp,
           (SELECT m.heart_rate FROM monitoring m
            JOIN pets p2 ON m.pet_id=p2.id
            WHERE p2.name = br.pet_name
            ORDER BY m.recorded_at DESC LIMIT 1) as last_hr,
           (SELECT m.recorded_at FROM monitoring m
            JOIN pets p2 ON m.pet_id=p2.id
            WHERE p2.name = br.pet_name
            ORDER BY m.recorded_at DESC LIMIT 1) as last_logged
    FROM boarding_reservations br
    JOIN users u ON br.user_id = u.id
    WHERE br.status IN ('Approved','Pending')
      AND br.service_type = 'Pet Boarding Reservation'
      AND br.appointment_date <= CURDATE()
      AND br.end_date >= CURDATE()
    ORDER BY br.cage_number ASC
");

// â”€â”€ Fetch recent monitoring logs â”€â”€
$logs = $conn->query("
    SELECT m.*, p.name as pet_name, p.species
    FROM monitoring m
    JOIN pets p ON m.pet_id = p.id
    ORDER BY m.recorded_at DESC LIMIT 20
");
?>
