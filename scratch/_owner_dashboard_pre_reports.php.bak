                            <span>Payment Method:</span>
                            <span id="modalMethod">Cash</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mb-2" id="modalRefRow" style="display:none;">
                            <span>Ref #:</span>
                            <span id="modalRef"></span>
                        </div>

