<?php
if (session_status() === PHP_SESSION_NONE) {
    session_start();
}
include("dbconnection.php");

// 1. AUTHENTICATION & ACCESS GUARD
if (!isset($_SESSION['user_id'])) {
    header("Location: index.php");
    exit();
}

$user_id = $_SESSION['user_id'];
$user_role = $_SESSION['role'] ?? '';
$user_name = $_SESSION['user'] ?? 'Clinic Owner';

// Restrict strictly to clinic_owner or owner
if ($user_role !== 'clinic_owner' && $user_role !== 'owner') {
    if ($user_role === 'admin') {
        header("Location: admin.php");
    } elseif ($user_role === 'doctor') {
        header("Location: doctor.php");
    } else {
        header("Location: dashboard.php");
    }
    exit();
}

// 2. DATE PERIOD & RANGE FILTERING
$period = $_GET['period'] ?? 'all';
$start_date_input = trim($_GET['start_date'] ?? '');
$end_date_input = trim($_GET['end_date'] ?? '');

$filter_label = "All-Time Records";
$filter_badge = "All Time";
$filter_sql_billing = "1=1";
$filter_sql_appts = "1=1";
$start_date = '';
$end_date = '';
$is_filtered = false;

if ($period === 'today') {
    $start_date = date('Y-m-d');
    $end_date = date('Y-m-d');
    $filter_label = "Today's Performance (" . date('F j, Y') . ")";
    $filter_badge = "Today";
    $is_filtered = true;
} elseif ($period === 'week') {
    $start_date = date('Y-m-d', strtotime('monday this week'));
    $end_date = date('Y-m-d', strtotime('sunday this week'));
    $filter_label = "This Week (" . date('M j', strtotime($start_date)) . " - " . date('M j, Y', strtotime($end_date)) . ")";
    $filter_badge = "This Week";
    $is_filtered = true;
} elseif ($period === 'month') {
    $start_date = date('Y-m-01');
    $end_date = date('Y-m-t');
    $filter_label = "This Month (" . date('F Y') . ")";
    $filter_badge = "This Month";
    $is_filtered = true;
} elseif ($period === 'last_month') {
    $start_date = date('Y-m-01', strtotime('first day of last month'));
    $end_date = date('Y-m-t', strtotime('last day of last month'));
    $filter_label = "Last Month (" . date('F Y', strtotime($start_date)) . ")";
    $filter_badge = "Last Month";
    $is_filtered = true;
} elseif ($period === 'year') {
    $start_date = date('Y-01-01');
    $end_date = date('Y-12-31');
    $filter_label = "This Year (" . date('Y') . ")";
    $filter_badge = "This Year";
    $is_filtered = true;
} elseif ($period === 'custom' || (!empty($start_date_input) && !empty($end_date_input))) {
    $period = 'custom';
    $start_date = date('Y-m-d', strtotime($start_date_input));
    $end_date = date('Y-m-d', strtotime($end_date_input));
    if ($start_date > $end_date) {
        $temp = $start_date;
        $start_date = $end_date;
        $end_date = $temp;
    }
    $filter_label = "Custom: " . date('M j, Y', strtotime($start_date)) . " to " . date('M j, Y', strtotime($end_date));
    $filter_badge = "Custom Range";
    $is_filtered = true;
} else {
    $period = 'all';
    $filter_label = "All-Time Clinic History";
    $filter_badge = "All Time";
    $is_filtered = false;
}

if ($is_filtered && !empty($start_date) && !empty($end_date)) {
    $filter_sql_billing = "DATE(b.created_at) BETWEEN '$start_date' AND '$end_date'";
    $filter_sql_appts   = "a.appointment_date BETWEEN '$start_date' AND '$end_date'";
}

// 3. FINANCIAL ANALYTICS - ACCURATE AGGREGATION FILTERED BY PERIOD
$totals_q = $conn->query("
    SELECT 
        COUNT(*) as total_bills,
        IFNULL(SUM(total_amount), 0) as gross_billed,
        IFNULL(SUM(CASE 
            WHEN payment_status = 'Paid' THEN (CASE WHEN amount_paid > 0 THEN amount_paid ELSE total_amount END)
            WHEN downpayment_status = 'Paid' THEN (CASE WHEN amount_paid > 0 THEN amount_paid ELSE downpayment_amount END)
            ELSE 0 
        END), 0) as total_collected,
        IFNULL(SUM(CASE 
            WHEN payment_status = 'Paid' THEN 0
            WHEN downpayment_status = 'Paid' THEN GREATEST(0, total_amount - (CASE WHEN amount_paid > 0 THEN amount_paid ELSE downpayment_amount END))
            ELSE total_amount 
        END), 0) as total_receivable,
        SUM(CASE WHEN payment_status = 'Paid' THEN 1 ELSE 0 END) as count_paid,
        SUM(CASE WHEN payment_status != 'Paid' AND downpayment_status = 'Paid' THEN 1 ELSE 0 END) as count_partial,
        SUM(CASE WHEN payment_status != 'Paid' AND (downpayment_status != 'Paid' OR downpayment_status IS NULL) THEN 1 ELSE 0 END) as count_unpaid
    FROM billing b
    WHERE $filter_sql_billing
");
$stats = $totals_q ? $totals_q->fetch_assoc() : [
    'total_bills' => 0, 'gross_billed' => 0, 'total_collected' => 0, 'total_receivable' => 0,
    'count_paid' => 0, 'count_partial' => 0, 'count_unpaid' => 0
];

$total_invoices   = (int)$stats['total_bills'];
$total_revenue    = (float)$stats['gross_billed'];
$total_collected  = (float)$stats['total_collected'];
$total_receivable = (float)$stats['total_receivable'];
$count_paid       = (int)$stats['count_paid'];
$count_partial    = (int)$stats['count_partial'];
$count_unpaid     = (int)$stats['count_unpaid'];

// Revenue Streams Split (Filtered)
$clinic_rev_q = $conn->query("SELECT IFNULL(SUM(total_amount), 0) as rev FROM billing b WHERE is_boarding = 0 AND (service_category != 'POS' OR service_category IS NULL) AND $filter_sql_billing");
$clinic_rev = (float)($clinic_rev_q ? $clinic_rev_q->fetch_assoc()['rev'] : 0);

$boarding_rev_q = $conn->query("SELECT IFNULL(SUM(total_amount), 0) as rev FROM billing b WHERE is_boarding = 1 AND $filter_sql_billing");
$boarding_rev = (float)($boarding_rev_q ? $boarding_rev_q->fetch_assoc()['rev'] : 0);

$pos_rev_q = $conn->query("SELECT IFNULL(SUM(total_amount), 0) as rev FROM billing b WHERE service_category = 'POS' AND $filter_sql_billing");
$pos_rev = (float)($pos_rev_q ? $pos_rev_q->fetch_assoc()['rev'] : 0);

// Today's Collections
$today_coll_q = $conn->query("SELECT IFNULL(SUM(CASE WHEN amount_paid > 0 THEN amount_paid ELSE total_amount END), 0) as coll FROM billing WHERE DATE(paid_at) = CURDATE() OR (paid_at IS NULL AND payment_status='Paid' AND DATE(created_at) = CURDATE())");
$today_collected = (float)($today_coll_q ? $today_coll_q->fetch_assoc()['coll'] : 0);

// Monthly Revenue Trend (All Recorded Monthly Cohorts)
$m_q = $conn->query("SELECT 
    DATE_FORMAT(created_at, '%b %Y') as m_label,
    SUM(CASE WHEN is_boarding = 0 THEN total_amount ELSE 0 END) as clinic_rev,
    SUM(CASE WHEN is_boarding = 1 THEN total_amount ELSE 0 END) as boarding_rev,
    SUM(total_amount) as total_gross,
    SUM(CASE 
        WHEN payment_status = 'Paid' THEN (CASE WHEN amount_paid > 0 THEN amount_paid ELSE total_amount END)
        WHEN downpayment_status = 'Paid' THEN (CASE WHEN amount_paid > 0 THEN amount_paid ELSE downpayment_amount END)
        ELSE 0 
    END) as total_collected
FROM billing
GROUP BY DATE_FORMAT(created_at, '%Y-%m')
ORDER BY created_at ASC");

$chart_m_labels = [];
$chart_clinic_rev = [];
$chart_boarding_rev = [];
$chart_total_rev = [];
$chart_collected_rev = [];

if ($m_q && $m_q->num_rows > 0) {
    while ($m_row = $m_q->fetch_assoc()) {
        $chart_m_labels[]      = $m_row['m_label'];
        $chart_clinic_rev[]    = (float)$m_row['clinic_rev'];
        $chart_boarding_rev[]  = (float)$m_row['boarding_rev'];
        $chart_total_rev[]     = (float)$m_row['total_gross'];
        $chart_collected_rev[] = (float)$m_row['total_collected'];
    }
}

// 4. APPOINTMENT METRICS (FILTERED BY PERIOD)
$total_appts_q = $conn->query("SELECT COUNT(*) as cnt FROM appointments a WHERE $filter_sql_appts");
$total_appts = (int)($total_appts_q ? $total_appts_q->fetch_assoc()['cnt'] : 0);

$completed_appts_q = $conn->query("SELECT COUNT(*) as cnt FROM appointments a WHERE a.status='Completed' AND $filter_sql_appts");
$completed_appts = (int)($completed_appts_q ? $completed_appts_q->fetch_assoc()['cnt'] : 0);

$approved_appts_q = $conn->query("SELECT COUNT(*) as cnt FROM appointments a WHERE a.status='Approved' AND $filter_sql_appts");
$approved_appts = (int)($approved_appts_q ? $approved_appts_q->fetch_assoc()['cnt'] : 0);

$pending_appts_q = $conn->query("SELECT COUNT(*) as cnt FROM appointments a WHERE a.status IN ('Pending', 'Reschedule Requested') AND $filter_sql_appts");
$pending_appts = (int)($pending_appts_q ? $pending_appts_q->fetch_assoc()['cnt'] : 0);

$cancelled_appts_q = $conn->query("SELECT COUNT(*) as cnt FROM appointments a WHERE a.status IN ('Cancelled', 'Rejected') AND $filter_sql_appts");
$cancelled_appts = (int)($cancelled_appts_q ? $cancelled_appts_q->fetch_assoc()['cnt'] : 0);

$noshow_appts_q = $conn->query("SELECT COUNT(*) as cnt FROM appointments a WHERE a.status='No Show' AND $filter_sql_appts");
$noshow_appts = (int)($noshow_appts_q ? $noshow_appts_q->fetch_assoc()['cnt'] : 0);

// 5. CLIENTS & PATIENTS OVERVIEW
$total_clients_q = $conn->query("SELECT COUNT(*) as cnt FROM users WHERE role IN ('user', 'client')");
$total_clients = (int)($total_clients_q ? $total_clients_q->fetch_assoc()['cnt'] : 0);

$total_pets_q = $conn->query("SELECT COUNT(*) as cnt FROM pets");
$total_pets = (int)($total_pets_q ? $total_pets_q->fetch_assoc()['cnt'] : 0);

$dogs_count_q = $conn->query("SELECT COUNT(*) as cnt FROM pets WHERE LOWER(species) LIKE '%dog%' OR LOWER(species) LIKE '%canine%'");
$dogs_count = (int)($dogs_count_q ? $dogs_count_q->fetch_assoc()['cnt'] : 0);

$cats_count_q = $conn->query("SELECT COUNT(*) as cnt FROM pets WHERE LOWER(species) LIKE '%cat%' OR LOWER(species) LIKE '%feline%'");
$cats_count = (int)($cats_count_q ? $cats_count_q->fetch_assoc()['cnt'] : 0);
$other_pets_count = max(0, $total_pets - ($dogs_count + $cats_count));

// 6. BOARDING CAPACITY
$occ_count_q = $conn->query("SELECT COUNT(DISTINCT cage_number) as occ FROM boarding_reservations WHERE status='Approved' AND appointment_date <= CURDATE() AND end_date >= CURDATE()");
$occ_count = (int)($occ_count_q ? $occ_count_q->fetch_assoc()['occ'] : 0);

$total_cages_q = $conn->query("SELECT setting_value FROM clinic_settings WHERE setting_key = 'boarding_cage_count'");
$total_cages = ($total_cages_q && $total_cages_q->num_rows > 0) ? (int)$total_cages_q->fetch_assoc()['setting_value'] : 5;
$occupancy_rate = ($total_cages > 0) ? round(($occ_count / $total_cages) * 100) : 0;

// 7. DOCTOR PERFORMANCE & WORKLOAD (FILTERED BY PERIOD)
$doctors_q = $conn->query("SELECT 
    u.id, 
    u.fullname, 
    u.email, 
    u.contact_number,
    COUNT(a.id) as total_assigned,
    SUM(CASE WHEN a.status = 'Completed' THEN 1 ELSE 0 END) as completed_count,
    SUM(CASE WHEN a.status = 'Approved' THEN 1 ELSE 0 END) as active_count
FROM users u
LEFT JOIN appointments a ON u.id = a.doctor_id AND $filter_sql_appts
WHERE u.role = 'doctor'
GROUP BY u.id, u.fullname, u.email, u.contact_number
ORDER BY total_assigned DESC");

// 8. MASTER TRANSACTIONS QUERY (FILTERED BY PERIOD WITH UNIFIED JOINS)
$all_transactions_sql = "
    SELECT 
        b.id,
        b.invoice_no,
        b.total_amount,
        b.amount_paid,
        b.change_amount,
        b.downpayment_amount,
        b.downpayment_status,
        b.downpayment_paid_at,
        b.payment_status,
        b.payment_method,
        b.reference_no,
        b.is_boarding,
        b.service_category,
        b.items_json,
        b.notes,
        b.created_at,
        b.paid_at,
        COALESCE(NULLIF(TRIM(b.client_name), ''), u.fullname, a.fullname, 'Walk-in Client') AS display_client_name,
        COALESCE(NULLIF(TRIM(b.client_phone), ''), u.contact_number, '') AS display_client_phone,
        COALESCE(NULLIF(TRIM(b.pet_name), ''), a.pet_name, br.pet_name, 'General Pet') AS display_pet_name,
        a.service_type AS appt_service_name,
        br.cage_number AS boarding_cage
    FROM billing b
    LEFT JOIN users u ON (b.user_id = u.id OR (b.user_id IS NULL AND b.appointment_id IS NOT NULL AND (SELECT user_id FROM appointments WHERE id=b.appointment_id)=u.id) OR (b.user_id IS NULL AND b.boarding_res_id IS NOT NULL AND (SELECT user_id FROM boarding_reservations WHERE id=b.boarding_res_id)=u.id))
    LEFT JOIN appointments a ON b.appointment_id = a.id
    LEFT JOIN boarding_reservations br ON b.boarding_res_id = br.id
    WHERE $filter_sql_billing
    ORDER BY b.created_at DESC, b.id DESC
";
$all_transactions_res = $conn->query($all_transactions_sql);

// 9. PREVENTIVE VACCINATION COMPLIANCE (NEXT 30 DAYS)
$due_vaccines_q = $conn->query("SELECT p.name as pet_name, p.species, u.fullname as owner_name, u.contact_number, p.next_vaccination
FROM pets p
JOIN users u ON p.user_id = u.id
WHERE p.next_vaccination IS NOT NULL AND p.next_vaccination <= DATE_ADD(CURDATE(), INTERVAL 30 DAY)
ORDER BY p.next_vaccination ASC LIMIT 8");
?>
