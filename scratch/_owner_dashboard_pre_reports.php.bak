                            <th class="text-end">Collected</th>
                            <th class="text-end">Balance Due</th>
                            <th class="text-center">Status</th>
                            <th class="text-center no-print">Slip</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php if ($all_transactions_res && $all_transactions_res->num_rows > 0): ?>
                            <?php while ($t = $all_transactions_res->fetch_assoc()): 
                                $total_amt = (float)$t['total_amount'];
                                $amt_paid  = (float)$t['amount_paid'];
                                $dp_amt    = (float)$t['downpayment_amount'];
                                $p_status  = $t['payment_status'];
                                $dp_status = $t['downpayment_status'];

                                // Determine Effective Paid
                                if ($p_status === 'Paid') {
                                    $effective_paid = ($amt_paid > 0) ? $amt_paid : $total_amt;
                                    $filter_status = 'paid';
                                } elseif ($dp_status === 'Paid') {
                                    $effective_paid = ($amt_paid > 0) ? $amt_paid : $dp_amt;
                                    $filter_status = 'partial';
                                } else {
                                    $effective_paid = ($amt_paid > 0) ? $amt_paid : 0;
                                    $filter_status = 'unpaid';
                                }

                                $balance_due = max(0, $total_amt - $effective_paid);
                                $inv_code = !empty($t['invoice_no']) ? $t['invoice_no'] : ('INV-' . str_pad($t['id'], 5, '0', STR_PAD_LEFT));

                                $category_type = ($t['is_boarding'] == 1) ? 'boarding' : 'clinic';

                                $slip_data = json_encode([
                                    'invoice_no'     => $inv_code,
                                    'date'           => date('M d, Y h:i A', strtotime($t['created_at'])),
                                    'client_name'    => $t['display_client_name'],
                                    'client_phone'   => $t['display_client_phone'],
                                    'pet_name'       => $t['display_pet_name'],
                                    'category'       => ($t['is_boarding'] == 1 ? 'Boarding Stay' : ($t['service_category'] ?? 'Clinical Care')),
                                    'total_amount'   => number_format($total_amt, 2),
                                    'amount_paid'    => number_format($effective_paid, 2),
                                    'balance_due'    => number_format($balance_due, 2),
                                    'payment_status' => ($p_status === 'Paid' ? 'PAID' : ($dp_status === 'Paid' ? 'PARTIAL DEPOSIT' : 'UNPAID')),
                                    'payment_method' => $t['payment_method'] ?? 'Cash',
                                    'reference_no'   => $t['reference_no'] ?? '',
                                    'items_json'     => $t['items_json'] ?? ''
                                ], JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP);
                            ?>
                                <tr data-filter-status="<?= $filter_status ?>" data-filter-category="<?= $category_type ?>">
                                    <td>
                                        <span class="badge bg-light text-dark font-monospace border px-2 py-1">
                                            <?= htmlspecialchars($inv_code) ?>
                                        </span>
                                    </td>
                                    <td class="text-nowrap small text-muted">
                                        <?= date('M d, Y', strtotime($t['created_at'])) ?>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark text-nowrap"><?= htmlspecialchars($t['display_client_name']) ?></div>
                                        <?php if (!empty($t['display_client_phone'])): ?>
                                            <div class="small text-muted"><i class="fa fa-phone me-1 opacity-50"></i><?= htmlspecialchars($t['display_client_phone']) ?></div>
                                        <?php endif; ?>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1.5 text-nowrap">
                                            <i class="fa fa-paw text-primary"></i>
                                            <span class="fw-semibold text-dark"><?= htmlspecialchars($t['display_pet_name']) ?></span>
                                        </div>
                                    </td>
                                    <td>
                                        <?php if ($t['is_boarding'] == 1): ?>
                                            <span class="badge-pill-soft" style="background: rgba(245, 158, 11, 0.1); color: #d97706; border: 1px solid rgba(245, 158, 11, 0.25);">
                                                <i class="fa fa-hotel"></i> Boarding
                                            </span>
                                        <?php elseif ($t['service_category'] === 'POS'): ?>
                                            <span class="badge-pill-soft" style="background: rgba(16, 185, 129, 0.1); color: #059669; border: 1px solid rgba(16, 185, 129, 0.25);">
                                                <i class="fa fa-pills"></i> Pharmacy
                                            </span>
                                        <?php else: ?>
                                            <span class="badge-pill-soft" style="background: rgba(37, 99, 235, 0.1); color: #2563eb; border: 1px solid rgba(37, 99, 235, 0.25);">
                                                <i class="fa fa-stethoscope"></i> Clinic
                                            </span>
                                        <?php endif; ?>
                                    </td>
                                    <td class="text-end fw-bold text-dark text-nowrap">
                                        ₱<?= number_format($total_amt, 2) ?>
                                    </td>
                                    <td class="text-end fw-bold text-success text-nowrap">
                                        ₱<?= number_format($effective_paid, 2) ?>
                                    </td>
