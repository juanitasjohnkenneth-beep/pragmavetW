    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // SIDEBAR TOGGLING (MOBILE RESPONSIVE)
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            sidebar.classList.toggle('show');
            backdrop.classList.toggle('show');
        }

        function closeSidebarMobile() {
            if (window.innerWidth < 992) {
                document.getElementById('sidebar').classList.remove('show');
                document.getElementById('sidebarBackdrop').classList.remove('show');
            }
        }

        // DATATABLES INITIALIZATION
        let dTable;
        $(document).ready(function() {
            dTable = $('#transactionsTable').DataTable({
                pageLength: 15,
                lengthMenu: [10, 15, 25, 50, 100],
                order: [[1, 'desc']], // Order by Date descending
                responsive: true,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search invoice, client, pet, date..."
                }
            });

            // Dark mode mobile toggle sync
            $('#themeToggleMobile').on('click', function() {
                $('#themeToggle').click();
            });
        });

        // FILTER TRANSACTIONS VIA PILLS
        function filterTransactions(type, btn) {
            $('.filter-pill').removeClass('active');
            $(btn).addClass('active');

            if (type === 'all') {
                $.fn.dataTable.ext.search = [];
            } else if (type === 'paid' || type === 'partial' || type === 'unpaid') {
                $.fn.dataTable.ext.search = [
                    function(settings, data, dataIndex) {
                        const row = dTable.row(dataIndex).node();
                        return $(row).attr('data-filter-status') === type;
                    }
                ];
            } else if (type === 'boarding' || type === 'clinic') {
                $.fn.dataTable.ext.search = [
                    function(settings, data, dataIndex) {
                        const row = dTable.row(dataIndex).node();
                        return $(row).attr('data-filter-category') === type;
                    }
                ];
            }
            dTable.draw();
        }

        // OPEN SLIP DETAIL MODAL
        function openSlipModal(data) {
            $('#modalInvNo').text(data.invoice_no);
            $('#modalDate').text(data.date);
            $('#modalClient').text(data.client_name);
            $('#modalPhone').text(data.client_phone || 'None provided');
            $('#modalPet').text(data.pet_name);
            $('#modalCategory').text(data.category);
            $('#modalTotal').text('₱' + data.total_amount);
            $('#modalPaid').text('₱' + data.amount_paid);
            $('#modalBalance').text('₱' + data.balance_due);
            $('#modalMethod').text(data.payment_method);

            if (data.reference_no && data.reference_no.trim() !== '') {
                $('#modalRef').text(data.reference_no);
                $('#modalRefRow').show();
            } else {
                $('#modalRefRow').hide();
            }

            // Items breakdown
            const itemsBox = $('#modalItemsContainer');
            itemsBox.empty();

            let hasItems = false;
            if (data.items_json && data.items_json.trim() !== '') {
                try {
                    const items = JSON.parse(data.items_json);
                    if (Array.isArray(items) && items.length > 0) {
                        hasItems = true;
                        items.forEach(function(it) {
                            itemsBox.append(`
                                <div class="d-flex justify-content-between small mb-1">
                                    <span>${it.name || it.item_name || 'Item'} x ${it.qty || 1}</span>
                                    <span>₱${Number(it.total || it.price || 0).toLocaleString(undefined, {minimumFractionDigits: 2})}</span>
                                </div>
                            `);
                        });
                    }
                } catch(e) {}
            }

            if (!hasItems) {
                itemsBox.append(`
                    <div class="d-flex justify-content-between small mb-1">
                        <span>${data.category} Services & Fees</span>
                        <span>₱${data.total_amount}</span>
                    </div>
                `);
            }

            const modal = new bootstrap.Modal(document.getElementById('slipModal'));
            modal.show();
        }

        // PRINT INDIVIDUAL SLIP
        function printSlipBox() {
            const printContent = document.getElementById('slipBoxContent').innerHTML;
            const printWindow = window.open('', '', 'height=600,width=450');
            printWindow.document.write('<html><head><title>Print Receipt</title>');
            printWindow.document.write('<style>body { font-family: "Courier New", Courier, monospace; padding: 20px; font-size: 13px; } .slip-line { border-top: 1px dashed #000; margin: 10px 0; } .d-flex { display: flex; justify-content: space-between; } .text-center { text-align: center; } .fw-bold { font-weight: bold; }</style>');
            printWindow.document.write('</head><body>');
            printWindow.document.write(printContent);
            printWindow.document.write('</body></html>');
            printWindow.document.close();
            printWindow.focus();
            setTimeout(function() {
                printWindow.print();
                printWindow.close();
            }, 300);
        }

        // 1. Monthly Revenue Trend Chart (Chart.js)
        const ctxRev = document.getElementById('revenueTrendChart').getContext('2d');
        const revChart = new Chart(ctxRev, {
            type: 'line',
            data: {
                labels: <?= json_encode(!empty($chart_m_labels) ? $chart_m_labels : ['Mar 2026', 'Apr 2026', 'Jul 2026', 'Sep 2026']) ?>,
                datasets: [
                    {
                        label: 'Gross Invoiced (₱)',
                        data: <?= json_encode(!empty($chart_total_rev) ? $chart_total_rev : [3200, 1418400, 4800, 8650]) ?>,
                        borderColor: '#2563eb',
                        backgroundColor: 'rgba(37, 99, 235, 0.08)',
                        fill: true,
                        tension: 0.35,
                        borderWidth: 2.5,
                        pointRadius: 4,
                        pointBackgroundColor: '#2563eb'
                    },
                    {
                        label: 'Cash Collected (₱)',
                        data: <?= json_encode(!empty($chart_collected_rev) ? $chart_collected_rev : [3199, 10960, 1440, 6350]) ?>,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.08)',
                        fill: true,
                        tension: 0.35,
                        borderWidth: 2.5,
                        pointRadius: 4,
                        pointBackgroundColor: '#10b981'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { boxWidth: 12, font: { family: 'Inter', weight: 600 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': ₱' + Number(context.parsed.y).toLocaleString(undefined, {minimumFractionDigits: 2});
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) { return '₱' + Number(value).toLocaleString(); }
                        },
                        grid: { color: 'rgba(0, 0, 0, 0.05)' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // 2. Revenue Stream Share Donut
        const ctxStream = document.getElementById('revenueStreamChart').getContext('2d');
        const streamChart = new Chart(ctxStream, {
            type: 'doughnut',
            data: {
                labels: ['Clinical Care', 'Pet Boarding', 'Pharmacy / POS'],
                datasets: [{
                    data: [<?= $clinic_rev ?>, <?= $boarding_rev ?>, <?= $pos_rev ?>],
                    backgroundColor: ['#2563eb', '#f59e0b', '#10b981'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const val = context.parsed;
                                const pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                                return context.label + ': ₱' + Number(val).toLocaleString() + ' (' + pct + '%)';
                            }
                        }
                    }
                },
                cutout: '72%'
            }
        });

        // 3. Appointment Status Distribution Bar Chart
        const ctxAppt = document.getElementById('apptStatusChart').getContext('2d');
        const apptChart = new Chart(ctxAppt, {
            type: 'bar',
            data: {
                labels: ['Completed', 'Approved', 'Pending', 'Cancelled / No-Show'],
                datasets: [{
                    label: 'Appointments',
                    data: [<?= $completed_appts ?>, <?= $approved_appts ?>, <?= $pending_appts ?>, <?= ($cancelled_appts + $noshow_appts) ?>],
                    backgroundColor: ['#10b981', '#2563eb', '#f59e0b', '#ef4444'],
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 },
                        grid: { color: 'rgba(0, 0, 0, 0.05)' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });
    </script>
</body>
</html>
