<?php
session_start();
include("dbconnection.php");

// Auth guard - Admin and Owner (Reports & Analytics)
$user_role = $_SESSION['role'] ?? '';
$is_admin = ($user_role === 'admin');
$is_owner = ($user_role === 'clinic_owner' || $user_role === 'owner');

if (!isset($_SESSION['user_id']) || (!$is_admin && !$is_owner)) {
    if ($user_role === 'doctor') {
        header("Location: doctor.php");
    } elseif ($user_role === 'staff') {
        header("Location: staff_dashboard.php");
    } else {
        header("Location: index.php");
    }
    exit();
}

// 1. EXPORT TO CSV
if (isset($_POST['export_csv'])) {
    if (ob_get_length()) ob_end_clean();
    header('Content-Type: text/csv; charset=utf-8');
    header('Content-Disposition: attachment; filename="pragmavet_revenue_report_' . date('Y-m-d') . '.csv"');
    $output = fopen('php://output', 'w');
    fputcsv($output, array('Invoice #', 'Client Name', 'Pet Name', 'Service Category', 'Total Amount (PHP)', 'Payment Status', 'Payment Method', 'Date Created'));

    $q = $conn->query("
        SELECT 
            b.id,
            b.invoice_no,
            COALESCE(NULLIF(TRIM(b.client_name), ''), u.fullname, 'Walk-in Client') AS client_name,
            COALESCE(NULLIF(TRIM(b.pet_name), ''), a.pet_name, br.pet_name, 'General Pet') AS pet_name,
            CASE WHEN b.is_boarding = 1 THEN 'Boarding' ELSE 'Clinic' END as category,
            b.total_amount,
            b.payment_status,
            b.payment_method,
            b.created_at
        FROM billing b
        LEFT JOIN users u ON b.user_id = u.id
        LEFT JOIN appointments a ON b.appointment_id = a.id
        LEFT JOIN boarding_reservations br ON b.boarding_res_id = br.id
        ORDER BY b.created_at DESC
    ");
    while ($row = $q->fetch_assoc()) {
        $inv_code = !empty($row['invoice_no']) ? $row['invoice_no'] : ('INV-' . str_pad($row['id'], 5, '0', STR_PAD_LEFT));
        fputcsv($output, array(
            $inv_code,
            $row['client_name'],
            $row['pet_name'],
            $row['category'],
            number_format($row['total_amount'], 2),
            $row['payment_status'],
            $row['payment_method'],
            $row['created_at']
        ));
    }
    fclose($output);
    exit();
}

// 2. SEND MANUAL NOTIFICATION / RECALL ALERT
if (isset($_POST['send_alert'])) {
    $client_id = (int)$_POST['client_id'];
    $type = trim($_POST['type'] ?? 'General Notice');
    $message = trim($_POST['message'] ?? '');
    
    if ($client_id > 0 && !empty($message)) {
        // Notifications Log
        $stmt = $conn->prepare("INSERT INTO notifications_log(user_id, message, type, status) VALUES(?,?,?,'Sent')");
        $stmt->bind_param("iss", $client_id, $message, $type);
        $stmt->execute();

        // Client Notifications
        $stmt2 = $conn->prepare("INSERT INTO notifications(user_id, message) VALUES(?,?)");
        $stmt2->bind_param("is", $client_id, $message);
        $stmt2->execute();

        $_SESSION['message'] = "$type Alert sent successfully to client.";
        $_SESSION['msg_type'] = "success";
    } else {
        $_SESSION['message'] = "Please select a client and provide alert text.";
        $_SESSION['msg_type'] = "danger";
    }
    header("Location: admin.php");
    exit();
}

// 3. ANALYTICS & BILLING AGGREGATES ACROSS ALL TRANSACTIONS
$billing_stats = $conn->query("
    SELECT 
        IFNULL(SUM(total_amount), 0) as total_billed,
        IFNULL(SUM(CASE 
            WHEN payment_status='Paid' THEN (CASE WHEN amount_paid > 0 THEN amount_paid ELSE total_amount END)
            WHEN downpayment_status='Paid' THEN (CASE WHEN amount_paid > 0 THEN amount_paid ELSE downpayment_amount END)
            ELSE 0 
        END), 0) as total_collected,
        IFNULL(SUM(CASE 
            WHEN payment_status='Paid' THEN 0
            WHEN downpayment_status='Paid' THEN GREATEST(0, total_amount - (CASE WHEN amount_paid > 0 THEN amount_paid ELSE downpayment_amount END))
            ELSE total_amount 
        END), 0) as outstanding_balance,
        COUNT(*) as total_invoices
    FROM billing
")->fetch_assoc();

$total_billed = (float)$billing_stats['total_billed'];
$total_collected = (float)$billing_stats['total_collected'];
$outstanding_balance = (float)$billing_stats['outstanding_balance'];
$total_invoices_cnt = (int)$billing_stats['total_invoices'];

// Avg Rating
$avg_rating_res = $conn->query("SELECT IFNULL(AVG(rating), 0) as a, COUNT(*) as c FROM feedbacks")->fetch_assoc();
$avg_rating = (float)$avg_rating_res['a'];
$feedback_count = (int)$avg_rating_res['c'];

// Mini stats
$today_count     = (int)($conn->query("SELECT COUNT(*) as c FROM appointments WHERE appointment_date='" . date('Y-m-d') . "' AND status IN ('Approved','Checked In','In Progress')")->fetch_assoc()['c'] ?? 0);
$checkin_count   = (int)($conn->query("SELECT COUNT(*) as c FROM appointments WHERE status IN ('Checked In','In Progress')")->fetch_assoc()['c'] ?? 0);
$completed_count = (int)($conn->query("SELECT COUNT(*) as c FROM appointments WHERE status='Completed'")->fetch_assoc()['c'] ?? 0);
$noshow_count    = (int)($conn->query("SELECT COUNT(*) as c FROM appointments WHERE status='No Show'")->fetch_assoc()['c'] ?? 0);

// Prescriptive Alerts
$pending_appts_cnt    = (int)($conn->query("SELECT COUNT(*) as c FROM appointments WHERE status IN ('Reschedule Requested', 'Reschedule Proposed')")->fetch_assoc()['c'] ?? 0);
$due_vaccines_cnt     = (int)($conn->query("SELECT COUNT(*) as c FROM pets WHERE next_vaccination IS NOT NULL AND next_vaccination <= DATE_ADD(CURDATE(), INTERVAL 7 DAY)")->fetch_assoc()['c'] ?? 0);
$pending_boarding_cnt = (int)($conn->query("SELECT COUNT(*) as c FROM boarding_reservations WHERE status IN ('Pending', 'Reschedule Proposed')")->fetch_assoc()['c'] ?? 0);

// Boarding occupancy
$occ_count = (int)($conn->query("SELECT COUNT(DISTINCT cage_number) as occ FROM boarding_reservations WHERE status='Approved' AND appointment_date <= CURDATE() AND end_date >= CURDATE()")->fetch_assoc()['occ'] ?? 0);
$total_cages_q = $conn->query("SELECT setting_value FROM clinic_settings WHERE setting_key = 'boarding_cage_count'");
$total_cages = ($total_cages_q && $total_cages_q->num_rows > 0) ? (int)$total_cages_q->fetch_assoc()['setting_value'] : 5;

// Recent feedback & users
$recent_feedback = $conn->query("SELECT f.*, u.fullname as client_name FROM feedbacks f JOIN users u ON f.user_id = u.id ORDER BY f.created_at DESC LIMIT 6");
$client_users_q = $conn->query("SELECT id, fullname, email, contact_number FROM users WHERE role IN ('user','client') ORDER BY fullname ASC");

// Rating distribution (1 to 5)
$rating_dist = [];
for ($i = 1; $i <= 5; $i++) {
    $r = $conn->query("SELECT COUNT(*) as cnt FROM feedbacks WHERE rating = $i")->fetch_assoc();
    $rating_dist[$i] = (int)$r['cnt'];
}
$max_rating_count = max(array_values($rating_dist)) ?: 1;
$total_responses  = array_sum($rating_dist);
$computed_avg     = $total_responses > 0
    ? array_sum(array_map(fn($r, $c) => $r * $c, array_keys($rating_dist), $rating_dist)) / $total_responses
    : 0;

// Monthly comparisons (Current year vs Previous year)
$current_year = date('Y');
$prev_year = $current_year - 1;
$monthly_current = array_fill(1, 12, 0);
$monthly_prev = array_fill(1, 12, 0);

$rev_q = $conn->query("
    SELECT YEAR(b.created_at) as y, MONTH(b.created_at) as m, 
           SUM(b.total_amount) as amt 
    FROM billing b
    GROUP BY YEAR(b.created_at), MONTH(b.created_at)
");
if($rev_q) {
    while($r = $rev_q->fetch_assoc()){
        if($r['y'] == $current_year) $monthly_current[(int)$r['m']] = (float)$r['amt'];
        if($r['y'] == $prev_year) $monthly_prev[(int)$r['m']] = (float)$r['amt'];
    }
}

// Weekly comparisons (Last 5 weeks)
$weekly_labels = [];
$weekly_current = [];
$weekly_prev = [];
for($i=4; $i>=0; $i--) {
    $start_date = date('Y-m-d', strtotime("-$i weeks sunday"));
    $end_date = date('Y-m-d', strtotime($start_date . " +6 days"));
    $weekly_labels[] = "Wk of " . date('M d', strtotime($start_date));
    
    $cw_q = $conn->query("SELECT SUM(b.total_amount) as amt FROM billing b WHERE DATE(b.created_at) BETWEEN '$start_date' AND '$end_date'")->fetch_assoc();
    $weekly_current[] = (float)($cw_q['amt'] ?? 0);
    
    $p_start = date('Y-m-d', strtotime($start_date . " -1 year"));
    $p_end = date('Y-m-d', strtotime($end_date . " -1 year"));
    $pw_q = $conn->query("SELECT SUM(b.total_amount) as amt FROM billing b WHERE DATE(b.created_at) BETWEEN '$p_start' AND '$p_end'")->fetch_assoc();
    $weekly_prev[] = (float)($pw_q['amt'] ?? 0);
}

// Appointment breakdown
$services_q = $conn->query("SELECT IFNULL(service_type, 'General Checkup') as type, COUNT(*) as cnt FROM appointments GROUP BY IFNULL(service_type, 'General Checkup')");
$appt_labels = [];
$appt_data = [];
$has_data = false;
if($services_q) {
    while($row = $services_q->fetch_assoc()){
        $appt_labels[] = $row['type'];
        $appt_data[] = (int)$row['cnt'];
        $has_data = true;
    }
}
$boarding_cnt = $conn->query("SELECT COUNT(*) as c FROM boarding_reservations")->fetch_assoc()['c'];
if($boarding_cnt > 0) {
    $appt_labels[] = 'Pet Boarding';
    $appt_data[] = (int)$boarding_cnt;
    $has_data = true;
}
if(!$has_data) {
    $appt_labels = ['No Data Yet'];
    $appt_data = [1];
}

// 30-day appointment trend
$trend_data = array_fill(0, 30, 0);
$trend_labels = [];
for ($i = 29; $i >= 0; $i--) {
    $trend_labels[] = date('M j', strtotime("-$i days"));
}
$tq = $conn->query("SELECT DATE(appointment_date) as d, COUNT(*) as c FROM appointments WHERE appointment_date >= DATE_SUB(CURDATE(), INTERVAL 30 DAY) GROUP BY d");
if ($tq) while ($t = $tq->fetch_assoc()) {
    $idx = 29 - (int)((strtotime(date('Y-m-d')) - strtotime($t['d'])) / 86400);
    if ($idx >= 0 && $idx < 30) $trend_data[$idx] = (int)$t['c'];
}

// Peak hours
$peak_hours = array_fill(0, 24, 0);
$phq = $conn->query("SELECT HOUR(appointment_time) as h, COUNT(*) as c FROM appointments WHERE appointment_date >= DATE_SUB(CURDATE(), INTERVAL 90 DAY) GROUP BY h");
if ($phq) while ($ph = $phq->fetch_assoc()) $peak_hours[(int)$ph['h']] = (int)$ph['c'];
?>
