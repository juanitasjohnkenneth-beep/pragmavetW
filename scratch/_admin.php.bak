                    </div>
                    <div class="modal-footer border-0 pt-0 d-flex justify-content-between">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" name="send_alert" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            <i class="fa fa-paper-plane me-1.5"></i> Send Notice
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Chart JS Implementation -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const monthlyLabels = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        const monthlyCurrent = <?php echo json_encode(array_values($monthly_current)); ?>;
        const monthlyPrevious = <?php echo json_encode(array_values($monthly_prev)); ?>;

        const weeklyLabels = <?php echo json_encode($weekly_labels); ?>;
        const weeklyCurrent = <?php echo json_encode($weekly_current); ?>;
        const weeklyPrevious = <?php echo json_encode($weekly_prev); ?>;

        function generateChartExplanation(data) {
            const sum = data.reduce((a, b) => a + b, 0);
            if (!data || sum === 0) return "No billing data recorded for this timeframe.";
            
            const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
            const maxVal = Math.max(...data);
            const maxMonth = months[data.indexOf(maxVal)];
            
            return `Monthly revenue shows active billing with a peak of ₱${maxVal.toLocaleString(undefined, {minimumFractionDigits: 2})} recorded in ${maxMonth}.`;
        }

        function generateDistributionExplanation(labels, data, context) {
            if (!data || data.length === 0) return "Insufficient data.";
            let total = data.reduce((a, b) => a + b, 0);
            if (total === 0) return "No activity recorded.";
            
            let maxVal = Math.max(...data);
            let topIndex = data.indexOf(maxVal);
            let topLabel = labels[topIndex];
            let topPercent = Math.round((maxVal / total) * 100);

            if (context === 'feedback') {
                return `Client feedback is centered in '${topLabel}' (${topPercent}% of reviews), reflecting client satisfaction.`;
            } else {
                return `'${topLabel}' represents ${topPercent}% of clinical volume.`;
            }
        }

        const apptLabels = <?php echo json_encode($appt_labels); ?>;
        const apptData = <?php echo json_encode($appt_data); ?>;

        const feedbackLabels = ['Poor', 'Fair', 'Good', 'Very Good', 'Excellent'];
        const feedbackData = <?php echo json_encode(array_values($rating_dist)); ?>;

        window.addEventListener('DOMContentLoaded', () => {
            const summaryElem = document.getElementById('performanceSummary');
            if(summaryElem) summaryElem.innerText = generateChartExplanation(monthlyCurrent);

            const apptElem = document.getElementById('appointmentSummary');
            if(apptElem) apptElem.innerText = generateDistributionExplanation(apptLabels, apptData, 'appointments');

            const feedElem = document.getElementById('feedbackSummary');
            if(feedElem) feedElem.innerText = generateDistributionExplanation(feedbackLabels, feedbackData, 'feedback');
        });

        // Revenue Area Chart
        const ctx = document.getElementById('revenueChart').getContext('2d');
        let revenueChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: monthlyLabels,
                datasets: [
                    {
                        label: 'Total Billed (Monthly)',
                        data: monthlyCurrent,
                        borderColor: '#2563eb',
                        backgroundColor: 'rgba(37, 99, 235, 0.1)',
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: '#2563eb',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 4
                    },
                    {
                        label: 'Previous Year',
                        data: monthlyPrevious,
                        borderColor: '#A0AEC0',
                        borderDash: [5, 5],
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: false,
                        pointRadius: 0
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { callback: v => '₱' + Number(v).toLocaleString() }
                    }
                }
            }
        });

        // Toggle Month / Week
        document.getElementById('timeFilter').addEventListener('change', function() {
            if (this.value === 'week') {
                revenueChart.data.labels = weeklyLabels;
                revenueChart.data.datasets[0].data = weeklyCurrent;
                revenueChart.data.datasets[0].label = 'Total Billed (Weekly)';
                revenueChart.data.datasets[1].data = weeklyPrevious;
            } else {
                revenueChart.data.labels = monthlyLabels;
                revenueChart.data.datasets[0].data = monthlyCurrent;
                revenueChart.data.datasets[0].label = 'Total Billed (Monthly)';
                revenueChart.data.datasets[1].data = monthlyPrevious;
            }
            revenueChart.update();
        });

        // Appointment Doughnut
        new Chart(document.getElementById('typeChart'), {
            type: 'doughnut',
            data: {
                labels: apptLabels,
                datasets: [{
                    data: apptData,
                    backgroundColor: ['#2563eb','#7c3aed','#0891b2','#ea580c','#15803d','#be123c','#d97706','#4f46e5'],
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%'
            }
        });

        // 30-Day Trend
        const TREND_LABELS = <?=json_encode($trend_labels)?>;
        const TREND_DATA   = <?=json_encode(array_values($trend_data))?>;
        new Chart(document.getElementById('trendChart'), {
            type: 'line',
            data: {
                labels: TREND_LABELS,
                datasets:[{
                    label:'Appointments',
                    data: TREND_DATA,
                    borderColor:'#2563eb',
                    backgroundColor:'rgba(37,99,235,.08)',
                    fill:true,
                    tension:.4,
                    pointRadius:2,
                    borderWidth:2
                }]
            },
            options:{
                responsive:true,
                scales:{
                    x:{ticks:{font:{size:9},maxTicksLimit:8},grid:{display:false}},
                    y:{ticks:{font:{size:10},stepSize:1,precision:0},grid:{color:'rgba(0,0,0,.04)'}}
                }
            }
        });

        // Peak Hours Bar
        const PEAK_DATA = <?=json_encode(array_values($peak_hours))?>;
        const peakLabels = [], peakVals = [];
        for (let h=7; h<=19; h++) {
            peakLabels.push(h<12?h+'am':(h===12?'12pm':(h-12)+'pm'));
            peakVals.push(PEAK_DATA[h]||0);
        }
        new Chart(document.getElementById('peakChart'), {
            type: 'bar',
            data:{
                labels: peakLabels,
                datasets:[{
                    label:'Visits',
                    data: peakVals,
                    backgroundColor: peakVals.map(v => v===Math.max(...peakVals)?'#ea580c':'rgba(234,88,12,.25)'),
                    borderRadius:6
                }]
            },
            options:{
                responsive:true,
                plugins:{legend:{display:false}},
                scales:{
                    x:{ticks:{font:{size:9}},grid:{display:false}},
                    y:{ticks:{font:{size:10},stepSize:1,precision:0},grid:{color:'rgba(0,0,0,.04)'}}
                }
            }
        });
    </script>
</body>

</html>