<?php
session_start();
include("dbconnection.php");

$user_role = $_SESSION['role'] ?? ($_SESSION['user_role'] ?? '');
if(!isset($_SESSION['user_id']) || !in_array($user_role, ['admin', 'clinic_owner', 'owner'])){
    header("Location: index.php");
    exit();
}

$active_nav = 'settings';
$msg = "";
$msg_type = "";

// Ensure system_settings table exists
$conn->query("
CREATE TABLE IF NOT EXISTS system_settings (
    id INT AUTO_INCREMENT PRIMARY KEY,
    clinic_name VARCHAR(255) DEFAULT 'PragmaVet Hub',
    clinic_address VARCHAR(255) DEFAULT '123 Clinic Avenue, Wellness District, NY 10001',
    clinic_phone VARCHAR(50) DEFAULT '(555) 123-4567',
    smtp_user VARCHAR(100) DEFAULT 'timferrer1@gmail.com',
    smtp_pass VARCHAR(255) DEFAULT 'azrpmoxxzvhucetu',
    stripe_pub_key VARCHAR(255) DEFAULT 'pk_test_placeholder',
    stripe_sec_key VARCHAR(255) DEFAULT 'sk_test_placeholder',
    dark_mode_default BOOLEAN DEFAULT 0,
    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
)");

// Ensure row 1 exists
$check = $conn->query("SELECT id FROM system_settings WHERE id=1");
if(!$check || $check->num_rows == 0) {
    $conn->query("INSERT INTO system_settings (id, clinic_name, clinic_address, clinic_phone, smtp_user, smtp_pass, stripe_pub_key, stripe_sec_key) 
                  VALUES (1, 'PragmaVet Hub', '123 Clinic Avenue, Wellness District, NY 10001', '(555) 123-4567', 'timferrer1@gmail.com', 'azrpmoxxzvhucetu', 'pk_test_placeholder', 'sk_test_placeholder')");
}

if(isset($_POST['update_settings'])) {
    $c_name = $_POST['clinic_name'] ?? 'PragmaVet Hub';
    $c_addr = $_POST['clinic_address'] ?? '';
    $c_phone = $_POST['clinic_phone'] ?? '';
    
    $s_user = $_POST['smtp_user'] ?? '';
    $s_pass = $_POST['smtp_pass'] ?? '';
    
    $stripe_pub = trim($_POST['stripe_pub_key'] ?? '');
    $stripe_sec = trim($_POST['stripe_sec_key'] ?? '');
    
    $stmt = $conn->prepare("UPDATE system_settings SET clinic_name=?, clinic_address=?, clinic_phone=?, smtp_user=?, smtp_pass=?, stripe_pub_key=?, stripe_sec_key=? WHERE id=1");
    if ($stmt) {
        $stmt->bind_param("sssssss", $c_name, $c_addr, $c_phone, $s_user, $s_pass, $stripe_pub, $stripe_sec);
        if($stmt->execute()) {
            $msg = "System configurations securely synchronized!";
            $msg_type = "success";
        } else {
            $msg = "Warning: Failed to synchronize configurations: " . $stmt->error;
            $msg_type = "danger";
        }
        $stmt->close();
    } else {
        $msg = "Database Error: " . $conn->error;
        $msg_type = "danger";
    }
}

// Fetch current
$settings_res = $conn->query("SELECT * FROM system_settings WHERE id=1");
$settings = ($settings_res && $settings_res->num_rows > 0) ? $settings_res->fetch_assoc() : [
    'clinic_name' => 'PragmaVet Hub',
    'clinic_address' => '123 Clinic Avenue, Wellness District, NY 10001',
    'clinic_phone' => '(555) 123-4567',
    'smtp_user' => 'timferrer1@gmail.com',
    'smtp_pass' => 'azrpmoxxzvhucetu',
    'stripe_pub_key' => '',
    'stripe_sec_key' => ''
];
?>
