<?php
session_start();
include("dbconnection.php");
include_once("includes/rbac_guard.php");

if(!isset($_SESSION['user_id'])) {
    header("Location: index.php");
    exit();
}

// RBAC: Restrict strictly to doctor role
$user_role = rbac_get_role();
if($user_role !== 'doctor') {
    header("Location: " . rbac_home_url($user_role));
    exit();
}

$doctor_id = $_SESSION['user_id'];

// Send message logic
if (isset($_POST['send_message'])) {
    $receiver_id = (int)$_POST['receiver_id'];
    $message = trim($_POST['message']);

    if (!empty($message) && $receiver_id > 0) {
        $stmt = $conn->prepare("INSERT INTO chat_messages (sender_id, receiver_id, message) VALUES (?, ?, ?)");
        $stmt->bind_param("iis", $doctor_id, $receiver_id, $message);
        $stmt->execute();
    }
    header("Location: doctor_messages.php?chat_user=" . $receiver_id);
    exit();
}

// Fetch all Client Users
$clients_res = $conn->query("SELECT id, fullname, username, email, contact_number FROM users WHERE role='client' ORDER BY fullname ASC");
$clients = [];
if($clients_res) { while($c = $clients_res->fetch_assoc()) { $clients[] = $c; } }

// Selected conversation
$active_client_id = isset($_GET['chat_user']) ? (int)$_GET['chat_user'] : ($clients[0]['id'] ?? 0);

// Fetch messages for active conversation
$messages = [];
if ($active_client_id > 0) {
    $msg_stmt = $conn->prepare("
        SELECT m.*, u_sender.fullname as sender_name 
        FROM chat_messages m
        JOIN users u_sender ON m.sender_id = u_sender.id
        WHERE (m.sender_id = ? AND m.receiver_id = ?) 
           OR (m.sender_id = ? AND m.receiver_id = ?)
        ORDER BY m.created_at ASC
    ");
    $msg_stmt->bind_param("iiii", $doctor_id, $active_client_id, $active_client_id, $doctor_id);
    $msg_stmt->execute();
    $res = $msg_stmt->get_result();
    while ($row = $res->fetch_assoc()) {
        $messages[] = $row;
    }
}

// Active client info
$active_client_name = "Select Client";
foreach($clients as $cl) {
    if($cl['id'] == $active_client_id) {
        $active_client_name = $cl['fullname'];
        break;
    }
}
?>
