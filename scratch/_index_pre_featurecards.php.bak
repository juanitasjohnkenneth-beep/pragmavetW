    <!-- Modal Scripts -->
    <script>
    /* ===== AUTH TAB SWITCHING ===== */
    function switchAuthTab(tab) {
        // Update tab buttons
        document.querySelectorAll('.auth-tab-modal').forEach(function(btn) {
            btn.classList.remove('active');
            btn.style.background = 'transparent';
            btn.style.color = 'var(--gray-500)';
            btn.style.boxShadow = 'none';
        });
        var activeBtn = document.getElementById(tab === 'login' ? 'tabLoginBtn' : 'tabRegisterBtn');
        activeBtn.classList.add('active');
        activeBtn.style.background = 'white';
        activeBtn.style.color = 'var(--primary)';
        activeBtn.style.boxShadow = 'var(--shadow-sm)';

        // Update panels
        document.getElementById('panelLogin').style.display = tab === 'login' ? 'block' : 'none';
        document.getElementById('panelRegister').style.display = tab === 'register' ? 'block' : 'none';

        // Update header
        document.getElementById('authModalTitle').textContent = tab === 'login' ? 'LOGIN' : 'CREATE ACCOUNT';
        document.getElementById('authModalSub').textContent = tab === 'login' ? 'Manage your pet\'s health securely' : 'Join PragmaVet for professional pet care';
    }

    function toggleRegisterBtnModal() {
        document.getElementById('registerBtnModal').disabled = !document.getElementById('agreeTermsModal').checked;
    }

    function validateRegisterModal() { return false; } // legacy ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â no longer used

    // ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ Registration OTP Flow ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬ÃƒÂ¢Ã¢â‚¬ÂÃ¢â€šÂ¬
    var _regEmail = '';

    function regShowAlert(id, type, msg) {
        var el = document.getElementById(id);
        el.style.display = 'block';
        el.innerHTML = '<div class="alert alert-' + type + ' py-2 px-3 rounded-3 mb-0" style="font-size:13px;">' +
                       '<i class="fa fa-' + (type === 'danger' ? 'circle-xmark' : type === 'success' ? 'check-circle' : 'info-circle') + ' me-1"></i>' + msg + '</div>';
    }
    function regHideAlert(id) { document.getElementById(id).style.display = 'none'; }

    function regSendOtp() {
        var fullname = document.getElementById('regFullname').value.trim();
        var email    = document.getElementById('regEmail').value.trim();
        var address  = document.getElementById('regAddress').value.trim();
        var password = document.getElementById('regPassword').value;

        if (!fullname || !email || !address || !password) {
            regShowAlert('regAlert', 'danger', 'Please fill in all fields.');
            return;
        }
        if (!/^(?=.*[a-z])(?=.*\d)[a-z0-9]{8,}$/.test(password)) {
            regShowAlert('regAlert', 'danger', 'Password must be at least 8 characters, lowercase letters and numbers only.');
            return;
        }

        // Show spinner
        document.getElementById('regBtnText').style.display = 'none';
        document.getElementById('regBtnSpinner').style.display = '';
        document.getElementById('registerBtnModal').disabled = true;
        regHideAlert('regAlert');

        var fd = new FormData();
        fd.append('step', 'send_otp');
        fd.append('fullname', fullname);
        fd.append('email', email);
        fd.append('address', address);
        fd.append('password', password);

        fetch('register_ajax.php', { method: 'POST', body: fd })
            .then(r => r.json())
            .then(data => {
                document.getElementById('regBtnText').style.display = '';
                document.getElementById('regBtnSpinner').style.display = 'none';
                document.getElementById('registerBtnModal').disabled = false;

                if (data.success) {
                    _regEmail = email;
                    document.getElementById('regOtpEmailDisplay').textContent = email;
                    document.getElementById('regStep1').style.display = 'none';
                    document.getElementById('regStep2').style.display = 'block';
                    document.getElementById('regOtpInput').value = '';
                    document.getElementById('regOtpInput').focus();
                } else {
                    regShowAlert('regAlert', 'danger', data.message);
                }
            })
            .catch(() => {
                document.getElementById('regBtnText').style.display = '';
                document.getElementById('regBtnSpinner').style.display = 'none';
                document.getElementById('registerBtnModal').disabled = false;
                regShowAlert('regAlert', 'danger', 'Network error. Please check your connection.');
            });
    }

    function regVerifyOtp() {
        var otp = document.getElementById('regOtpInput').value.trim();
        if (!otp || otp.length !== 6 || !/^\d{6}$/.test(otp)) {
            regShowAlert('regOtpAlert', 'danger', 'Please enter the 6-digit code sent to your email.');
            return;
        }
        document.getElementById('regVerifyText').style.display = 'none';
        document.getElementById('regVerifySpinner').style.display = '';
        document.getElementById('regVerifyBtn').disabled = true;
        regHideAlert('regOtpAlert');

        var fd = new FormData();
        fd.append('step', 'verify_otp');
        fd.append('email', _regEmail);
        fd.append('otp', otp);

        fetch('register_ajax.php', { method: 'POST', body: fd })
            .then(r => r.json())
            .then(data => {
                document.getElementById('regVerifyText').style.display = '';
                document.getElementById('regVerifySpinner').style.display = 'none';
                document.getElementById('regVerifyBtn').disabled = false;

                if (data.success) {
                    regShowAlert('regOtpAlert', 'success', '&#10003; ' + data.message + ' Redirecting to login&hellip;');
                    setTimeout(() => {
                        // Switch to login tab
                        document.getElementById('regStep2').style.display = 'none';
                        document.getElementById('regStep1').style.display = 'block';
                        document.getElementById('regOtpInput').value = '';
                        if (typeof switchToLogin === 'function') switchToLogin();
                        else document.getElementById('tabLogin').click();
                    }, 2000);
                } else {
                    regShowAlert('regOtpAlert', 'danger', data.message);
                }
            })
            .catch(() => {
                document.getElementById('regVerifyText').style.display = '';
                document.getElementById('regVerifySpinner').style.display = 'none';
                document.getElementById('regVerifyBtn').disabled = false;
                regShowAlert('regOtpAlert', 'danger', 'Network error. Please try again.');
            });
    }

    function regResendOtp() {
        regHideAlert('regOtpAlert');
        var fd = new FormData();
        fd.append('step', 'resend_otp');
        fd.append('email', _regEmail);
        fetch('register_ajax.php', { method: 'POST', body: fd })
            .then(r => r.json())
            .then(data => {
                regShowAlert('regOtpAlert', data.success ? 'info' : 'danger', data.message);
            });
    }

    function regGoBack() {
        document.getElementById('regStep2').style.display = 'none';
        document.getElementById('regStep1').style.display = 'block';
        regHideAlert('regOtpAlert');
    }



    function openTermsModal() {
        document.getElementById('termsModal').classList.add('active');
        document.body.style.overflow = 'hidden';
    }
    function closeTermsModal() {
        document.getElementById('termsModal').classList.remove('active');
        document.body.style.overflow = '';
    }
    function openPrivacyModal() {
        document.getElementById('privacyModal').classList.add('active');
        document.body.style.overflow = 'hidden';
    }
    function closePrivacyModal() {
        document.getElementById('privacyModal').classList.remove('active');
        document.body.style.overflow = '';
    }
    document.querySelectorAll('.terms-modal').forEach(function(mod) {
        mod.addEventListener('click', function(e) {
            if (e.target === this) {
                this.classList.remove('active');
                document.body.style.overflow = '';
            }
        });
    });
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            document.querySelectorAll('.terms-modal.active').forEach(function(mod) {
                mod.classList.remove('active');
                document.body.style.overflow = '';
            });
        }
    });
    </script>

    <style>
    /* Terms Modal Styles */
    .terms-modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.6);
        backdrop-filter: blur(8px);
        z-index: 99999;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }
    .terms-modal.active { display: flex; }
    .terms-modal-content {
        background: white;
        border-radius: var(--radius-lg);
        max-width: 680px;
        width: 100%;
        max-height: 80vh;
        overflow-y: auto;
        box-shadow: 0 30px 80px rgba(0,0,0,0.3);
        animation: modalIn 0.3s cubic-bezier(0.25,0.46,0.45,0.94);
    }
    @keyframes modalIn {
        from { opacity: 0; transform: scale(0.95) translateY(20px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }
    .terms-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 28px 32px 20px;
        border-bottom: 1px solid var(--gray-200);
        position: sticky;
        top: 0;
        background: white;
        z-index: 2;
        border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }
    .terms-modal-header h3 { font-weight: 800; color: var(--dark); margin: 0; font-size: 20px; }
    .terms-modal-header .close-btn {
        width: 40px; height: 40px; border-radius: 50%; border: none;
        background: var(--gray-200); color: var(--gray-500);
        display: flex; align-items: center; justify-content: center;
        font-size: 18px; cursor: pointer; transition: var(--transition);
    }
    .terms-modal-header .close-btn:hover { background: #fee2e2; color: #ef4444; transform: rotate(90deg); }
    .terms-modal-body { padding: 28px 32px 32px; }
    .terms-modal-body h4 { font-size: 20px; font-weight: 800; color: var(--primary); margin-bottom: 4px; }
    .terms-modal-body .last-updated { font-size: 13px; color: var(--gray-400); margin-bottom: 24px; }
    .terms-modal-body h5 { font-weight: 700; color: var(--dark); margin-top: 24px; margin-bottom: 8px; font-size: 15px; }
    .terms-modal-body p { font-size: 14px; line-height: 1.7; color: var(--gray-600); margin-bottom: 12px; }
    .terms-modal-accept {
        padding: 20px 32px 28px;
        border-top: 1px solid var(--gray-200);
        text-align: center;
    }
    .terms-modal-accept .btn-gradient { width: auto; min-width: 200px; padding: 14px 36px; }
    @media (max-width: 520px) {
        .terms-modal-content { max-height: 90vh; }
        .terms-modal-header { padding: 20px 24px 16px; }
        .terms-modal-body { padding: 20px 24px 24px; }
        .terms-modal-accept { padding: 16px 24px 20px; }
    }
    </style>

    <!-- ==================== LEGAL POP-UP (footer: Privacy Policy / Terms of Service / Cookie Policy) ==================== -->
    <!-- The text is loaded from privacy-policy.php, terms-of-service.php and cookie-policy.php, so it is written in one place only -->
    <div class="terms-modal" id="legalModal" role="dialog" aria-modal="true" aria-labelledby="legalModalTitle">
        <div class="terms-modal-content">
            <div class="terms-modal-header">
                <h3><i class="fa fa-shield-alt me-2" id="legalModalIcon" style="color:var(--primary-light);"></i> <span id="legalModalTitle">Legal</span></h3>
                <button class="close-btn" type="button" onclick="closeLegalModal()" aria-label="Close"><i class="fa fa-times"></i></button>
            </div>
            <div class="terms-modal-body" id="legalModalBody"></div>
            <div class="terms-modal-accept legal-modal-foot">
                <div class="legal-modal-switch" id="legalModalSwitch"></div>
                <button class="btn-gradient" type="button" onclick="closeLegalModal()"><i class="fa fa-check me-1"></i> Got It</button>
            </div>
        </div>
    </div>
    <style>
    #legalModal .terms-modal-content { max-width: 820px; }
    #legalModal .legal-modal-updated { font-size: 13px; color: var(--gray-400); margin: -6px 0 18px; }
    #legalModal .legal-note { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; border-radius: 12px; padding: 12px 14px; font-size: 13.5px; margin-bottom: 20px; display: flex; gap: 10px; }
    #legalModal .legal-toc { background: var(--gray-100); border: 1px solid var(--gray-300); border-radius: 14px; padding: 14px 18px; margin-bottom: 22px; }
    #legalModal .legal-toc strong { display: block; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--gray-500); margin-bottom: 6px; }
    #legalModal .legal-toc ol { margin: 0; padding-left: 20px; columns: 2; column-gap: 28px; }
    #legalModal .legal-toc li { font-size: 14px; margin-bottom: 3px; break-inside: avoid; }
    #legalModal .legal-toc a { color: var(--primary-light); text-decoration: none; font-weight: 600; }
    #legalModal .legal-toc a:hover { text-decoration: underline; }
    #legalModal h2 { font-weight: 800; color: var(--dark); font-size: 17px; margin: 24px 0 8px; scroll-margin-top: 12px; }
    #legalModal h3 { font-weight: 700; color: var(--dark); font-size: 15px; margin: 16px 0 6px; }
    #legalModal .terms-modal-header h3 { font-size: 20px; margin: 0; }
    #legalModal p, #legalModal li { font-size: 14px; line-height: 1.7; color: var(--gray-600); }
    #legalModal ul { padding-left: 20px; margin-bottom: 12px; }
    #legalModal .terms-modal-body a { color: var(--primary-light); }
    #legalModal .ph { background: #eff6ff; color: #1e40af; border: 1px dashed #93c5fd; border-radius: 6px; padding: 0 5px; font-weight: 600; }
    #legalModal .legal-table-wrap { overflow-x: auto; }
    #legalModal .legal-table { width: 100%; border-collapse: collapse; font-size: 13.5px; margin: 6px 0 4px; }
    #legalModal .legal-table th, #legalModal .legal-table td { border: 1px solid var(--gray-300); padding: 8px 10px; text-align: left; vertical-align: top; overflow-wrap: anywhere; }
    #legalModal .legal-table th { background: var(--gray-100); color: var(--dark); }
    #legalModal .legal-modal-loading { text-align: center; color: var(--gray-400); padding: 40px 0; }
    #legalModal .legal-modal-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    #legalModal .legal-modal-switch { display: flex; gap: 8px; flex-wrap: wrap; }
    #legalModal .legal-modal-switch button { border: 1px solid var(--gray-300); background: #fff; color: var(--gray-600); border-radius: 999px; padding: 7px 14px; font-size: 13px; font-weight: 600; cursor: pointer; }
    #legalModal .legal-modal-switch button:hover { border-color: var(--primary-light); color: var(--primary-light); }
    @media (max-width: 640px) {
        #legalModal .legal-toc ol { columns: 1; }
        #legalModal .legal-modal-foot { justify-content: center; }
        #legalModal .legal-modal-foot .btn-gradient { width: 100%; }
    }
    </style>
    <script>
    (function () {
        var PAGES = {
            privacy: { title: 'Privacy Policy',   icon: 'fa-shield-alt',    url: 'privacy-policy.php' },
            terms:   { title: 'Terms of Service', icon: 'fa-file-contract', url: 'terms-of-service.php' },
            cookies: { title: 'Cookie Policy',    icon: 'fa-cookie-bite',   url: 'cookie-policy.php' }
        };
        var cache = {};
        var modal = document.getElementById('legalModal');
        var body = document.getElementById('legalModalBody');

        // Take the policy text out of its page (without the page's own "Back to homepage" links)
        function load(key) {
            if (cache[key]) return Promise.resolve(cache[key]);
            return fetch(PAGES[key].url, { credentials: 'same-origin' }).then(function (r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.text();
            }).then(function (html) {
                var doc = new DOMParser().parseFromString(html, 'text/html');
                var card = doc.querySelector('.legal-card');
                if (!card) throw new Error('No content');
                card.querySelectorAll('.legal-back, .legal-related, script').forEach(function (n) { n.remove(); });
                var meta = doc.querySelector('.legal-meta');
                var updated = meta ? '<p class="legal-modal-updated"><i class="fa fa-calendar me-1"></i> ' + meta.textContent.replace(/\s+/g, ' ').trim().replace(/ Version/, ' · Version') + '</p>' : '';
                cache[key] = updated + card.innerHTML;
                return cache[key];
            });
        }

        window.openLegalModal = function (key) {
            var p = PAGES[key];
            if (!p) return;
            document.getElementById('legalModalTitle').textContent = p.title;
            document.getElementById('legalModalIcon').className = 'fa ' + p.icon + ' me-2';
            document.getElementById('legalModalSwitch').innerHTML = Object.keys(PAGES).filter(function (k) { return k !== key; })
                .map(function (k) { return '<button type="button" data-legal-open="' + k + '">' + PAGES[k].title + '</button>'; }).join('');
            body.innerHTML = '<div class="legal-modal-loading"><i class="fa fa-spinner fa-spin me-2"></i>Loading…</div>';
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
            load(key).then(function (html) {
                body.innerHTML = html;
                modal.querySelector('.terms-modal-content').scrollTop = 0;
            }).catch(function () {
                window.location.href = p.url; // could not load: open the page instead
            });
        };
        window.closeLegalModal = function () {
            modal.classList.remove('active');
            document.body.style.overflow = '';
        };

        // Footer links: open the pop-up (Ctrl/Cmd/Shift-click or middle-click still opens the page itself)
        document.querySelectorAll('a[data-legal]').forEach(function (a) {
            a.addEventListener('click', function (e) {
                if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
                e.preventDefault();
                openLegalModal(a.getAttribute('data-legal'));
            });
        });

        modal.addEventListener('click', function (e) {
            // "Contents" links scroll inside the pop-up
            var a = e.target.closest('#legalModalBody a[href^="#"]');
            if (a) {
                e.preventDefault();
                var target = body.querySelector(a.getAttribute('href'));
                var box = modal.querySelector('.terms-modal-content');
                if (target) box.scrollTo({ top: target.getBoundingClientRect().top - box.getBoundingClientRect().top + box.scrollTop - 12, behavior: 'smooth' });
                return;
            }
            // Links to the other policies switch the pop-up
            var other = e.target.closest('[data-legal-open], #legalModalBody a[href="privacy-policy.php"], #legalModalBody a[href="terms-of-service.php"], #legalModalBody a[href="cookie-policy.php"]');
            if (other) {
                e.preventDefault();
                var href = other.getAttribute('href');
                var key = other.getAttribute('data-legal-open') || Object.keys(PAGES).filter(function (k) { return PAGES[k].url === href; })[0];
                openLegalModal(key);
            }
        });
    })();
    </script>

    <script>
    // Show / hide toggle on password fields in the login, sign-up and forgot-password windows (display only)
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('#authModal input[type="password"], #forgotModal input[type="password"]').forEach(function (inp) {
            if (inp.parentElement.classList.contains('pv-pass-wrap')) return;
            var wrap = document.createElement('div');
            wrap.className = 'pv-pass-wrap';
            inp.parentNode.insertBefore(wrap, inp);
            wrap.appendChild(inp);
            var eye = document.createElement('button');
            eye.type = 'button';
            eye.className = 'pv-eye';
            eye.setAttribute('aria-label', 'Show password');
            eye.innerHTML = '<i class="fa fa-eye"></i>';
            eye.addEventListener('click', function () {
                var show = inp.type === 'password';
                inp.type = show ? 'text' : 'password';
                eye.innerHTML = show ? '<i class="fa fa-eye-slash"></i>' : '<i class="fa fa-eye"></i>';
                eye.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                inp.focus();
            });
            wrap.appendChild(eye);
        });
    });
    </script>
</body>

</html>
