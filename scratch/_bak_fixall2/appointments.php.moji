    <style>
        :root {
            --primary: #2563eb;
            --secondary: #3b82f6;
            --dark: #1e40af;
            --light-bg: #F0F4F8;
            --sidebar-width: 260px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: var(--light-bg);
            font-family: 'Inter', sans-serif;
            color: #333;
            overflow-x: hidden;
            margin: 0;
        }

        /* â”€â”€ SIDEBAR â”€â”€ */
        .sidebar {
            background: #0f172a;
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            padding: 24px 16px;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            box-shadow: 5px 0 20px rgba(0, 0, 0, .2);
            overflow-y: auto;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 6px;
        }

        .sidebar-brand-icon {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sidebar-brand span {
            font-weight: 800;
            font-size: 20px;
            color: #fff;
        }

        .sidebar-user {
            background: rgba(255, 255, 255, .06);
            border-radius: 12px;
            padding: 12px 14px;
            margin: 16px 0 24px;
        }

        .sidebar-user .welcome {
            font-size: 11px;
            color: rgba(255, 255, 255, .45);
            margin-bottom: 2px;
        }

        .sidebar-user .uname {
            font-weight: 700;
            font-size: 15px;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            border-radius: 8px;
            color: #94a3b8;
            text-decoration: none;
            margin-bottom: 4px;
            font-weight: 600;
            font-size: 15px;
            transition: .2s;
        }

        .sidebar a i {
            width: 20px;
            text-align: center;
            font-size: 15px;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #2563eb;
            color: #ffffff;
        }

        .sidebar-logout {
            margin-top: auto;
        }

        .sidebar-logout a {
            color: #ff7070 !important;
        }

        .sidebar-logout a:hover {
            background: rgba(255, 112, 112, .12) !important;
            box-shadow: none !important;
        }

        /* â”€â”€ MAIN â”€â”€ */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 36px 44px;
            min-height: 100vh;
        }

        .page-title {
            font-weight: 800;
            font-size: 26px;
            color: var(--dark);
            margin: 0;
            letter-spacing: -.5px;
        }

        .page-sub {
            color: #94a3b8;
            font-size: 14px;
            margin: 2px 0 0;
        }

        /* â”€â”€ CARDS â”€â”€ */
        .card-prem {
            background: #fff;
            border: none;
            border-radius: 20px;
            box-shadow: 0 4px 24px rgba(0, 0, 0, .05);
        }

        .card-head {
            padding: 22px 28px 16px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .card-head h5 {
            font-weight: 800;
            font-size: 16px;
            color: var(--dark);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .card-body-p {
            padding: 24px 28px;
        }

        /* â”€â”€ SEARCH â”€â”€ */
        .search-wrap {
            position: relative;
            flex: 1;
            min-width: 180px;
        }

        .search-wrap input {
            width: 100%;
            padding: 9px 14px 9px 38px;
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            background: #E6EEF8;
            font-size: 13px;
            font-family: inherit;
            transition: .2s;
            outline: none;
        }

        .search-wrap input:focus {
            border-color: var(--secondary);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(74, 127, 196, .15);
        }

        .search-wrap .si {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 13px;
            pointer-events: none;
        }

        /* â”€â”€ TABLE â”€â”€ */
        .appt-table {
            width: 100%;
            border-collapse: collapse;
        }

        .appt-table thead th {
            padding: 10px 14px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #94a3b8;
            border-bottom: 1.5px solid #f1f5f9;
            white-space: nowrap;
        }

        .appt-table tbody tr {
            cursor: pointer;
            transition: background .12s;
        }

        .appt-table tbody tr:hover {
            background: #E6EEF8;
        }

        .appt-table tbody td {
            padding: 15px 14px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
            font-size: 14px;
        }

        .appt-table tbody tr:last-child td {
            border-bottom: none;
        }

        /* â”€â”€ PET AVATAR â”€â”€ */
        .pet-avatar {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, #e0f2fe, #bae6fd);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: var(--secondary);
            flex-shrink: 0;
        }

        /* â”€â”€ STATUS BADGES â”€â”€ */
        .badge-s {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            border: 1.5px solid transparent;
        }

        .badge-pending {
            background: #fff7ed;
            color: #ea580c;
            border-color: #fed7aa;
        }

        .badge-approved {
            background: #f0fdf4;
            color: #16a34a;
            border-color: #bbf7d0;
        }

        .badge-completed {
            background: #eff6ff;
            color: #2563eb;
            border-color: #bfdbfe;
        }

        .badge-cancelled {
            background: #fff1f2;
            color: #e11d48;
            border-color: #fecdd3;
        }

        .badge-default {
            background: #E6EEF8;
            color: #64748b;
            border-color: #e2e8f0;
        }

        .badge-proposed {
            background: #f5f3ff;
            color: #7e22ce;
            border-color: #ddd6fe;
        }


        /* â”€â”€ WIZARD FORM STYLES â”€â”€ */
        .wz-container {
            position: relative;
        }

        /* Progress Bar */
        .wz-progress {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 28px;
            position: relative;
            padding: 0 4px;
        }

        .wz-progress-track {
            position: absolute;
            top: 50%;
            left: 40px;
            right: 40px;
            height: 3px;
            background: #e2e8f0;
            border-radius: 4px;
            transform: translateY(-50%);
            z-index: 0;
            overflow: hidden;
        }

        .wz-progress-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            border-radius: 4px;
            transition: width .45s cubic-bezier(.34, 1.56, .64, 1);
        }

        .wz-dot {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #f1f5f9;
            border: 2.5px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 800;
            color: #94a3b8;
            position: relative;
            z-index: 1;
            transition: all .3s;
            cursor: default;
            flex-shrink: 0;
        }

        .wz-dot.wz-dot-active {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .15);
            transform: scale(1.08);
        }

        .wz-dot.wz-dot-done {
            background: #16a34a;
            border-color: #16a34a;
            color: #fff;
        }

        .wz-dot-label {
            position: absolute;
            top: calc(100% + 8px);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #94a3b8;
            white-space: nowrap;
            transition: color .3s;
        }

        .wz-dot.wz-dot-active .wz-dot-label,
        .wz-dot.wz-dot-done .wz-dot-label {
            color: var(--dark);
        }

        /* Steps */
        .wz-step {
            display: none;
            animation: wzFadeIn .35s ease;
        }

        .wz-step.wz-active {
            display: block;
        }

        @keyframes wzFadeIn {
            from { opacity: 0; transform: translateX(18px); }
            to { opacity: 1; transform: none; }
        }

        .wz-step.wz-done .wz-step-inner {
            opacity: .5;
        }

        .wz-step-title {
            font-size: 17px;
            font-weight: 800;
            color: var(--dark);
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .wz-step-sub {
            font-size: 12px;
            color: #94a3b8;
            margin-bottom: 20px;
        }

        .wz-step-icon {
            width: 32px;
            height: 32px;
            border-radius: 9px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            flex-shrink: 0;
        }

        /* Form fields inside wizard */
        .wz-step label.lbl {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #64748b;
            margin-bottom: 6px;
            display: block;
        }

        .wz-step .form-control,
        .wz-step .form-select {
            border-radius: 10px;
            padding: 10px 14px;
            border: 1.5px solid #e2e8f0;
            font-size: 14px;
            background: #fafcff;
            font-family: inherit;
            transition: .2s;
            outline: none;
            width: 100%;
        }

        .wz-step .form-control:focus,
        .wz-step .form-select:focus {
            border-color: var(--secondary);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(74, 127, 196, .12);
        }

        .wz-step .form-control.wz-error,
        .wz-step .form-select.wz-error {
            border-color: #e11d48;
            box-shadow: 0 0 0 3px rgba(225, 29, 72, .12);
        }

        @keyframes wzShake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-6px); }
            40% { transform: translateX(6px); }
            60% { transform: translateX(-4px); }
            80% { transform: translateX(4px); }
        }

        .wz-shake {
            animation: wzShake .45s ease;
        }

        /* Navigation buttons */
        .wz-nav {
            display: flex;
            gap: 10px;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid #f1f5f9;
        }

        .wz-btn {
            flex: 1;
            padding: 12px 20px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 14px;
            font-family: inherit;
            cursor: pointer;
            transition: .25s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
        }

        .wz-btn-primary {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 6px 18px rgba(37, 99, 235, .25);
        }

        .wz-btn-primary:hover {
            background: var(--dark);
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(18, 26, 47, .3);
        }

        .wz-btn-secondary {
            background: #E6EEF8;
            color: #64748b;
            border: 1.5px solid #e2e8f0;
        }

        .wz-btn-secondary:hover {
            background: #d1dce8;
            color: #334155;
        }

        .wz-btn-success {
            background: #16a34a;
            color: #fff;
            box-shadow: 0 6px 18px rgba(22, 163, 74, .25);
        }

        .wz-btn-success:hover {
            background: #15803d;
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(22, 163, 74, .3);
        }

        /* Review card */
        .wz-review-card {
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            border-radius: 14px;
            padding: 20px;
            margin-bottom: 16px;
        }

        .wz-review-row {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 8px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .wz-review-row:last-child {
            border-bottom: none;
        }

        .wz-review-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: #94a3b8;
            min-width: 90px;
            flex-shrink: 0;
            padding-top: 2px;
        }

        .wz-review-value {
            font-size: 14px;
            font-weight: 600;
            color: #0f172a;
        }

        .loc-toggle {
            display: flex;
            gap: 8px;
        }

        .loc-btn {
            flex: 1;
            padding: 10px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            background: #fafcff;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
            color: #64748b;
            text-align: center;
            transition: .2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .loc-btn.active {
            border-color: var(--primary);
            background: var(--primary);
            color: #fff;
        }

        .btn-submit {
            width: 100%;
            padding: 13px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 50px;
            font-weight: 700;
            font-size: 15px;
            font-family: inherit;
            cursor: pointer;
            transition: .25s;
            box-shadow: 0 6px 18px rgba(37, 99, 235, .25);
        }

        .btn-submit:hover {
            background: var(--dark);
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(18, 26, 47, .3);
        }

        /* â”€â”€ ALERT TOAST â”€â”€ */
        .alert-toast {
            position: fixed;
            top: 24px;
            right: 32px;
            z-index: 9999;
            min-width: 320px;
            max-width: 440px;
            border-radius: 14px;
            padding: 16px 20px;
            font-weight: 500;
            font-size: 14px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, .14);
            animation: toastIn .4s ease;
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .alert-toast.success {
            background: #f0fdf4;
            border: 1.5px solid #bbf7d0;
            color: #15803d;
        }

        /* â”€â”€ FEEDBACK MODAL PREMIUM STYLES â”€â”€ */
        .feedback-stars i {
            font-size: 32px;
            color: #e2e8f0;
            cursor: pointer;
            transition: .2s;
        }

        .feedback-stars i.active {
            color: #fbbf24;
            transform: scale(1.1);
        }

        .feedback-modal-content {
            border-radius: 30px;
            border: none;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
        }

        .feedback-header {
            background: #eff6ff;
            border: none;
            padding: 30px 30px 10px;
            position: relative;
        }

        .feedback-body {
            padding: 30px;
            text-align: center;
        }

        .feedback-icon-bg {
            width: 80px;
            height: 80px;
            background: #fff;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        }

        .feedback-btn {
            background: #2563eb;
            color: #fff;
            border: none;
            border-radius: 15px;
            padding: 14px;
            font-weight: 700;
            width: 100%;
            transition: .2s;
            margin-top: 10px;
        }

        .feedback-btn:hover {
            background: #1e40af;
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
        }

        .feedback-textarea {
            border-radius: 15px;
            border: 1.5px solid #e2e8f0;
            background: #f8fafc;
            padding: 15px;
            font-size: 14px;
        }

        .feedback-textarea:focus {
            border-color: #3b82f6;
            box-shadow: none;
            background: #fff;
        }

        .alert-toast.danger {
            background: #fff1f2;
            border: 1.5px solid #fecdd3;
            color: #be123c;
        }

        @keyframes toastIn {
            from {
                opacity: 0;
                transform: translateY(-16px) scale(.96);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        /* â”€â”€ DETAIL MODAL â”€â”€ */
        .dmodal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, .5);
            z-index: 99998;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 16px;
            opacity: 0;
            transition: opacity .18s;
        }

        .dmodal-backdrop.open {
            display: flex;
            opacity: 1;
        }

        .dmodal {
            background: #fff;
            border-radius: 20px;
            width: 100%;
            max-width: 520px;
            max-height: 88vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 24px 64px rgba(0, 0, 0, .2);
            overflow: hidden;
            transform: scale(.95) translateY(12px);
            transition: transform .2s, opacity .2s;
            opacity: 0;
        }

        .dmodal-backdrop.open .dmodal {
            transform: none;
            opacity: 1;
        }

        .dmodal-header {
            padding: 20px 24px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .dmodal-header h5 {
            font-weight: 800;
            font-size: 17px;
            color: var(--dark);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .dmodal-close {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 1.5px solid #e2e8f0;
            background: #E6EEF8;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            color: #64748b;
            transition: .15s;
        }

        .dmodal-close:hover {
            background: #fee2e2;
            border-color: #fca5a5;
            color: #e11d48;
        }

        .dmodal-body {
            overflow-y: auto;
            padding: 24px;
            flex: 1;
        }

        .dmodal-footer {
            padding: 16px 24px;
            border-top: 1px solid #f1f5f9;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }

        .info-item label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #94a3b8;
            display: block;
            margin-bottom: 3px;
        }

        .info-item .val {
            font-size: 14px;
            font-weight: 600;
            color: #0f172a;
        }

        .info-item.full {
            grid-column: 1/-1;
        }

        .service-hero {
            text-align: center;
            background: linear-gradient(135deg, #eff6ff, #e0f2fe);
            border-radius: 14px;
            padding: 18px;
            margin-bottom: 16px;
        }

        .service-hero .sname {
            font-size: 20px;
            font-weight: 800;
            color: var(--primary);
        }

        .service-hero .slim {
            font-size: 13px;
            color: #64748b;
            margin-top: 2px;
        }

        .notice-box {
            border-radius: 12px;
            padding: 14px 16px;
            font-size: 13px;
            margin-bottom: 14px;
        }

        .notice-box.warn {
            background: #fff7ed;
            border: 1.5px solid #fed7aa;
            color: #9a3412;
        }

        .btn-action {
            flex: 1;
            padding: 11px 16px;
            border-radius: 50px;
            border: none;
            font-weight: 700;
            font-size: 13px;
            font-family: inherit;
            cursor: pointer;
            transition: .2s;
        }

        .btn-action.green {
            background: #16a34a;
            color: #fff;
        }

        .btn-action.red {
            background: #fff;
            border: 1.5px solid #fca5a5;
            color: #e11d48;
        }

        .btn-action.gray {
            background: #E6EEF8;
            border: 1.5px solid #e2e8f0;
            color: #64748b;
        }

        .btn-action.danger-solid {
            background: #e11d48;
            color: #fff;
        }

        .btn-action:hover {
            opacity: .88;
            transform: translateY(-1px);
        }

        #homeAddressContainer,
        #endDateContainer {
            display: none;
        }

        .no-appt {
            text-align: center;
            padding: 52px 20px;
            color: #94a3b8;
        }

        .no-appt i {
            font-size: 48px;
            display: block;
            margin-bottom: 14px;
            opacity: .35;
        }

        /* â”€â”€ NO PET MODAL â”€â”€ */
        #noPetBackdrop {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, .6);
            z-index: 99999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
            opacity: 0;
            transition: opacity .25s;
        }

        #noPetBackdrop.visible {
            opacity: 1;
        }

        #noPetModal {
            background: #fff;
            border-radius: 24px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 32px 80px rgba(0, 0, 0, .22);
            overflow: hidden;
            transform: scale(.92) translateY(24px);
            transition: transform .28s cubic-bezier(.34, 1.56, .64, 1), opacity .25s;
            opacity: 0;
        }

        #noPetBackdrop.visible #noPetModal {
            transform: none;
            opacity: 1;
        }

        .npm-header {
            background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
            padding: 32px 28px 24px;
            text-align: center;
            position: relative;
        }

        .npm-icon {
            width: 72px;
            height: 72px;
            background: rgba(255, 255, 255, .18);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 14px;
            font-size: 32px;
            color: #fff;
            border: 2.5px solid rgba(255, 255, 255, .35);
        }

        .npm-title {
            font-size: 20px;
            font-weight: 800;
            color: #fff;
            margin: 0 0 6px;
            letter-spacing: -.3px;
        }

        .npm-sub {
            font-size: 13px;
            color: rgba(255, 255, 255, .78);
            margin: 0;
            line-height: 1.5;
        }

        .npm-body {
            padding: 28px;
        }

        .npm-steps {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-bottom: 24px;
        }

        .npm-step {
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .npm-step-num {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #eff6ff;
            color: #2563eb;
            font-size: 13px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-top: 1px;
        }

        .npm-step-text {
            font-size: 13px;
            color: #475569;
            line-height: 1.5;
        }

        .npm-step-text strong {
            color: #0f172a;
            font-weight: 700;
        }

        .npm-btn-primary {
            display: block;
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            color: #fff;
            border: none;
            border-radius: 50px;
            font-weight: 700;
            font-size: 15px;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            transition: .22s;
            text-align: center;
            text-decoration: none;
            box-shadow: 0 6px 20px rgba(37, 99, 235, .3);
            margin-bottom: 10px;
        }

        .npm-btn-primary:hover {
            opacity: .9;
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(37, 99, 235, .4);
        }

        .npm-btn-secondary {
            display: block;
            width: 100%;
            padding: 12px;
            background: transparent;
            color: #64748b;
            border: 1.5px solid #e2e8f0;
            border-radius: 50px;
            font-weight: 600;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            transition: .18s;
            text-align: center;
        }

        .npm-btn-secondary:hover {
            background: #E6EEF8;
            border-color: #cbd5e1;
            color: #334155;
        }

        .pet-select-card.selected {
            border-color: #2563eb !important;
            background: #eff6ff !important;
            box-shadow: 0 0 0 3px rgba(37,99,235,.12) !important;
        }
        .pet-select-card.selected .pet-check-badge {
            display: inline-flex !important;
        }
        .pet-select-card:hover {
            border-color: #3b82f6;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(37,99,235,.1);
        }

        .sidebar::-webkit-scrollbar {
            width: 5px;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: transparent;
