        $_SESSION['msg_type'] = "success";
        if ($type === 'Boarding') {
            notify_clinic_appt($conn, "$user_name cancelled boarding reservation #$cid for {$brow['pet_name']} (check-in " . date('M d, Y', strtotime($brow['appointment_date'])) . "). The cage is free again.", 'Boarding', $cid);
        } else {
