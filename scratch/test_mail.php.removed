<?php
use PHPMailer\PHPMailer\PHPMailer;
use PHPMailer\PHPMailer\Exception;
require 'PHPMailer/src/Exception.php';
require 'PHPMailer/src/PHPMailer.php';
require 'PHPMailer/src/SMTP.php';

$to = $_GET['to'] ?? 'timferrer1@gmail.com';

ob_start();

$mail = new PHPMailer(true);
try {
    $mail->SMTPDebug = 2;
    $mail->Debugoutput = 'echo';
    $mail->isSMTP();
    $mail->Host       = 'smtp.gmail.com';
    $mail->SMTPAuth   = true;
    $mail->Username   = 'timferrer1@gmail.com';
    $mail->Password   = 'azrpmoxxzvhucetu';
    $mail->SMTPSecure = PHPMailer::ENCRYPTION_STARTTLS;
    $mail->Port       = 587;
    $mail->SMTPOptions = [
        'ssl' => ['verify_peer' => false, 'verify_peer_name' => false, 'allow_self_signed' => true],
    ];
    $mail->setFrom('timferrer1@gmail.com', 'PragmaVet Test');
    $mail->addAddress($to);
    $mail->isHTML(true);
    $mail->Subject = 'PragmaVet Test - ' . date('H:i:s');
    $mail->Body    = '<h2>Test OTP: 123456</h2><p>This is a test email sent at ' . date('Y-m-d H:i:s') . '</p>';
    $mail->AltBody = 'Test OTP: 123456. Sent at: ' . date('Y-m-d H:i:s');
    $mail->send();

    $debug = ob_get_clean();
    echo json_encode(['success' => true, 'to' => $to, 'debug' => $debug]);
} catch (Exception $e) {
    $debug = ob_get_clean();
    echo json_encode(['success' => false, 'error' => $mail->ErrorInfo, 'debug' => $debug]);
}
