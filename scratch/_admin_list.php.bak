<script>
function filterOwners() {
    var q = document.getElementById('ownerSearch').value.toLowerCase().trim();
    var dd = document.getElementById('ownerDropdown');
    var opts = dd.querySelectorAll('.owner-opt');
    dd.style.display = q.length > 0 ? 'block' : 'none';
    opts.forEach(function(o) {
        var ownerName = o.dataset.name.toLowerCase();
        var pets = JSON.parse(o.dataset.pets || '[]');
        var petMatch = pets.some(p => p.name.toLowerCase().includes(q));
        o.style.display = (ownerName.includes(q) || petMatch) ? 'block' : 'none';
    });
}
function selectOwner(el) {
    document.getElementById('ownerSearch').value = el.dataset.name;
    document.getElementById('walkin_user_id').value = el.dataset.uid;
    document.getElementById('ownerDropdown').style.display = 'none';
    var pets = JSON.parse(el.dataset.pets || '[]');
    var sel = document.getElementById('walkin_pet_select');
    var addInline = document.getElementById('addPetInline');
    document.getElementById('walkin_pet_name').value = '';
    if (pets.length === 0) {
        sel.innerHTML = '<option value="">â€” No pets registered â€”</option>';
        sel.style.display = 'none';
        addInline.style.display = 'block';
        document.getElementById('h_do_add_pet').value = '1';
    } else {
        sel.style.display = 'block';
        addInline.style.display = 'none';
        document.getElementById('h_do_add_pet').value = '0';
        sel.innerHTML = '<option value="">â€” Select registered pet â€”</option>';
        pets.forEach(function(p) {
            var o = document.createElement('option');
            o.value = p.name;
            o.textContent = p.name + ' (' + (p.species || '?') + ')';
            sel.appendChild(o);
        });
    }
}
function petSelected(sel) {
    if (sel.value) document.getElementById('walkin_pet_name').value = sel.value;
}
function syncInlinePet() {
    var name = document.getElementById('inline_pet_name').value;
    document.getElementById('walkin_pet_name').value = name;
}
document.addEventListener('click', function(e) {
    if (!e.target.closest('#ownerSearch') && !e.target.closest('#ownerDropdown')) {
        document.getElementById('ownerDropdown').style.display = 'none';
    }
});
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/tablesort/5.2.1/tablesort.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/tablesort/5.2.1/sorts/tablesort.number.min.js"></script>
<script>
// Toast auto-dismiss
(function(){ var t=document.getElementById('toastMsg'); if(t) setTimeout(function(){ t.style.opacity='0'; t.style.transform='translateY(-14px)'; setTimeout(function(){t.remove();},400); },4500); })();

// Init plugins
document.addEventListener('DOMContentLoaded',function(){
    flatpickr('.flatpickr-dt',{ enableTime:true, dateFormat:'Y-m-d H:i', minDate:'today' });
    var t = document.getElementById('apptTable');
    if(t) new Tablesort(t, { descending: true });
});

// Live search + filter tabs
(function(){
    var inp    = document.getElementById('apptSearch');
    var body   = document.getElementById('apptBody');
    var noRes  = document.getElementById('noResult');
    var activeF = 'all';
    var tsInstance = null;

    function matchStatus(rowStatus, filter) {
        if (filter === 'all') return true;
        var rs = (rowStatus || '').toLowerCase();
        var f  = filter.toLowerCase();
        if (f === 'cancelled') return rs.includes('cancel') || rs.includes('reject');
        return rs === f;
    }

    function apply(){
        if (!body) return;
        var q   = inp ? inp.value.toLowerCase().trim() : '';
        var rows = body.querySelectorAll('.appt-row');
        var vis  = 0;
        rows.forEach(function(r){
            var sm = matchStatus(r.dataset.status, activeF);
            var tm = !q || r.innerText.toLowerCase().includes(q);
            var show = sm && tm;
            r.style.display = show ? '' : 'none';
            if (show) vis++;
        });
        if (noRes) noRes.style.display = vis === 0 ? 'block' : 'none';
    }

    if (inp) inp.addEventListener('input', apply);

    document.querySelectorAll('.ftab').forEach(function(btn){
        btn.addEventListener('click', function(){
            document.querySelectorAll('.ftab').forEach(function(b){ b.classList.remove('active'); });
            btn.classList.add('active');
            activeF = btn.dataset.filter;
            apply();
        });
    });
})();

// Helpers
function esc(s){ return s?String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'):'-'; }
function fmtDate(d){ if(!d) return '-'; var o=new Date(d+'T00:00:00'); return o.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}); }
function fmtTime(t){ if(!t) return ''; var p=t.split(':'); var h=parseInt(p[0]),m=p[1],ap=h>=12?'PM':'AM'; h=h%12||12; return h+':'+m+' '+ap; }
function fmtFull(s){ if(!s) return '-'; return new Date(s).toLocaleString('en-US',{month:'short',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit',hour12:true}); }
function statusBadge(s){
    var cls='bs-default',dot='#94a3b8';
    if(s==='Pending'){cls='bs-pending';dot='#ea580c';}
    else if(s==='Approved'){cls='bs-approved';dot='#16a34a';}
    else if(s==='Completed'){cls='bs-completed';dot='#2563eb';}
    else if(s==='Reschedule Proposed'){cls='bs-proposed';dot='#7e22ce';}
    else if(s==='Reschedule Requested'){cls='bs-requested';dot='#7c3aed';}
    else if(s.includes('Cancel')||s.includes('Reject')){cls='bs-cancelled';dot='#be123c';}
    return '<span class="bs '+cls+'" style="font-size:14px;padding:7px 18px;"><span style="width:9px;height:9px;border-radius:50%;background:'+dot+';flex-shrink:0;"></span>'+esc(s)+'</span>';
}

function openModal(d){
    document.getElementById('dm-svc').textContent     = d.service_type || 'Appointment';
    document.getElementById('dm-dt').textContent      = fmtDate(d.appointment_date) + (d.appointment_time ? ' at '+fmtTime(d.appointment_time) : '');
    document.getElementById('dm-status-w').innerHTML  = statusBadge(d.status);
    document.getElementById('dm-client').textContent  = d.client_name || '-';
    document.getElementById('dm-pet').textContent     = d.pet_name || '-';
    document.getElementById('dm-doctor').textContent  = d.doctor_name || 'Unassigned';
    document.getElementById('dm-loc').textContent     = d.service_location || '-';
    document.getElementById('dm-created').textContent = fmtFull(d.created_at);
    document.getElementById('dm-id').textContent      = '#' + d.id;
    document.getElementById('dm-apt-id').value        = d.id;

    var addrW = document.getElementById('dm-addr-w');
    if(d.service_location==='Home Service' && d.home_address){ addrW.style.display='block'; document.getElementById('dm-addr').textContent=d.home_address; }
    else addrW.style.display='none';

    // Show Audit Trail (Always visible)
    var auditW = document.getElementById('dm-audit-w');
    auditW.style.display = 'block';
    if (d.admin_message && d.admin_message.trim() !== '') {
        document.getElementById('dm-audit').textContent = d.admin_message;
        document.getElementById('dm-audit').style.color = '#0c4a6e';
        document.getElementById('dm-audit').style.fontStyle = 'normal';
    } else {
        document.getElementById('dm-audit').textContent = "No audit logs available for this appointment yet.";
        document.getElementById('dm-audit').style.color = '#94a3b8';
        document.getElementById('dm-audit').style.fontStyle = 'italic';
    }

    // Actions visibility
    var actW = document.getElementById('dm-actions');
    var approveW  = document.getElementById('dm-approve-w');
    var completeW = document.getElementById('dm-complete-w');
    var msgW      = document.getElementById('dm-msg-w');

    var showActions = !['Completed','Cancelled','Rejected'].includes(d.status);
    /* actW display hidden */
    /* approveW display hidden */
    /* completeW display hidden */
    /* msgW display hidden */
    
    // Reschedule section styling for Pending
    var reschedW_area = document.getElementById('dm-resched-w');
    if (d.status === 'Pending') {
        reschedW_area.style.border = '1.5px dashed #ea580c';
        reschedW_area.style.background = '#fffaf5';
    } else {
        reschedW_area.style.border = '1px solid #e2e8f0';
        reschedW_area.style.background = '#f8fafc';
    }


    // Client Reschedule Actions
    var reschedW = document.getElementById('dm-client-resched-w');
    if(!reschedW) {
        reschedW = document.createElement('div');
        reschedW.id = 'dm-client-resched-w';
        reschedW.style.marginTop = '15px';
        approveW.parentNode.insertBefore(reschedW, completeW);
    }
    if(d.status === 'Reschedule Requested') {
        reschedW.style.display = 'none';
        reschedW.innerHTML = '<div style="background:#f5f3ff; border:1.5px solid #ddd6fe; border-radius:12px; padding:15px; margin-bottom:15px;">' +
            '<div style="font-size:11px; font-weight:800; color:#7c3aed; text-transform:uppercase; margin-bottom:5px;"><i class="fa fa-info-circle me-1"></i> Client Requested Reschedule</div>' +
            '<div style="font-size:14px; color:#1e1b4b; font-weight:700; margin-bottom:4px;">Proposed: ' + fmtDate(d.proposed_reschedule_date) + ' at ' + fmtTime(d.proposed_reschedule_time) + '</div>' +
            '<div style="font-size:13px; color:#4c1d95;">Reason: ' + esc(d.admin_message) + '</div>' +
            '<div style="display:flex; gap:8px; margin-top:12px;">' +
                '<button onclick="adminManage(\'accept_client_resched\')" class="btn-action green" style="flex:1;"><i class="fa fa-check me-1"></i> Accept Shift</button>' +
                '<button onclick="adminManage(\'decline_client_resched\')" class="btn-action red" style="flex:1;"><i class="fa fa-times me-1"></i> Decline</button>' +
            '</div>' +
        '</div>';
    } else {
        reschedW.style.display = 'none';
    }

    var archBtn = document.getElementById('dm-archive-btn');
    if(archBtn) archBtn.style.display = (['Completed','Cancelled','Rejected'].includes(d.status) && !parseInt(d.is_archived)) ? 'inline-flex' : 'none';
    window._modalAptId = d.id;
    window._modalApptType = d._type || 'Appointment';
    
    document.getElementById('dm-appt-type').value = window._modalApptType;

    var bd = document.getElementById('detailBd');
    bd.classList.add('open');
    setTimeout(function(){ bd.style.opacity='1'; },10);

    // Re-init flatpickr on dynamic modal
    setTimeout(function(){
        flatpickr('.flatpickr-dt', { enableTime:true, dateFormat:'Y-m-d H:i', minDate:'today' });
    },100);
}

function closeModal(){
    var bd = document.getElementById('detailBd');
    bd.style.opacity='0';
    setTimeout(function(){ bd.classList.remove('open'); bd.style.opacity=''; },180);
}
document.getElementById('detailBd').addEventListener('click',function(e){ if(e.target===this) closeModal(); });
document.addEventListener('keydown',function(e){ if(e.key==='Escape') closeModal(); });

// Also expose triggerModal for compatibility with admin.php widgets
function triggerModal(id,title,client,pet,service,time,status,created,approved,date){
    openModal({id:id,client_name:client,pet_name:pet,service_type:service,appointment_time:time,status:status,created_at:created,appointment_date:date,doctor_name:'',service_location:'On-Site',home_address:'',is_archived:0});
}

function archiveFromModal(){
    Swal.fire({
        title: 'Archive Record?',
        text: 'This will move the record to the Archive page.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#475569',
        cancelButtonColor: '#94a3b8',
        confirmButtonText: 'Yes, Archive'
    }).then((result) => {
        if (result.isConfirmed) {
            var f=document.createElement('form'); f.method='POST'; f.style.display='none';
            f.innerHTML='<input name="archive_appt" value="1"><input name="apt_id" value="'+window._modalAptId+'"><input name="appt_type" value="'+(window._modalApptType || 'Appointment')+'">';
            document.body.appendChild(f); f.submit();
        }
    });
}

function adminManage(cmd) {
    var f = document.getElementById('adminActForm');
    if (!f) return;
    var cmdInp = f.querySelector('input[name="admin_manage_appt"]');
    if (!cmdInp) {
        cmdInp = document.createElement('input');
        cmdInp.type = 'hidden';
        cmdInp.name = 'admin_manage_appt';
        f.appendChild(cmdInp);
    }
    cmdInp.value = cmd;
    var msg = "";
    if (cmd === 'accept_client_resched') msg = "Accept the client's reschedule request?";
    else if (cmd === 'decline_client_resched') msg = "Decline the client's reschedule request?";
    if (msg && !confirm(msg)) return;
    f.submit();
}

// QUICK PET EMR PREVIEW
const PET_EMR_DATA = <?= json_encode($pets_emr_list) ?>;

function openQuickPetEmr(petName, userId, event) {
    if (event) event.stopPropagation();
    const key = (userId + '_' + petName.trim()).toLowerCase();
    const pet = PET_EMR_DATA[key] || null;

    document.getElementById('emrPetName').textContent = petName;
    document.getElementById('emrOwnerName').textContent = pet ? 'Owner: ' + pet.owner_name : 'Owner Verified';
    document.getElementById('emrSpeciesBreed').textContent = pet ? (pet.species + ' (' + (pet.breed || 'Mixed') + ')') : 'Canine / Feline';
    document.getElementById('emrGenderWeight').textContent = pet ? ((pet.gender || 'Unknown') + ' • ' + (pet.weight ? pet.weight + ' kg' : 'Standard')) : 'Recorded';
    document.getElementById('emrAllergies').textContent = (pet && pet.allergies && pet.allergies.trim()) ? pet.allergies : 'No known food or drug allergies reported.';
    document.getElementById('emrInstructions').textContent = (pet && pet.special_instructions && pet.special_instructions.trim()) ? pet.special_instructions : 'Standard clinic observation and checkup routine.';
    document.getElementById('emrLastVac').textContent = (pet && pet.last_vaccination) ? pet.last_vaccination : 'Up-to-date';
    document.getElementById('emrNextVac').textContent = (pet && pet.next_vaccination) ? pet.next_vaccination : 'Scheduled';

    const dlBtn = document.getElementById('emrDownloadPdfBtn');
    if (dlBtn) {
        if (pet && pet.id) {
            dlBtn.href = 'download_emr.php?pet_id=' + pet.id;
            dlBtn.classList.remove('disabled');
            dlBtn.style.display = 'inline-flex';
        } else {
            dlBtn.href = '#';
            dlBtn.classList.add('disabled');
        }
    }

    const modalEl = document.getElementById('quickPetEmrModal');
    if (modalEl) {
        const modal = new bootstrap.Modal(modalEl);
        modal.show();
    }
}
</script>

