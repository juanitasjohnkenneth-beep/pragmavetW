<?php
session_start();
include("dbconnection.php");
include_once("includes/rbac_guard.php");
include("helpers_smart_scheduling.php");
include_once("includes/pet_data_helper.php");

// RBAC Access Guard
$user_role = rbac_get_role();
if (!isset($_SESSION['user_id']) || !in_array($user_role, ['admin', 'staff', 'clinic_owner', 'owner'])) {
    header("Location: " . rbac_home_url($user_role));
    exit();
}

// Counts (Moved to top for sidebar badges)
$counts = [];
foreach (['all','Pending','Approved','Completed','Cancelled','No Show','Reschedule Requested'] as $s) {
    if ($s === 'all') {
        $c = $conn->query("SELECT COUNT(*) as c FROM appointments WHERE is_archived = 0 AND service_type != 'Pet Boarding Reservation'");
        $bc = $conn->query("SELECT COUNT(*) as c FROM boarding_reservations WHERE is_archived = 0");
    } else {
        $c = $conn->query("SELECT COUNT(*) as c FROM appointments WHERE is_archived = 0 AND status='$s' AND service_type != 'Pet Boarding Reservation'");
        $bc = $conn->query("SELECT COUNT(*) as c FROM boarding_reservations WHERE is_archived = 0 AND status='$s'");
    }
    $ac = $c ? $c->fetch_assoc()['c'] : 0;
    $bcc = $bc ? $bc->fetch_assoc()['c'] : 0;
    $counts[$s] = $ac + $bcc;
}

// POST: Mark No Show
if (isset($_POST['mark_no_show']) && isset($_POST['apt_id'])) {
    $apt_id = (int)$_POST['apt_id'];
    $stmt = $conn->prepare("UPDATE appointments SET status='No Show' WHERE id=?");
    $stmt->bind_param("i", $apt_id);
    if ($stmt->execute()) {
        $_SESSION['message'] = "Appointment #$apt_id marked as No Show.";
        $_SESSION['msg_type'] = "warning";
    }
    header("Location: admin_list.php"); exit();
}

use PHPMailer\PHPMailer\PHPMailer;
use PHPMailer\PHPMailer\Exception;
require 'PHPMailer/src/Exception.php';
require 'PHPMailer/src/PHPMailer.php';
require 'PHPMailer/src/SMTP.php';

// â”€â”€ Helper: send email + notification â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function sendApptEmail($conn, $apt_id, $subject, $bodyHtml, $notif_msg) {
    $q = $conn->query("SELECT a.user_id, a.pet_name, a.appointment_date, u.email, u.fullname FROM appointments a JOIN users u ON a.user_id = u.id WHERE a.id=$apt_id");
    if (!$q || $q->num_rows === 0) return;
    $d = $q->fetch_assoc();
    $uid = $d['user_id'];
    $ins = $conn->prepare("INSERT INTO notifications(user_id, message) VALUES(?,?)");
    $ins->bind_param("is", $uid, $notif_msg);
    $ins->execute();
    try {
        $mail = new PHPMailer(true);
        $mail->isSMTP(); $mail->Host='smtp.gmail.com'; $mail->SMTPAuth=true;
        $mail->Username='timferrer1@gmail.com'; $mail->Password='azrpmoxxzvhucetu';
        $mail->SMTPSecure=PHPMailer::ENCRYPTION_STARTTLS; $mail->Port=587;
        $mail->setFrom('timferrer1@gmail.com','PragmaVet Clinic');
        $mail->addAddress($d['email'], $d['fullname']);
        $mail->isHTML(true); $mail->Subject=$subject; $mail->Body=$bodyHtml;
        $mail->send();
    } catch (Exception $e) {}
}

// â”€â”€ POST: Book Appointment (Walk-in, auto-Approved with Smart Scheduling) â”€â”€â”€â”€
if (isset($_POST['book_walkin_appt'])) {
    $uid      = (int)$_POST['walkin_user_id'];
    $pet_name = trim($_POST['walkin_pet_name']);
    $service  = trim($_POST['walkin_service']);
    $date     = $_POST['walkin_date'];
    $time     = $_POST['walkin_time'];
    $location = $_POST['walkin_location'] ?? 'On-Site';
    $doc_id   = !empty($_POST['walkin_doctor']) ? (int)$_POST['walkin_doctor'] : null;

    // â”€â”€â”€ SMART SCHEDULING VALIDATION FOR WALK-INS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    
    // Validate pet name is not empty
    if (empty($pet_name)) {
        $_SESSION['message'] = "âŒ Pet name cannot be empty.";
        $_SESSION['msg_type'] = "danger";
        header("Location: admin_list.php");
        exit();
    }
    
    // For walk-ins, allow same-day and past bookings, but perform all other validations
    if (!empty($doc_id) && !empty($service)) {
        $validation = validate_appointment_slot($conn, $doc_id, $date, $time, $service, false);
        if (!$validation['valid']) {
            $_SESSION['message'] = "âŒ Cannot book walk-in: " . htmlspecialchars($validation['message']);
            $_SESSION['msg_type'] = "danger";
            header("Location: admin_list.php");
            exit();
        }
        $duration_minutes = $validation['data']['duration_minutes'] ?? 30;
        $appointment_end_time = $validation['data']['end_time'];
    } else {
        // If no doctor specified, default to 30 minutes
        $duration_minutes = 30;
        $appointment_end_time = date('H:i:s', strtotime($time . ' +' . $duration_minutes . ' minutes'));
    }

    // If inline pet was added, save it to pets table first
    if (!empty($_POST['do_add_pet']) && $_POST['do_add_pet'] === '1' && !empty($pet_name)) {
        $sp = trim($_POST['inline_pet_species'] ?? '');
        $br = trim($_POST['inline_pet_breed'] ?? '');
        $ag = (int)($_POST['inline_pet_age'] ?? 0);
        $ip = $conn->prepare("INSERT INTO pets(user_id,name,species,breed,age) VALUES(?,?,?,?,?)");
        if ($ip) { $ip->bind_param("isssi", $uid, $pet_name, $sp, $br, $ag); $ip->execute(); }
    }

    $doc_param = $doc_id ?: null;
    $stmt = $conn->prepare("INSERT INTO appointments(user_id, pet_name, service_type, appointment_date, appointment_time, appointment_end_time, service_duration_minutes, service_location, doctor_id, status, approved_at) VALUES(?,?,?,?,?,?,?,?,?,'Approved',NOW())");
    if (!$stmt) {
        $_SESSION['message']  = "âŒ Prepare failed: " . htmlspecialchars($conn->error);
        $_SESSION['msg_type'] = "danger";
        header("Location: admin_list.php"); exit();
    }
    $stmt->bind_param("issssssis", $uid, $pet_name, $service, $date, $time, $appointment_end_time, $duration_minutes, $location, $doc_param);
    if ($stmt->execute()) {
        $new_appointment_id = $stmt->insert_id;
        
        // Insert into appointment_pets junction table
        include_once("includes/pet_data_helper.php");
        $pet_ids = [];
        // Try to find pet_id from pets table
        $pet_q = $conn->prepare("SELECT id FROM pets WHERE user_id=? AND name=?");
        if ($pet_q) {
            $pet_q->bind_param("is", $uid, $pet_name);
            $pet_q->execute();
            $pet_r = $pet_q->get_result();
            if ($pet_r && $pet_r->num_rows > 0) {
                $pet_ids[] = $pet_r->fetch_assoc()['id'];
            } else {
                $pet_ids[] = null;
            }
        }
        if (function_exists('insertAppointmentPets')) {
            insertAppointmentPets($conn, $new_appointment_id, $uid, $pet_ids, [$pet_name]);
        }
        
        $notif = "A walk-in appointment for <b>$pet_name</b> on ".date('M d, Y', strtotime($date))." at ".substr($time, 0, 5)." has been booked and Approved.";
        $ins = $conn->prepare("INSERT INTO notifications(user_id, message) VALUES(?,?)");
        if ($ins) { $ins->bind_param("is", $uid, $notif); $ins->execute(); }
        $_SESSION['message']  = "âœ… Walk-in appointment booked & approved for $pet_name! Duration: " . $duration_minutes . " minutes";
        $_SESSION['msg_type'] = "success";
    } else {
        if (strpos($conn->error, 'Duplicate') !== false || strpos($conn->error, 'unique') !== false) {
            $_SESSION['message']  = "âŒ Time slot conflict: This slot was just taken. Please choose another time.";
        } else {
            $_SESSION['message']  = "âŒ Error: " . htmlspecialchars($conn->error);
        }
        $_SESSION['msg_type'] = "danger";
    }
    header("Location: admin_list.php"); exit();
}

// Fetch owners + pets for Book Appointment modal
$owners_q = $conn->query("SELECT u.id, u.fullname, p.id as pet_id, p.name as pet_name, p.species FROM users u LEFT JOIN pets p ON p.user_id = u.id WHERE u.role IN ('user','client') ORDER BY u.fullname, p.name");
$owners_map = [];
if ($owners_q) {
    while ($row = $owners_q->fetch_assoc()) {
        if (!isset($owners_map[$row['id']])) {
            $owners_map[$row['id']] = ['fullname' => $row['fullname'], 'pets' => []];
        }
        if ($row['pet_id']) {
            $owners_map[$row['id']]['pets'][] = ['id' => $row['pet_id'], 'name' => $row['pet_name'], 'species' => $row['species']];
        }
    }
}
$doctors_q = $conn->query("SELECT id, fullname FROM users WHERE role='doctor' ORDER BY fullname");
$doctors_list = [];
if ($doctors_q) { while ($d = $doctors_q->fetch_assoc()) $doctors_list[] = $d; }


// â”€â”€ POST: Quick Approve â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
if (isset($_POST['action']) && isset($_POST['apt_id'])) {
    $apt_id = (int)$_POST['apt_id'];
    $action = $_POST['action'];
    $type = $_POST['appt_type'] ?? 'Appointment';
    $new_status = $action === 'approve' ? 'Approved' : 'Rejected';
    
    $table = $type === 'Boarding' ? 'boarding_reservations' : 'appointments';
    if ($action === 'approve') {
        $s = $conn->prepare("UPDATE $table SET status=?, approved_at=NOW() WHERE id=?");
    } else {
        $s = $conn->prepare("UPDATE $table SET status=? WHERE id=?");
    }
    $s->bind_param("si", $new_status, $apt_id);
    if ($s->execute()) {
        $q = $conn->query("SELECT a.user_id, a.pet_name, a.appointment_date, u.email, u.fullname FROM $table a JOIN users u ON a.user_id = u.id WHERE a.id=$apt_id");
        if ($q && $q->num_rows > 0) {
            $d = $q->fetch_assoc();
            $uid  = $d['user_id'];
            $pn   = $d['pet_name'];
            $adate= date("M d, Y", strtotime($d['appointment_date']));
            // Get full pet list for notification
            if ($table === 'appointments' && function_exists('getAppointmentPetSummary')) {
                $pn_display = getAppointmentPetSummary($conn, $apt_id);
            } else {
                $pn_display = $pn;
            }
            $msg  = "Your appointment for <b>$pn_display</b> on $adate has been <b>$new_status</b>.";
            $ins  = $conn->prepare("INSERT INTO notifications(user_id,message) VALUES(?,?)");
            $ins->bind_param("is", $uid, $msg);
            $ins->execute();
            try {
                $mail = new PHPMailer(true);
                $mail->isSMTP(); $mail->Host='smtp.gmail.com'; $mail->SMTPAuth=true;
                $mail->Username='timferrer1@gmail.com'; $mail->Password='azrpmoxxzvhucetu';
                $mail->SMTPSecure=PHPMailer::ENCRYPTION_STARTTLS; $mail->Port=587;
                $mail->setFrom('timferrer1@gmail.com','PragmaVet Clinic');
                $mail->addAddress($d['email'],$d['fullname']);
                $mail->isHTML(true); $mail->Subject='Appointment Update | PragmaVet';
                $mail->Body="<div style='font-family:Arial,sans-serif;max-width:600px;padding:25px;border:1px solid #e1e8ed;border-radius:10px;'><h2 style='color:#2563eb;'>Hello, {$d['fullname']}!</h2><div style='background:#E6EEF8;padding:20px;border-radius:8px;border-left:4px solid #3b82f6;margin:20px 0;'><p style='margin:0;'>$msg</p></div></div>";
                $mail->send();
            } catch (Exception $e) {}
        }
        $_SESSION['message']  = "Appointment #$apt_id marked as $new_status.";
        $_SESSION['msg_type'] = "success";
    }
    header("Location: admin_list.php"); exit();
}

// â”€â”€ POST: Advanced manage (complete / cancel / reschedule) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
if (isset($_POST['admin_manage_appt']) && isset($_POST['apt_id'])) {
    $apt_id = (int)$_POST['apt_id'];
    $cmd    = $_POST['admin_manage_appt'];
    $type   = $_POST['appt_type'] ?? 'Appointment';
    $table  = $type === 'Boarding' ? 'boarding_reservations' : 'appointments';
    
    $q = $conn->query("SELECT a.user_id,a.pet_name,a.appointment_date,u.email,u.fullname FROM $table a JOIN users u ON a.user_id=u.id WHERE a.id=$apt_id");
    if ($q && $q->num_rows > 0) {
        $d = $q->fetch_assoc();
        $uid = $d['user_id']; $pn = $d['pet_name'];
        $old_date = date("M d, Y", strtotime($d['appointment_date']));
        // Get full pet list for notification
        if ($table === 'appointments' && function_exists('getAppointmentPetSummary')) {
            $pn_display = getAppointmentPetSummary($conn, $apt_id);
        } else {
            $pn_display = $pn;
        }
        if ($cmd === 'approve') {
            $s = $conn->prepare("UPDATE $table SET status='Approved', approved_at=NOW() WHERE id=?");
            $s->bind_param("i", $apt_id); $s->execute();
            $notif = "Your appointment for <b>$pn_display</b> on $old_date has been <b>Approved</b>.";
            $ins = $conn->prepare("INSERT INTO notifications(user_id,message) VALUES(?,?)");
            $ins->bind_param("is",$uid,$notif); $ins->execute();
            $_SESSION['message'] = "Request #$apt_id approved.";
        } elseif ($cmd === 'complete') {
            $s = $conn->prepare("UPDATE $table SET status='Completed' WHERE id=?");
            $s->bind_param("i",$apt_id); $s->execute();
            $notif = "Your appointment for <b>$pn_display</b> on $old_date has been marked as <b>Completed</b>. Thank you!";
            $ins = $conn->prepare("INSERT INTO notifications(user_id,message) VALUES(?,?)");
            $ins->bind_param("is",$uid,$notif); $ins->execute();
            try {
                $mail = new PHPMailer(true); $mail->isSMTP(); $mail->Host='smtp.gmail.com'; $mail->SMTPAuth=true;
                $mail->Username='timferrer1@gmail.com'; $mail->Password='azrpmoxxzvhucetu';
                $mail->SMTPSecure=PHPMailer::ENCRYPTION_STARTTLS; $mail->Port=587;
                $mail->setFrom('timferrer1@gmail.com','PragmaVet Clinic'); $mail->addAddress($d['email'],$d['fullname']);
                $mail->isHTML(true); $mail->Subject='Appointment Completed | PragmaVet';
                $mail->Body="<div style='font-family:Arial,sans-serif;max-width:600px;padding:25px;border:1px solid #e1e8ed;border-radius:10px;'><h2 style='color:#2563eb;'>Hello, {$d['fullname']}!</h2><div style='background:#e6fcf5;padding:20px;border-radius:8px;border-left:4px solid #38A169;margin:20px 0;'><p style='margin:0;'>$notif</p></div></div>";
                $mail->send();
            } catch (Exception $e) {}
            $_SESSION['message'] = "Request #$apt_id marked Completed.";
        } elseif ($cmd === 'cancel') {
            $reason = $_POST['admin_message'] ?? 'Administrative Cancellation';
            $s = $conn->prepare("UPDATE $table SET status='Cancelled', admin_message=?, client_action_needed=0 WHERE id=?");
            $s->bind_param("si",$reason,$apt_id); $s->execute();
            $notif = "Your appointment for <b>$pn_display</b> on $old_date was Cancelled. Reason: $reason";
            $ins = $conn->prepare("INSERT INTO notifications(user_id,message) VALUES(?,?)");
            $ins->bind_param("is",$uid,$notif); $ins->execute();
            $chatMsg = "Admin Notice: Your appointment for $pn on $old_date was Cancelled. Reason: $reason";
            $ic = $conn->prepare("INSERT INTO chat_messages(sender_id,receiver_id,message) VALUES((SELECT id FROM users WHERE role='admin' ORDER BY id ASC LIMIT 1),?,?)");
            $ic->bind_param("is",$uid,$chatMsg); $ic->execute();
            try {
                $mail = new PHPMailer(true); $mail->isSMTP(); $mail->Host='smtp.gmail.com'; $mail->SMTPAuth=true;
                $mail->Username='timferrer1@gmail.com'; $mail->Password='azrpmoxxzvhucetu';
                $mail->SMTPSecure=PHPMailer::ENCRYPTION_STARTTLS; $mail->Port=587;
                $mail->setFrom('timferrer1@gmail.com','PragmaVet Clinic'); $mail->addAddress($d['email'],$d['fullname']);
                $mail->isHTML(true); $mail->Subject='Appointment Cancelled | PragmaVet';
                $mail->Body="<div style='font-family:Arial,sans-serif;max-width:600px;padding:25px;border:1px solid #e1e8ed;border-radius:10px;'><h2 style='color:#c92a2a;'>Hello, {$d['fullname']}!</h2><div style='background:#fdf5f5;padding:20px;border-radius:8px;border-left:4px solid #c92a2a;margin:20px 0;'><p style='margin:0;'>$notif</p></div></div>";
                $mail->send();
            } catch (Exception $e) {}
            $_SESSION['message'] = "Request #$apt_id cancelled.";
        } elseif ($cmd === 'reschedule') {
            $parts = explode(" ", $_POST['new_date'] ?? '');
            $new_date_raw = $parts[0] ?? '';
            $new_time_raw = isset($parts[1]) ? date("H:i", strtotime($parts[1])) : '08:00';
            $reason = $_POST['admin_message'] ?? 'We propose shifting your appointment.';
            $new_date_f = date("M d, Y", strtotime($new_date_raw)) . " at " . date("h:i A", strtotime($new_time_raw));
            
            if ($type === 'Boarding') {
                $s = $conn->prepare("UPDATE $table SET status='Reschedule Proposed', proposed_reschedule_date=?, proposed_reschedule_end_date=?, admin_message=?, client_action_needed=1 WHERE id=?");
                $s->bind_param("sssi",$new_date_raw,$new_date_raw,$reason,$apt_id); $s->execute();
            } else {
                $s = $conn->prepare("UPDATE $table SET status='Reschedule Proposed', proposed_reschedule_date=?, proposed_reschedule_time=?, admin_message=?, client_action_needed=1 WHERE id=?");
                $s->bind_param("sssi",$new_date_raw,$new_time_raw,$reason,$apt_id); $s->execute();
            }
            $notif = "The clinic proposed shifting your appointment for <b>$pn_display</b>. Old: $old_date â†’ New: <b>$new_date_f</b>. Reason: $reason";
            $ins = $conn->prepare("INSERT INTO notifications(user_id,message) VALUES(?,?)");
            $ins->bind_param("is",$uid,$notif); $ins->execute();
            $chatMsg = "Admin: Reschedule proposed for $pn. New Date: $new_date_f. Reason: $reason";
            $ic = $conn->prepare("INSERT INTO chat_messages(sender_id,receiver_id,message) VALUES((SELECT id FROM users WHERE role='admin' ORDER BY id ASC LIMIT 1),?,?)");
            $ic->bind_param("is",$uid,$chatMsg); $ic->execute();
            try {
                $mail = new PHPMailer(true); $mail->isSMTP(); $mail->Host='smtp.gmail.com'; $mail->SMTPAuth=true;
                $mail->Username='timferrer1@gmail.com'; $mail->Password='azrpmoxxzvhucetu';
                $mail->SMTPSecure=PHPMailer::ENCRYPTION_STARTTLS; $mail->Port=587;
                $mail->setFrom('timferrer1@gmail.com','PragmaVet Clinic'); $mail->addAddress($d['email'],$d['fullname']);
                $mail->isHTML(true); $mail->Subject='Reschedule Proposal | PragmaVet';
                $mail->Body="<div style='font-family:Arial,sans-serif;max-width:600px;padding:25px;border:1px solid #e1e8ed;border-radius:10px;'><h2 style='color:#2563eb;'>Hello, {$d['fullname']}!</h2><div style='background:#E6EEF8;padding:20px;border-radius:8px;border-left:4px solid #3b82f6;margin:20px 0;'><p style='margin:0;'>$notif</p></div></div>";
                $mail->send();
            } catch (Exception $e) {}
            $_SESSION['message'] = "Reschedule proposal sent to client.";
        } elseif ($cmd === 'accept_client_resched') {
            $s = $conn->prepare("UPDATE $table SET appointment_date=proposed_reschedule_date, appointment_time=proposed_reschedule_time, status='Approved', proposed_reschedule_date=NULL, proposed_reschedule_time=NULL, client_action_needed=0 WHERE id=?");
            $s->bind_param("i",$apt_id); $s->execute();
            $notif = "Clinic accepted your reschedule for <b>$pn_display</b>. New schedule confirmed.";
            $ins = $conn->prepare("INSERT INTO notifications(user_id,message) VALUES(?,?)");
            $ins->bind_param("is",$uid,$notif); $ins->execute();
            $_SESSION['message'] = "Client reschedule request accepted!";
        } elseif ($cmd === 'decline_client_resched') {
            $reason = $_POST['admin_message'] ?? 'Clinic cannot accommodate the requested schedule.';
            $s = $conn->prepare("UPDATE $table SET status='Approved', proposed_reschedule_date=NULL, proposed_reschedule_time=NULL, client_action_needed=0 WHERE id=?");
            $s->bind_param("i",$apt_id); $s->execute();
            $notif = "Clinic declined your reschedule request for <b>$pn_display</b>. Appointment remains at $old_date. Reason: $reason";
            $ins = $conn->prepare("INSERT INTO notifications(user_id,message) VALUES(?,?)");
            $ins->bind_param("is",$uid,$notif); $ins->execute();
            $_SESSION['message'] = "Client reschedule request declined.";
        }
        $_SESSION['msg_type'] = "success";
    }
    header("Location: admin_list.php"); exit();
}

// â”€â”€ POST: Archive â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

// -- POST: Lifecycle transitions (Check In / In Progress / No Show) -----------
if (isset($_POST['lifecycle_action']) && isset($_POST['apt_id'])) {
    $apt_id  = (int)$_POST['apt_id'];
    $laction = $_POST['lifecycle_action'];
    $allowed = ['check_in' => 'Checked In', 'in_progress' => 'In Progress', 'no_show' => 'No Show'];
    if (isset($allowed[$laction])) {
        $new_status = $allowed[$laction];
        $extra_sql  = '';
        if ($laction === 'check_in')    $extra_sql = ', check_in_time=NOW()';
        if ($laction === 'in_progress') $extra_sql = ', check_in_time=COALESCE(check_in_time,NOW())';
        $conn->query("UPDATE appointments SET status='" . $new_status . "'" . $extra_sql . " WHERE id=" . $apt_id);
        $q = $conn->query("SELECT user_id, pet_name FROM appointments WHERE id=" . $apt_id);
        if ($q && $d = $q->fetch_assoc()) {
            $notif = "Your appointment for " . $d['pet_name'] . " status updated to: " . $new_status;
            $ins = $conn->prepare("INSERT INTO notifications(user_id,message) VALUES(?,?)");
            $ins->bind_param("is", $d['user_id'], $notif);
            $ins->execute();
        }
        $_SESSION['message']  = "Appointment #" . $apt_id . " marked as " . $new_status . ".";
        $_SESSION['msg_type'] = "success";
    }
    header("Location: admin_list.php"); exit();
}
// -- POST: Update Doctor Assignment --
if (isset($_POST['update_doctor_assignment']) && isset($_POST['apt_id'])) {
    $aid = (int)$_POST['apt_id'];
    $doc_id = !empty($_POST['assign_doctor_id']) ? (int)$_POST['assign_doctor_id'] : NULL;
    $stmt = $conn->prepare("UPDATE appointments SET doctor_id=? WHERE id=?");
    $stmt->bind_param("ii", $doc_id, $aid);
    if ($stmt->execute()) {
        $_SESSION['message']  = "Doctor assignment updated successfully for Appointment #$aid.";
        $_SESSION['msg_type'] = "success";
    }
    header("Location: admin_list.php"); exit();
}

if (isset($_POST['archive_appt']) && isset($_POST['apt_id'])) {
    $aid = (int)$_POST['apt_id'];
    $type = $_POST['appt_type'] ?? 'Appointment';
    $table = $type === 'Boarding' ? 'boarding_reservations' : 'appointments';
    $conn->query("UPDATE $table SET is_archived=1 WHERE id=$aid");
    $_SESSION['message']  = "Appointment #$aid moved to Archive.";
    $_SESSION['msg_type'] = "success";
    header("Location: admin_list.php"); exit();
}

// Fetch all doctors for inline assignment
$all_doctors = [];
$doc_q = $conn->query("SELECT id, fullname FROM users WHERE role='doctor' ORDER BY fullname ASC");
if ($doc_q) {
    while ($d = $doc_q->fetch_assoc()) {
        $all_doctors[] = $d;
    }
}

// Fetch pet EMR details for quick view modal
$pets_emr_list = [];
$pemr_q = $conn->query("SELECT p.*, u.fullname as owner_name FROM pets p JOIN users u ON p.user_id = u.id");
if ($pemr_q) {
    while ($p = $pemr_q->fetch_assoc()) {
        $pets_emr_list[strtolower($p['user_id'] . '_' . trim($p['name']))] = $p;
        $pets_emr_list['id_' . $p['id']] = $p;
    }
}

// ── Fetch all appointments ──────────────────────────────────────────────────
// Auto-archive completed/cancelled appointments older than 30 days
$conn->query("UPDATE appointments SET is_archived = 1 WHERE is_archived = 0 AND status IN ('Completed', 'Cancelled', 'Rejected') AND appointment_date < DATE_SUB(CURDATE(), INTERVAL 30 DAY)");
$conn->query("UPDATE boarding_reservations SET is_archived = 1 WHERE is_archived = 0 AND status IN ('Completed', 'Cancelled', 'Rejected') AND appointment_date < DATE_SUB(CURDATE(), INTERVAL 30 DAY)");

$filter = $_GET['filter'] ?? 'all';
$filterSQL = '';
$bFilterSQL = '';
if (in_array($filter, ['Pending','Approved','Completed','Cancelled','Reschedule Proposed','Reschedule Requested'])) {
    $filterSQL = " AND a.status = '$filter'";
    $bFilterSQL = " AND b.status = '$filter'";
}
$appts = $conn->query("SELECT a.*, u.fullname as client_name, IFNULL(d.fullname,'Unassigned') as doctor_name FROM appointments a JOIN users u ON a.user_id = u.id LEFT JOIN users d ON a.doctor_id = d.id WHERE a.is_archived = 0 AND a.service_type != 'Pet Boarding Reservation' $filterSQL ORDER BY a.appointment_date DESC, a.appointment_time DESC");
$rows = [];
if ($appts) {
    while ($r = $appts->fetch_assoc()) {
        $r['_type'] = 'Appointment';
        $rows[] = $r;
    }
}

$boards = $conn->query("SELECT b.*, u.fullname as client_name FROM boarding_reservations b JOIN users u ON b.user_id = u.id WHERE b.is_archived = 0 $bFilterSQL ORDER BY b.appointment_date DESC");
if ($boards) {
    while ($r = $boards->fetch_assoc()) {
        $r['_type'] = 'Boarding';
        $r['doctor_name'] = 'Clinic (Boarding)';
        $r['service_type'] = 'Pet Boarding (Cage ' . str_pad($r['cage_number'] ?? '?', 2, '0', STR_PAD_LEFT) . ')';
        $r['service_location'] = 'On-Site';
        $r['appointment_time'] = $r['appointment_time'] ?? '12:00:00';
        $rows[] = $r;
    }
}

// Sort $rows by date and time DESC
usort($rows, function($a, $b) {
    $dateA = strtotime($a['appointment_date'] . ' ' . $a['appointment_time']);
    $dateB = strtotime($b['appointment_date'] . ' ' . $b['appointment_time']);
    return $dateB - $dateA;
});

?>
