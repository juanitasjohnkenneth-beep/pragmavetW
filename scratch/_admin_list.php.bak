    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <?php
        $stats = [
            ['label'=>'Total','count'=>$counts['all'],       'icon'=>'fa-list-alt',       'bg'=>'#eff6ff','ic'=>'#2563eb'],
            ['label'=>'Pending','count'=>$counts['Pending'], 'icon'=>'fa-clock',           'bg'=>'#fff7ed','ic'=>'#ea580c'],
            ['label'=>'Requests','count'=>$counts['Reschedule Requested'], 'icon'=>'fa-calendar-plus', 'bg'=>'#f5f3ff','ic'=>'#7c3aed'],
            ['label'=>'Approved','count'=>$counts['Approved'],'icon'=>'fa-check-circle',  'bg'=>'#f0fdf4','ic'=>'#16a34a'],
            ['label'=>'Completed','count'=>$counts['Completed'],'icon'=>'fa-star',         'bg'=>'#eff6ff','ic'=>'#2563eb'],
            ['label'=>'No Show','count'=>$counts['No Show'], 'icon'=>'fa-user-slash',    'bg'=>'#fff1f2','ic'=>'#9f1239'],
            ['label'=>'Cancelled','count'=>$counts['Cancelled'],'icon'=>'fa-times-circle','bg'=>'#fff1f2','ic'=>'#be123c'],
        ];
        foreach ($stats as $s): ?>
        <div class="col">
            <div class="stat-card">
                <div class="stat-icon" style="background:<?php echo $s['bg']; ?>;">
                    <i class="fa <?php echo $s['icon']; ?>" style="color:<?php echo $s['ic']; ?>;"></i>
                </div>
                <div>
                    <div style="font-size:22px;font-weight:800;color:#0f172a;"><?php echo $s['count']; ?></div>
                    <div style="font-size:12px;color:#94a3b8;font-weight:600;"><?php echo $s['label']; ?></div>
                </div>
            </div>
        </div>
        <?php endforeach; ?>
    </div>

    <!-- VISUAL FULLCALENDAR CONTAINER (Hidden by default) -->
    <div id="adminCalendarWrapper" class="card-main mb-4 p-4" style="display:none;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark m-0"><i class="fa fa-calendar-alt text-primary me-2"></i>Visual Appointment Schedule</h5>
            <div class="small text-muted">Click any event to view appointment details</div>
        </div>
        <div id="adminFullCalendar" style="min-height: 600px;"></div>
    </div>

    <!-- Main appointments card -->
    <div class="card-main" id="adminTableWrapper">
        <div class="card-toolbar">
            <h5 style="font-weight:800;font-size:15px;color:#0f172a;margin:0;flex-shrink:0;"><i class="fa fa-clipboard-list text-primary me-2"></i> All Appointments</h5>

            <!-- Live search -->
            <div class="search-w" style="flex:1;">
                <span class="si"><i class="fa fa-search"></i></span>
                <input type="text" id="apptSearch" placeholder="Search client, pet, service, doctor…" style="width:100%;">
            </div>

            <!-- Filter tabs -->
            <div style="display:flex;gap:6px;flex-wrap:wrap;">
                <button class="ftab active" data-filter="all">All <span class="cnt"><?php echo $counts['all']; ?></span></button>
                <button class="ftab" data-filter="Pending">Pending <span class="cnt"><?php echo $counts['Pending']; ?></span></button>
                <button class="ftab" data-filter="Reschedule Requested">Resched Req <span class="cnt" style="background:#7c3aed;color:#fff;"><?php echo $counts['Reschedule Requested']; ?></span></button>
                <button class="ftab" data-filter="Approved">Approved <span class="cnt"><?php echo $counts['Approved']; ?></span></button>
                <button class="ftab" data-filter="Completed">Completed <span class="cnt"><?php echo $counts['Completed']; ?></span></button>
                <button class="ftab" data-filter="No Show">No Show <span class="cnt" style="background:#9f1239;color:#fff;"><?php echo $counts['No Show']; ?></span></button>
                <button class="ftab" data-filter="Cancelled">Cancelled <span class="cnt"><?php echo $counts['Cancelled']; ?></span></button>
            </div>
        </div>

        <div style="overflow-x:auto;">
        <?php if (count($rows) > 0): ?>
        <table class="appt-table" id="apptTable">
            <thead>
                <tr>
                    <th data-sort-method="number" style="cursor:pointer;"># <i class="fa fa-sort ms-1" style="font-size:10px;opacity:.5;"></i></th>
                    <th style="cursor:pointer;">Client / Pet <i class="fa fa-sort ms-1" style="font-size:10px;opacity:.5;"></i></th>
                    <th style="cursor:pointer;">Service <i class="fa fa-sort ms-1" style="font-size:10px;opacity:.5;"></i></th>
                    <th style="cursor:pointer;">Schedule <i class="fa fa-sort ms-1" style="font-size:10px;opacity:.5;"></i></th>
                    <th style="cursor:pointer;">Assigned Doctor <i class="fa fa-sort ms-1" style="font-size:10px;opacity:.5;"></i></th>
                    <th style="cursor:pointer;">Location <i class="fa fa-sort ms-1" style="font-size:10px;opacity:.5;"></i></th>
                    <th style="cursor:pointer;">Status <i class="fa fa-sort ms-1" style="font-size:10px;opacity:.5;"></i></th>
                    <th style="cursor:pointer;">Booked <i class="fa fa-sort ms-1" style="font-size:10px;opacity:.5;"></i></th>
                    <th data-sort-method="none">Action</th>
                </tr>
            </thead>
            <tbody id="apptBody">
            <?php foreach ($rows as $row):
                $status = $row['status'];
                $bsCls = match(true) {
                    $status === 'Pending'              => 'bs-pending',
                    $status === 'Approved'             => 'bs-approved',
                    $status === 'Checked In'           => 'bs-checkin',
                    $status === 'In Progress'          => 'bs-inprogress',
                    $status === 'Completed'            => 'bs-completed',
                    $status === 'No Show'              => 'bs-noshow',
                    $status === 'Reschedule Proposed'  => 'bs-proposed',
                    $status === 'Reschedule Requested' => 'bs-requested',
                    str_contains($status,'Cancel') || str_contains($status,'Reject') => 'bs-cancelled',
                    default => 'bs-default'
                };
                $dot = match(true) {
                    $status === 'Pending'              => '#ea580c',
                    $status === 'Approved'             => '#16a34a',
                    $status === 'Checked In'           => '#0891b2',
                    $status === 'In Progress'          => '#7c3aed',
                    $status === 'Completed'            => '#2563eb',
                    $status === 'No Show'              => '#9f1239',
                    $status === 'Reschedule Proposed'  => '#7e22ce',
                    $status === 'Reschedule Requested' => '#7c3aed',
                    str_contains($status,'Cancel') || str_contains($status,'Reject') => '#be123c',
                    default => '#94a3b8'
                };
                $rowData = htmlspecialchars(json_encode($row, JSON_HEX_TAG|JSON_HEX_QUOT|JSON_HEX_AMP), ENT_QUOTES);
            ?>
            <tr class="appt-row" data-status="<?php echo htmlspecialchars($status); ?>" onclick="openModal(<?php echo $rowData; ?>)">
                <td style="font-size:12px;color:#94a3b8;font-weight:600;">#<?php echo $row['id']; ?></td>
                <td>
                    <?php
                    $appt_pets_html = '';
                    if ($row['_type'] === 'Appointment') {
                        include_once("includes/pet_data_helper.php");
                        $appt_pets = function_exists('getAppointmentPets') ? getAppointmentPets($conn, $row['id']) : [];
                        if (!empty($appt_pets)) {
                            $appt_pets_html = '<div style="display:flex;flex-direction:column;gap:3px;">';
                            foreach (array_slice($appt_pets, 0, 2) as $ap) {
                                $pic = !empty($ap['display_picture']) ? $ap['display_picture'] : null;
                                $appt_pets_html .= '<div style="display:flex;align-items:center;gap:6px;">';
                                if ($pic && file_exists('uploads/pets/' . $pic)) {
                                    $appt_pets_html .= '<img src="uploads/pets/' . htmlspecialchars($pic) . '" style="width:22px;height:22px;border-radius:50%;object-fit:cover;border:1.5px solid #e2e8f0;flex-shrink:0;">';
                                } else {
                                    $init = strtoupper(substr($ap['display_name'], 0, 1));
                                    $appt_pets_html .= '<div style="width:22px;height:22px;border-radius:50%;background:linear-gradient(135deg,#e0f2fe,#bae6fd);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:#2563eb;flex-shrink:0;">' . $init . '</div>';
                                }
                                $appt_pets_html .= '<a href="#" onclick="openQuickPetEmr(\'' . htmlspecialchars(addslashes($ap['display_name'])) . '\', ' . (int)$row['user_id'] . ', event)" class="fw-bold text-decoration-none text-primary" style="font-size:12px;" title="Click for Quick EMR Preview">' . htmlspecialchars($ap['display_name']) . '</a></div>';
                            }
                            if (count($appt_pets) > 2) {
                                $extra = count($appt_pets) - 2;
                                $appt_pets_html .= '<div style="font-size:11px;color:#94a3b8;padding-left:28px;">+' . $extra . ' more</div>';
                            }
                            $appt_pets_html .= '</div>';
                        } else {
                            $appt_pets_html = '<a href="#" onclick="openQuickPetEmr(\'' . htmlspecialchars(addslashes($row['pet_name'])) . '\', ' . (int)$row['user_id'] . ', event)" class="fw-bold text-decoration-none text-primary" style="font-size:12px;" title="Click for Quick EMR Preview"><i class="fa fa-paw me-1"></i>' . htmlspecialchars($row['pet_name']) . '</a>';
                        }
                    } else {
                        $appt_pets_html = '<a href="#" onclick="openQuickPetEmr(\'' . htmlspecialchars(addslashes($row['pet_name'] ?? 'Boarding')) . '\', ' . (int)$row['user_id'] . ', event)" class="fw-bold text-decoration-none text-primary" style="font-size:12px;" title="Click for Quick EMR Preview"><i class="fa fa-paw me-1"></i>' . htmlspecialchars($row['pet_name'] ?? 'Boarding') . '</a>';
                    }
                    ?>
                    <div style="display:flex;align-items:center;gap:10px;">
                        <div class="av" style="background:linear-gradient(135deg,#e0f2fe,#bae6fd);"><i class="fa fa-paw" style="color:#2563eb;"></i></div>
                        <div>
                            <div style="font-weight:700;color:#0f172a;"><?php echo htmlspecialchars($row['client_name']); ?></div>
                            <?php echo $appt_pets_html; ?>
                        </div>
                    </div>
                </td>
                <td style="font-weight:600;color:#334155;max-width:160px;"><?php echo htmlspecialchars($row['service_type']); ?></td>
                <td>
                    <div style="font-weight:600;color:#0f172a;font-size:13px;"><i class="far fa-calendar-alt" style="color:#94a3b8;margin-right:4px;"></i><?php echo date("M d, Y", strtotime($row['appointment_date'])); ?></div>
                    <div style="font-size:12px;color:#64748b;"><i class="far fa-clock" style="margin-right:3px;"></i><?php echo date("h:i A", strtotime($row['appointment_time'])); ?></div>
                    <?php if (($status === 'Reschedule Requested' || $status === 'Reschedule Proposed') && !empty($row['proposed_reschedule_date'])): ?>
                    <div style="margin-top:5px; background:#f5f3ff; color:#7c3aed; padding:3px 8px; border-radius:6px; font-size:10px; font-weight:800; border:1px solid #ddd6fe; display:inline-flex; align-items:center; gap:4px;">
                        <i class="fa fa-exchange-alt"></i> Shift: <?php echo date("M d", strtotime($row['proposed_reschedule_date'])); ?>
                    </div>
                    <?php endif; ?>
                </td>

                <!-- INLINE DOCTOR RE-ASSIGNMENT DROPDOWN -->
                <td onclick="event.stopPropagation();">
                    <?php if ($row['_type'] === 'Appointment'): ?>
                        <form method="POST" class="m-0">
                            <input type="hidden" name="apt_id" value="<?= $row['id'] ?>">
                            <input type="hidden" name="update_doctor_assignment" value="1">
                            <select name="assign_doctor_id" onchange="this.form.submit()" class="form-select form-select-sm border-0 bg-light text-dark fw-bold shadow-sm" style="font-size:12px; border-radius:8px; cursor:pointer; width:auto; max-width:150px; padding: 4px 24px 4px 8px;">
                                <option value="" <?= empty($row['doctor_id']) ? 'selected' : '' ?>>-- Unassigned --</option>
                                <?php foreach ($all_doctors as $doc): ?>
                                    <option value="<?= $doc['id'] ?>" <?= ((int)($row['doctor_id'] ?? 0) === (int)$doc['id']) ? 'selected' : '' ?>>
                                        Dr. <?= htmlspecialchars($doc['fullname']) ?>
                                    </option>
                                <?php endforeach; ?>
                            </select>
                        </form>
                    <?php else: ?>
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-2.5 py-1 fw-bold" style="font-size:11px;">
                            <i class="fa fa-hotel me-1"></i> Clinic (Boarding)
                        </span>
                    <?php endif; ?>
                </td>

                <td>
                    <?php if ($row['service_location'] === 'Home Service'): ?>
                    <span style="background:#e0f2fe;color:#0369a1;padding:3px 8px;border-radius:6px;font-size:11px;font-weight:600;"><i class="fa fa-home me-1"></i>Home</span>
                    <?php else: ?>
                    <span style="background:#f1f5f9;color:#475569;padding:3px 8px;border-radius:6px;font-size:11px;font-weight:600;"><i class="fa fa-hospital me-1"></i>On-Site</span>
                    <?php endif; ?>
                </td>
                <td>
                    <span class="bs <?php echo $bsCls; ?>">
                        <span style="width:7px;height:7px;border-radius:50%;background:<?php echo $dot; ?>;flex-shrink:0;"></span>
                        <?php echo htmlspecialchars($status); ?>
                    </span>
                </td>
                <td style="font-size:12px;color:#94a3b8;"><?php echo date("M d, Y", strtotime($row['created_at'])); ?></td>

                <!-- ACTION COLUMN: EYE ICON ONLY -->
                <td onclick="event.stopPropagation();" class="text-center">
                    <button type="button" class="btn btn-sm rounded-circle" style="width:32px;height:32px;padding:0; background:#2563eb; color:#fff; border:none; box-shadow:0 4px 10px rgba(37,99,235,0.35); transition:transform 0.2s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'" title="View Details" onclick="openModal(<?php echo $rowData; ?>); return false;">
                        <i class="fa fa-eye"></i>
                    </button>
                </td>
            </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
        <div id="noResult" style="display:none;text-align:center;padding:48px;color:#94a3b8;">
            <i class="fa fa-search" style="font-size:36px;display:block;margin-bottom:10px;opacity:.3;"></i>
            No appointments match your search or filter.
        </div>
        <?php else: ?>
        <div style="text-align:center;padding:60px 20px;color:#94a3b8;">
            <i class="fa fa-calendar-times" style="font-size:48px;display:block;margin-bottom:14px;opacity:.3;"></i>
            <div style="font-weight:700;font-size:16px;color:#475569;margin-bottom:6px;">No Appointments Found</div>
            <div style="font-size:13px;">No appointments match the current filter.</div>
        </div>
        <?php endif; ?>
        </div>
    </div>
</div>

<!-- â”€â”€ DETAIL MODAL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
<div class="dmodal-bd" id="detailBd">
    <div class="dmodal">
        <div class="dmodal-hdr">
            <h5 style="font-weight:800;font-size:16px;color:#0f172a;margin:0;display:flex;align-items:center;gap:9px;">
                <span style="width:34px;height:34px;border-radius:9px;background:#eff6ff;display:inline-flex;align-items:center;justify-content:center;color:#2563eb;font-size:14px;"><i class="fa fa-calendar-day"></i></span>
                Appointment Details
            </h5>
            <button class="dmdl-close" onclick="closeModal()">&#x2715;</button>
        </div>
        <div class="dmodal-body">
            <div class="hero-svc">
                <div class="sn" id="dm-svc"></div>
                <div class="sd" id="dm-dt"></div>
            </div>
            <div style="text-align:center;margin-bottom:16px;" id="dm-status-w"></div>
            <div class="info-g">
                <div class="info-i"><label><i class="fa fa-user me-1"></i>Client</label><div class="v" id="dm-client"></div></div>
                <div class="info-i"><label><i class="fa fa-paw me-1"></i>Pet</label><div class="v" id="dm-pet"></div></div>
                <div class="info-i"><label><i class="fa fa-user-md me-1"></i>Doctor</label><div class="v" id="dm-doctor"></div></div>
                <div class="info-i"><label><i class="fa fa-map-marker-alt me-1"></i>Location</label><div class="v" id="dm-loc"></div></div>
                <div class="info-i"><label><i class="fa fa-tag me-1"></i>Booked On</label><div class="v" id="dm-created"></div></div>
                <div class="info-i"><label><i class="fa fa-id-badge me-1"></i>Appt ID</label><div class="v" id="dm-id"></div></div>
                                <div class="info-i full" id="dm-addr-w" style="display:none;"><label><i class="fa fa-home me-1"></i>Home Address</label><div class="v" id="dm-addr" style="font-size:13px;font-weight:500;"></div></div>
                
                <div class="info-i full" id="dm-audit-w" style="display:none; background:#f0f9ff; padding:12px; border-radius:10px; border:1px dashed #bae6fd; margin-top:8px;">
                    <label style="color:#0369a1; font-size:11px; text-transform:uppercase; font-weight:800; margin-bottom:4px;"><i class="fa fa-history me-1"></i> Audit Trail</label>
                    <div class="v" id="dm-audit" style="font-size:13px; font-weight:500; color:#0c4a6e; white-space:pre-wrap;"></div>
                </div>
            </div>

            <!-- Admin actions form -->
            <div id="dm-actions" style="display:none !important;">
                <p style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#94a3b8;margin-bottom:12px;">Administrative Actions</p>
                <form method="POST" id="adminActForm">
                    <input type="hidden" name="apt_id" id="dm-apt-id">
                    <input type="hidden" name="appt_type" id="dm-appt-type">

                    <!-- Approve button (Pending only) -->
                    <div id="dm-approve-w" style="display:none;margin-bottom:15px;">
                        <button type="submit" name="admin_manage_appt" value="approve" class="btn-act g w-100 d-block" onclick="return confirm('Approve this appointment?');">
                            <i class="fa fa-check me-1"></i> Approve Appointment
                        </button>
                        <div style="text-align:center; margin:12px 0; display:flex; align-items:center; gap:10px;">
                            <div style="flex:1; height:1px; background:#f1f5f9;"></div>
                            <span style="font-size:10px; font-weight:800; color:#94a3b8; text-transform:uppercase; letter-spacing:0.1em;">Or propose a shift</span>
                            <div style="flex:1; height:1px; background:#f1f5f9;"></div>
                        </div>
                    </div>

                    <!-- Complete button (Approved only) -->
                    <div id="dm-complete-w" style="display:none;margin-bottom:10px;">
                        <button type="submit" name="admin_manage_appt" value="complete" class="btn-act b w-100 d-block" onclick="return confirm('Mark as Completed?');">
                            <i class="fa fa-star me-1"></i> Mark as Completed
                        </button>
                    </div>

                    <!-- Message field for cancel/reschedule -->
                    <div id="dm-msg-w" class="mb-3">
                        <label style="font-size:11px;font-weight:700;color:#64748b;display:block;margin-bottom:5px;">Message to Client (for Cancel / Reschedule)</label>
                        <textarea name="admin_message" class="form-control" rows="2" placeholder="Explain reason or instructions…" style="border-radius:10px;font-size:13px;font-family:inherit;resize:none;border:1.5px solid #e2e8f0;padding:10px;"></textarea>
                    </div>

                    <!-- Reschedule row -->
                    <div id="dm-resched-w" style="background:#f8fafc; border-radius:12px; padding:12px; margin-bottom:12px; border:1px solid #e2e8f0;">
                        <label style="font-size:11px;font-weight:700;color:#64748b;display:block;margin-bottom:8px;">Propose New Schedule</label>
                        <div class="d-flex gap-2">
                            <input type="text" name="new_date" id="dm-resched-input" class="form-control flatpickr-dt" placeholder="Pick new date &amp; time…" style="border-radius:10px;font-size:13px;flex:1;border:1.5px solid #e2e8f0;padding:10px;">
                            <button type="submit" name="admin_manage_appt" value="reschedule" class="btn-act o" onclick="return confirm('Send reschedule proposal to client?');">
                                <i class="fa fa-calendar-check me-1"></i> Propose
                            </button>
                        </div>
                    </div>

                    <button type="submit" name="admin_manage_appt" value="cancel" class="btn-act r w-100 d-block" onclick="return confirm('Permanently cancel this appointment?');">
                        <i class="fa fa-times-circle me-1"></i> Cancel / Reject
                    </button>
                </form>
            </div>
        </div>
        <div class="dmodal-foot d-flex gap-2 justify-content-end">
            <button class="btn-act gray" onclick="closeModal()">Close</button>
            
        </div>
    </div>
</div>

<!-- â”€â”€ BOOK APPOINTMENT MODAL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
<!-- ------------------------------------------------------ -->
<div id="bookApptModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.55);z-index:99999;align-items:center;justify-content:center;padding:16px;">
    <div style="background:#fff;border-radius:20px;width:100%;max-width:600px;max-height:90vh;overflow-y:auto;box-shadow:0 24px 64px rgba(0,0,0,.2);">
        <div style="padding:22px 28px;border-bottom:1px solid #f1f5f9;display:flex;justify-content:space-between;align-items:center;background:linear-gradient(135deg,#0f172a,#2563eb);border-radius:20px 20px 0 0;">
            <div>
                <h5 style="color:#fff;font-weight:800;margin:0;"><i class="fa fa-calendar-plus me-2"></i>Book Appointment</h5>
                <p style="color:rgba(255,255,255,.7);font-size:12px;margin:2px 0 0;">Walk-in — auto-approved immediately</p>
            </div>
            <button onclick="document.getElementById('bookApptModal').style.display='none'" style="background:rgba(255,255,255,.15);border:none;color:#fff;width:32px;height:32px;border-radius:50%;cursor:pointer;font-size:16px;">&times;</button>
        </div>
        <div style="padding:24px 28px;">
            <form method="POST">

                <!-- Owner Search -->
                <div style="margin-bottom:16px;">
                    <label style="font-size:11px;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;display:block;margin-bottom:6px;"><i class="fa fa-search me-1"></i>Search Pet Owner</label>
                    <input type="text" id="ownerSearch" placeholder="Type owner name…" oninput="filterOwners()" autocomplete="off"
                        style="width:100%;padding:11px 14px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:14px;font-family:inherit;outline:none;">
                    <div id="ownerDropdown" style="display:none;border:1.5px solid #e2e8f0;border-radius:10px;margin-top:4px;max-height:200px;overflow-y:auto;background:#fff;box-shadow:0 8px 24px rgba(0,0,0,.08);">
                        <?php foreach ($owners_map as $uid => $owner): ?>
                        <div class="owner-opt" data-uid="<?= $uid ?>" data-name="<?= htmlspecialchars($owner['fullname']) ?>" data-pets="<?= htmlspecialchars(json_encode($owner['pets']), ENT_QUOTES) ?>"
                            onclick="selectOwner(this)"
                            style="padding:10px 14px;cursor:pointer;font-size:13px;font-weight:600;border-bottom:1px solid #f1f5f9;">
                            <i class="fa fa-user me-2 text-primary"></i><?= htmlspecialchars($owner['fullname']) ?>
                            <span style="color:#94a3b8;font-weight:400;"> &middot; <?= count($owner['pets']) ?> pet(s)</span>
                        </div>
                        <?php endforeach; ?>
                    </div>
                    <input type="hidden" name="walkin_user_id" id="walkin_user_id" required>
                </div>

                <!-- Pet -->
                <div style="margin-bottom:16px;">
                    <label style="font-size:11px;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;display:block;margin-bottom:6px;"><i class="fa fa-paw me-1"></i>Pet</label>
