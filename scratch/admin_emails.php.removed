    <script>
        setTimeout(function () {
            let alerts = document.querySelectorAll('.alert-container');
            alerts.forEach(a => {
                a.style.transition = 'opacity 0.5s ease-out, transform 0.5s ease-out';
                a.style.opacity = '0';
                a.style.transform = 'translateY(-20px)';
                setTimeout(() => a.remove(), 500);
            });
        }, 2000);
