<?php
session_start();
include("dbconnection.php");
include_once("includes/rbac_guard.php");

use PHPMailer\PHPMailer\PHPMailer;
use PHPMailer\PHPMailer\Exception;
require 'PHPMailer/src/Exception.php';
require 'PHPMailer/src/PHPMailer.php';
require 'PHPMailer/src/SMTP.php';

// RBAC Access Guard
$user_role = rbac_get_role();
if (!isset($_SESSION['user_id']) || !in_array($user_role, ['admin', 'clinic_owner', 'owner'])) {
    header("Location: " . rbac_home_url($user_role));
    exit();
}

$users_q = $conn->query("SELECT id, fullname, email FROM users WHERE role='user' ORDER BY fullname ASC");

// Handle Form Submission
if (isset($_POST['send_email'])) {
    $target = $_POST['target_user'];
    $subject = trim($_POST['subject']);
    $raw_msg = $_POST['message']; // allow html but secure it
    $formatted_msg = nl2br(htmlspecialchars($raw_msg));

    $mail = new PHPMailer(true);
    try {
        $mail->isSMTP();
        $mail->Host = 'smtp.gmail.com';
        $mail->SMTPAuth = true;
        $mail->Username = 'timferrer1@gmail.com';
        $mail->Password = 'azrpmoxxzvhucetu';
        $mail->SMTPSecure = PHPMailer::ENCRYPTION_STARTTLS;
        $mail->Port = 587;

        $mail->setFrom('timferrer1@gmail.com', 'PragmaVet Hub');
        $mail->isHTML(true);
        $mail->Subject = $subject;

        $mail->Body = '
            <!DOCTYPE html>
            <html lang="en">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
            </head>
            <body style="margin: 0; padding: 0; background-color: #E6EEF8; -webkit-font-smoothing: antialiased;">
                <center class="wrapper" style="width: 100%; table-layout: fixed; background-color: #E6EEF8; padding-bottom: 40px;">
                    <div style="padding: 40px 0;">
                        <table class="main" width="100%" style="background-color: #ffffff; margin: 0 auto; width: 100%; max-width: 600px; border-spacing: 0; font-family: Inter, Helvetica, Arial, sans-serif; color: #334155; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border: 1px solid #E2E8F0;">
                            
                            <!-- HEADER -->
                            <tr>
                                <td class="header-td" style="background-color: #2563eb; padding: 30px 40px; text-align: center;">
                                    <h1 style="color: #ffffff; margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -0.5px;">PragmaVet Animal Clinic &ndash; Imus Branch</h1>
                                </td>
                            </tr>

                            <!-- BODY -->
                            <tr>
                                <td class="body-td" style="padding: 40px;">
                                    
                                    <p style="font-size: 16px; color: #1E293B; font-weight: 600; margin: 0 0 24px 0;">Dear Valued Client,</p>
                                    
                                    <div style="font-size: 15px; color: #334155; line-height: 1.6; margin-bottom: 32px;">
                                        ' . $formatted_msg . '
                                    </div>
                                    

                                    <!-- CONTACT SECTION -->
                                    <div style="border-top: 1px solid #E2E8F0; padding-top: 24px;">
                                        <p style="margin: 0 0 12px 0; font-size: 14px; color: #475569;">📍 <strong style="color: #0F172A; margin-left: 6px;">Address:</strong> Imus, Cavite, Philippines</p>
                                        <p style="margin: 0 0 12px 0; font-size: 14px; color: #475569;">📞 <strong style="color: #0F172A; margin-left: 6px;">Landline:</strong> <a href="tel:+63461234567" style="color: #3b82f6; text-decoration: none; font-weight: 600; margin-left: 4px;">(046) 123-4567</a></p>
                                        <p style="margin: 0; font-size: 14px; color: #475569;">📱 <strong style="color: #0F172A; margin-left: 6px;">Mobile:</strong> <a href="tel:+639171234567" style="color: #3b82f6; text-decoration: none; font-weight: 600; margin-left: 4px;">0917-123-4567</a></p>
                                    </div>

                                </td>
                            </tr>
                        </table>

                        <!-- FOOTER -->
                        <table width="100%" style="max-width: 600px; margin: 0 auto;">
                            <tr>
                                <td style="text-align: center; padding: 30px 20px;">
                                    <h3 style="font-size: 12px; font-weight: 700; color: #64748B; text-transform: uppercase; letter-spacing: 0.8px; margin: 0 0 8px 0;">About PragmaVet</h3>
                                    <p style="color: #64748B; font-size: 13px; font-family: Inter, Helvetica, sans-serif; line-height: 1.5; margin: 0 0 24px 0;">We provide compassionate, state-of-the-art veterinary care. Your pet\'s health and happiness are our top priority.</p>
                                    <p style="color: #64748B; font-size: 13px; font-family: Inter, Helvetica, sans-serif; margin: 0 0 8px 0;">Thank you for trusting PragmaVet with your pet\'s healthcare needs.</p>
                                    <p style="color: #94A3B8; font-size: 11px; font-family: Inter, Helvetica, sans-serif; margin: 0;">This is an official automated communication. Please do not reply directly to this address.</p>
                                </td>
                            </tr>
                        </table>
                    </div>
                </center>
                <script src="mousetrail.js"></script>
            </body>
            </html>
        ';

        if ($target === 'ALL') {
            // Mass broadcast via BCC
            $all_u = $conn->query("SELECT id, email FROM users WHERE role='user'");
            $stmt_notif = $conn->prepare("INSERT INTO notifications(user_id, message) VALUES(?, ?)");
            $notif_msg = "You received a secure message from PragmaVet Clinic: " . htmlspecialchars($subject);
            while ($u = $all_u->fetch_assoc()) {
                $mail->addBCC($u['email']);
                // Also notify dashboard
                $stmt_notif->bind_param("is", $u['id'], $notif_msg);
                $stmt_notif->execute();
            }
            $_SESSION['message'] = "Mass Broadcast successfully dispatched to all clients.";
        } else {
            // Unicast
            $u_q = $conn->query("SELECT id, email, fullname FROM users WHERE id=" . intval($target));
            if ($u_q && $u_q->num_rows > 0) {
                $u = $u_q->fetch_assoc();
                $mail->addAddress($u['email'], $u['fullname']);

                // Also notify dashboard
                $uid = $u['id'];
                $notif_msg = "You received a secure message from PragmaVet Clinic: " . htmlspecialchars($subject);
                $ins_n = $conn->prepare("INSERT INTO notifications(user_id, message) VALUES(?, ?)");
                $ins_n->bind_param("is", $uid, $notif_msg);
                $ins_n->execute();

                $_SESSION['message'] = "Email successfully dispatched to " . htmlspecialchars($u['fullname']) . ".";
            } else {
                throw new Exception("Target validation error.");
            }
        }

        $mail->send();
        $_SESSION['msg_type'] = "success";

    } catch (Exception $e) {
        $_SESSION['message'] = "Mailer Error: " . $mail->ErrorInfo;
        $_SESSION['msg_type'] = "danger";
    }

    header("Location: admin_emails.php");
    exit();
}
