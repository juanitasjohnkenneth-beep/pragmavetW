    <?php
session_start();
include("dbconnection.php");

if (!isset($_SESSION['user_id'])) {
    header("Location: index.php");
    exit();
}

$user_id = $_SESSION['user_id'];
$user_name = $_SESSION['user'];

// Include pet data helper for multi-pet and profile sync
include_once("includes/pet_data_helper.php");


// â”€â”€ Check for unrated completed appointment for auto-popup â”€â”€
$pending_feedback = $conn->query("
    SELECT id, pet_name, service_type FROM appointments 
    WHERE user_id=$user_id AND status='Completed' AND id NOT IN (SELECT appointment_id FROM feedbacks)
    ORDER BY appointment_date DESC LIMIT 1
")->fetch_assoc();
if (!$pending_feedback) {
    // Check boarding too
    $pending_feedback = $conn->query("
        SELECT id, pet_name, service_type FROM boarding_reservations 
        WHERE user_id=$user_id AND status='Completed' AND id NOT IN (SELECT appointment_id FROM feedbacks)
        ORDER BY appointment_date DESC LIMIT 1
    ")->fetch_assoc();
}

// â”€â”€ Fetch pets for booking form â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Also fetch pets with IDs and pictures for multi-pet selection
$stmt_pets = $conn->prepare("SELECT id, name, species, pet_picture FROM pets WHERE user_id=? ORDER BY name ASC");
$stmt_pets->bind_param("i", $user_id);
$stmt_pets->execute();
$pets_result = $stmt_pets->get_result();

// â”€â”€ Fetch doctors â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
$doctors = [];
$r = $conn->query("SELECT id, fullname FROM users WHERE role='doctor' ORDER BY fullname ASC");
if ($r)
    while ($d = $r->fetch_assoc())
        $doctors[] = $d;

// â”€â”€ Doctor leave dates (for client-side validation) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
$unavailability = [];
$now = date('Y-m-d');
$ru = $conn->query("SELECT doctor_id, unavailable_date FROM doctor_unavailability WHERE unavailable_date >= '$now'");
if ($ru)
    while ($u = $ru->fetch_assoc()) {
        $unavailability[$u['doctor_id']][] = $u['unavailable_date'];
    }
$doctorLeavesJSON = json_encode($unavailability);

// â”€â”€ POST: Book appointment â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
if (isset($_POST['book'])) {
    $pet = $_POST['pet_name'];
    $service = $_POST['service_type'];
    $date = $_POST['appointment_date'];
    $time = $_POST['appointment_time'];
    $location = $_POST['service_location'];
    $address = empty($_POST['home_address']) ? NULL : trim($_POST['home_address']);
    $end_date = empty($_POST['end_date']) ? NULL : $_POST['end_date'];
    $doctor_id = empty($_POST['doctor_id']) ? NULL : (int) $_POST['doctor_id'];
    $signature_data = empty($_POST['signature_data']) ? NULL : $_POST['signature_data'];

    // â”€â”€â”€ SMART SCHEDULING VALIDATION â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    
    // 1. Validate date is not in the past or same day
    $today = date('Y-m-d');
    $tomorrow = date('Y-m-d', strtotime('+1 day'));
    if ($date < $tomorrow) {
        $_SESSION['message'] = "âŒ Appointments must be booked at least 24 hours in advance. Earliest available: $tomorrow";
        $_SESSION['msg_type'] = "danger";
        header("Location: appointments.php");
        exit();
    }

    // 2. Get service duration from service_durations table
    $duration_minutes = 30;
    $stmt_duration = $conn->prepare("SELECT duration_minutes FROM service_durations WHERE service_type = ?");
    if ($stmt_duration) {
        $stmt_duration->bind_param("s", $service);
        $stmt_duration->execute();
        $service_result = $stmt_duration->get_result();
        $service_duration = $service_result ? $service_result->fetch_assoc() : null;
        $duration_minutes = $service_duration ? $service_duration['duration_minutes'] : 30;
    } else {
        error_log('appointments.php: failed to prepare service duration query - ' . $conn->error);
    }

    // Calculate appointment end time
    $appointment_end_time = date('H:i:s', strtotime($time . ' +' . $duration_minutes . ' minutes'));

    // 3. If doctor specified, validate against smart scheduling rules
    if (!empty($doctor_id)) {
        // 3a. Check if doctor is on leave
        $chk = $conn->prepare("SELECT id FROM doctor_unavailability WHERE doctor_id=? AND unavailable_date=?");
        if (!$chk) {
            error_log('appointments.php: prepare failed on doctor_unavailability - ' . $conn->error);
            $_SESSION['message'] = "âŒ Database error. Please try again.";
            $_SESSION['msg_type'] = "danger";
            header("Location: appointments.php");
            exit();
        }
        $chk->bind_param("is", $doctor_id, $date);
        $chk->execute();
        if ($chk->get_result()->num_rows > 0) {
            $_SESSION['message'] = "âŒ The selected doctor is not available on this date (on leave). Please choose another date or doctor.";
            $_SESSION['msg_type'] = "danger";
            header("Location: appointments.php");
            exit();
        }
        
        // 3b. Get doctor's working hours and settings
        $doc_stmt = $conn->prepare("SELECT fullname FROM users WHERE id = ? AND role = 'doctor'");
        if (!$doc_stmt) {
            error_log('appointments.php: prepare failed on users lookup - ' . $conn->error);
            $_SESSION['message'] = "âŒ Database error. Please try again.";
            $_SESSION['msg_type'] = "danger";
            header("Location: appointments.php");
            exit();
        }
        $doc_stmt->bind_param("i", $doctor_id);
        $doc_stmt->execute();
        $doc_result = $doc_stmt->get_result();
        if ($doc_result->num_rows === 0) {
            $_SESSION['message'] = "âŒ Doctor not found. Please try again.";
            $_SESSION['msg_type'] = "danger";
            header("Location: appointments.php");
            exit();
        }
        
        $doctor_info = $doc_result->fetch_assoc();
        $doc_start_time = '08:00:00';
        $doc_end_time = '17:00:00';
        $buffer_mins = 15;
        $max_appts = 10;
        
        // 3c. Validate time is within working hours
        $slot_time = strtotime($time);
        $slot_end = strtotime($appointment_end_time);
        $working_start = strtotime($doc_start_time);
        $working_end = strtotime($doc_end_time);
        
        if ($slot_time < $working_start || $slot_end > $working_end) {
            $_SESSION['message'] = "âŒ Requested time is outside doctor's working hours (" . substr($doc_start_time, 0, 5) . " - " . substr($doc_end_time, 0, 5) . ").";
            $_SESSION['msg_type'] = "danger";
            header("Location: appointments.php");
            exit();
        }
        
        // 3d. Check for slot conflicts with existing appointments (prevent double-booking)
        $conflict_stmt = $conn->prepare("
            SELECT id, appointment_time, service_type 
            FROM appointments 
            WHERE doctor_id = ? AND appointment_date = ? AND status IN ('Pending', 'Approved')
        ");
        if (!$conflict_stmt) {
            error_log('appointments.php: prepare failed on conflict check - ' . $conn->error);
            $_SESSION['message'] = "âŒ Database error. Please try again.";
            $_SESSION['msg_type'] = "danger";
            header("Location: appointments.php");
            exit();
        }
        $conflict_stmt->bind_param("is", $doctor_id, $date);
        $conflict_stmt->execute();
        $conflict_result = $conflict_stmt->get_result();
        
        while ($existing = $conflict_result->fetch_assoc()) {
            $existing_start = strtotime($existing['appointment_time']);
            $existing_duration = 30;
            $stmt_duration_existing = $conn->prepare("SELECT duration_minutes FROM service_durations WHERE service_type = ?");
            if ($stmt_duration_existing) {
                $stmt_duration_existing->bind_param("s", $existing['service_type']);
                $stmt_duration_existing->execute();
                $existing_result = $stmt_duration_existing->get_result();
                $existing_service = $existing_result ? $existing_result->fetch_assoc() : null;
                $existing_duration = $existing_service ? $existing_service['duration_minutes'] : 30;
            }
            $existing_end = $existing_start + ($existing_duration * 60);
            
            // Add buffer on both sides
            $buffer_seconds = $buffer_mins * 60;
            $check_start = $existing_start - $buffer_seconds;
            $check_end = $existing_end + $buffer_seconds;
            
            // Check if proposed slot overlaps with existing appointment + buffer
            if (!($slot_end <= $check_start || $slot_time >= $check_end)) {
                $next_available = date('H:i', $existing_end + $buffer_seconds);
                $_SESSION['message'] = "âŒ This time slot is taken or too close to another appointment. Try " . $next_available . " or later.";
                $_SESSION['msg_type'] = "danger";
                header("Location: appointments.php");
                exit();
            }
        }
        
        // 3e. Check doctor capacity for the day
        $capacity_stmt = $conn->prepare("
            SELECT COUNT(*) as count FROM appointments 
            WHERE doctor_id = ? AND appointment_date = ? AND status IN ('Pending', 'Approved')
        ");
        if (!$capacity_stmt) {
            error_log('appointments.php: prepare failed on capacity check - ' . $conn->error);
            $_SESSION['message'] = "âŒ Database error. Please try again.";
            $_SESSION['msg_type'] = "danger";
            header("Location: appointments.php");
            exit();
        }
        $capacity_stmt->bind_param("is", $doctor_id, $date);
        $capacity_stmt->execute();
        $capacity_result = $capacity_stmt->get_result()->fetch_assoc();
        $current_count = $capacity_result['count'];
        
        if ($current_count >= $max_appts) {
            $_SESSION['message'] = "âŒ Dr. " . htmlspecialchars($doctors[array_search($doctor_id, array_column($doctors, 'id'))]['fullname'] ?? 'Unknown') . " is fully booked on this date. Please try another date or doctor.";
            $_SESSION['msg_type'] = "danger";
            header("Location: appointments.php");
            exit();
        }
    }
    
    // Handle multi-pet support: parse pet_name as JSON or comma-separated
    $pet_names_arr = [];
    $pet_ids_arr = [];
    
    // Check if pet_name contains JSON array (from multi-pet selection)
    $first_char = substr($pet, 0, 1);
    if ($first_char === '[' || $first_char === '{') {
        $pet_data = json_decode($pet, true);
        if (is_array($pet_data)) {
            foreach ($pet_data as $p) {
                $pet_names_arr[] = $p['name'] ?? $p;
                $pet_ids_arr[] = $p['id'] ?? null;
            }
        }
    } else {
        // Single pet (backward compat)
        $pet_names_arr[] = $pet;
        $pet_ids_arr[] = null;
    }
    
    // Generate display name (comma-separated for multi-pet)
    $display_name = implode(', ', $pet_names_arr);
    $is_multi = count($pet_names_arr) > 1 ? 1 : 0;
    
    // All smart scheduling validations passed - proceed with booking
    $stmt = $conn->prepare("INSERT INTO appointments(user_id, pet_name, service_type, appointment_date, appointment_time, service_location, home_address, end_date, doctor_id, signature_data, is_multi_pet) VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)");
    if (!$stmt) {
        $_SESSION['message'] = "âŒ Error preparing booking: " . htmlspecialchars($conn->error);
        $_SESSION['msg_type'] = "danger";
        error_log('appointments.php: prepare failed - ' . $conn->error);
        header("Location: appointments.php");
        exit();
    }
    $stmt->bind_param("isssssssssi", $user_id, $display_name, $service, $date, $time, $location, $address, $end_date, $doctor_id, $signature_data, $is_multi);
    if ($stmt->execute()) {
        $appointment_id = $stmt->insert_id;
        
        // Insert into appointment_pets junction table
        if (function_exists('insertAppointmentPets') && !empty($pet_names_arr)) {
            insertAppointmentPets($conn, $appointment_id, $user_id, $pet_ids_arr, $pet_names_arr);
        }
        
        $msg_pet = htmlspecialchars($display_name);
        $_SESSION['message'] = "âœ… Appointment for <b>$msg_pet</b> booked successfully! We look forward to seeing you.";
        $_SESSION['msg_type'] = "success";
    } else {
        if (strpos($conn->error, 'Duplicate entry') !== false || strpos($conn->error, 'unique') !== false) {
            $_SESSION['message'] = "âŒ This time slot was just taken. Please refresh and choose another time.";
        } else {
            $_SESSION['message'] = "âŒ Error booking appointment: " . htmlspecialchars($conn->error);
        }
        $_SESSION['msg_type'] = "danger";
    }
    header("Location: appointments.php");
    exit();
}

// â”€â”€ POST: Cancel pending â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
if (isset($_POST['cancel_appt'])) {
    $cid = (int) $_POST['cancel_appt_id'];
    $type = $_POST['appt_type'] ?? 'Appointment';

    if ($type === 'Boarding') {
        $stmt = $conn->prepare("UPDATE boarding_reservations SET status='Cancelled' WHERE id=? AND user_id=? AND status='Pending'");
    } else {
        $stmt = $conn->prepare("UPDATE appointments SET status='Cancelled' WHERE id=? AND user_id=? AND status='Pending'");
    }

    $stmt->bind_param("ii", $cid, $user_id);
    if ($stmt->execute() && $stmt->affected_rows > 0) {
        $_SESSION['message'] = "Request cancelled successfully.";
        $_SESSION['msg_type'] = "success";
    } else {
        $_SESSION['message'] = "Could not cancel â€” request may have already been processed.";
        $_SESSION['msg_type'] = "danger";
    }
    header("Location: appointments.php");
    exit();
}

// â”€â”€ POST: Accept reschedule â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
if (isset($_POST['accept_reschedule'])) {
    $aid = (int) $_POST['reschedule_apt_id'];
    $type = $_POST['appt_type'] ?? 'Appointment';

    if ($type === 'Boarding') {
        $stmt = $conn->prepare("UPDATE boarding_reservations SET appointment_date=proposed_reschedule_date, end_date=proposed_reschedule_end_date, status='Approved', client_action_needed=0 WHERE id=? AND user_id=?");
        $msg_suffix = 'boarding reservation';
    } else {
        $stmt = $conn->prepare("UPDATE appointments SET appointment_date=proposed_reschedule_date, appointment_time=proposed_reschedule_time, status='Approved', client_action_needed=0 WHERE id=? AND user_id=?");
        $msg_suffix = 'appointment';
    }

    $stmt->bind_param("ii", $aid, $user_id);
    if ($stmt->execute()) {
        $_SESSION['message'] = "Reschedule accepted. Your $msg_suffix is now Approved for the new date.";
        $_SESSION['msg_type'] = "success";
        $conn->query("INSERT INTO notifications(user_id,message) VALUES(1,'Client accepted reschedule for $msg_suffix ID {$aid}')");
    }
    header("Location: appointments.php");
    exit();
}

// â”€â”€ POST: Decline reschedule â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
if (isset($_POST['decline_reschedule'])) {
    $aid = (int) $_POST['reschedule_apt_id'];
    $type = $_POST['appt_type'] ?? 'Appointment';

    if ($type === 'Boarding') {
        $stmt = $conn->prepare("UPDATE boarding_reservations SET status='Cancelled', client_action_needed=0 WHERE id=? AND user_id=?");
        $msg_suffix = 'boarding reservation';
    } else {
        $stmt = $conn->prepare("UPDATE appointments SET status='Cancelled', client_action_needed=0 WHERE id=? AND user_id=?");
        $msg_suffix = 'appointment';
    }

    $stmt->bind_param("ii", $aid, $user_id);
    if ($stmt->execute()) {
        $_SESSION['message'] = "Reschedule declined. Request has been cancelled.";
        $_SESSION['msg_type'] = "danger";
        $conn->query("INSERT INTO notifications(user_id,message) VALUES(1,'Client DECLINED reschedule for $msg_suffix ID {$aid}.')");
    }
    header("Location: appointments.php");
    exit();
    // â”€â”€ POST: Request reschedule (Client side) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
    if (isset($_POST['request_reschedule'])) {
        $aid = (int) $_POST['reschedule_apt_id'];
        $type = $_POST['appt_type'] ?? 'Appointment';
        $new_date = $_POST['new_proposed_date'];
        $new_time = $_POST['new_proposed_time'] ?? '08:00';
        $reason = trim($_POST['reschedule_reason'] ?? '');

        $table = $type === 'Boarding' ? 'boarding_reservations' : 'appointments';

        $stmt = $conn->prepare("UPDATE $table SET status='Reschedule Requested', proposed_reschedule_date=?, proposed_reschedule_time=?, admin_message=? WHERE id=? AND user_id=? AND (status='Approved' OR status='Pending')");
        $stmt->bind_param("sssii", $new_date, $new_time, $reason, $aid, $user_id);

        if ($stmt->execute() && $stmt->affected_rows > 0) {
            $_SESSION['message'] = "Reschedule request sent to clinic for review.";
            $_SESSION['msg_type'] = "success";
            $notif = "Client $user_name requested reschedule for $type ID $aid to $new_date.";
            $conn->query("INSERT INTO notifications(user_id,message) VALUES(1,'" . addslashes($notif) . "')");
        } else {
            $_SESSION['message'] = "Could not submit request. Please try again.";
            $_SESSION['msg_type'] = "danger";
        }
        header("Location: appointments.php");
        exit();
    }
}

// â”€â”€ Helper: get pet display data with profile sync â”€â”€
function enrichAppointmentPetData($conn, $row) {
    // Sync pet profile data from appointment_pets
    if (function_exists('syncAppointmentPetData')) {
        syncAppointmentPetData($conn, $row['id']);
    }
    // Get pets from junction table
    if (function_exists('getAppointmentPets')) {
        $pets = getAppointmentPets($conn, $row['id']);
        if (!empty($pets)) {
            $names = array_column($pets, 'display_name');
            $row['pet_name'] = implode(', ', $names);
            // Use first pet's picture
            if (!empty($pets[0]['display_picture'])) {
                $row['pet_picture'] = $pets[0]['display_picture'];
            }
        }
    }
    return $row;
}

// â”€â”€ Fetch ALL appointments (past + future) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
$stmt = $conn->prepare("SELECT a.*, IFNULL(d.fullname,'Clinic') as doctor_name FROM appointments a LEFT JOIN users d ON a.doctor_id=d.id WHERE a.user_id=? ORDER BY a.appointment_date DESC, a.appointment_time DESC");
$stmt->bind_param("i", $user_id);
$stmt->execute();
$appointments = $stmt->get_result();
$apptRows = [];
while ($row = $appointments->fetch_assoc()) {
    $row['_type'] = 'Appointment';
    $row = enrichAppointmentPetData($conn, $row);
    $apptRows[] = $row;
}

// â”€â”€ Fetch ALL boarding reservations (past + future) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
$stmt_b = $conn->prepare("SELECT * FROM boarding_reservations WHERE user_id=? ORDER BY appointment_date DESC");
$stmt_b->bind_param("i", $user_id);
$stmt_b->execute();
$boardings = $stmt_b->get_result();
while ($row = $boardings->fetch_assoc()) {
    $row['_type'] = 'Boarding';
    $row['doctor_name'] = 'Clinic (Boarding)';
    $row['service_type'] = 'Pet Boarding (Cage ' . str_pad($row['cage_number'] ?? '?', 2, '0', STR_PAD_LEFT) . ')';
    $row['service_location'] = 'On-Site';
    $row['appointment_time'] = $row['appointment_time'] ?? '12:00:00';
    $apptRows[] = $row;
}

// Sort the combined array by date and time
usort($apptRows, function ($a, $b) {
    $dateA = strtotime($a['appointment_date'] . ' ' . $a['appointment_time']);
    $dateB = strtotime($b['appointment_date'] . ' ' . $b['appointment_time']);
    return $dateB - $dateA; // DESC
});

// â”€â”€ Filter for active reschedule proposals â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
$rescheduleProposals = array_filter($apptRows, function ($r) {
    return isset($r['client_action_needed']) && $r['client_action_needed'] == 1 &&
        !str_contains($r['status'], 'Cancel') && !str_contains($r['status'], 'Reject');
});

// â”€â”€ Fetch user address â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
$uStmt = $conn->prepare("SELECT address FROM users WHERE id=?");
$uStmt->bind_param("i", $user_id);
$uStmt->execute();
$myAddr = $uStmt->get_result()->fetch_assoc()['address'] ?? '';
?>
<!DOCTYPE html>
<html lang="en">

<head>
    <title>Appointments | PragmaVet</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://unpkg.com/mobile-select@1.1.2/dist/mobile-select.css">
    <style>
        .flatpickr-calendar {
            border-radius: 14px !important;
            box-shadow: 0 12px 40px rgba(0, 0, 0, .14) !important;
            font-family: 'Inter', sans-serif !important;
            border: 1px solid #e2e8f0 !important;
        }

        .flatpickr-day.selected,
        .flatpickr-day.selected:hover {
            background: #1E5AA8 !important;
            border-color: #1E5AA8 !important;
        }

        .flatpickr-time input {
            font-family: 'Inter', sans-serif !important;
        }

        .numInputWrapper:hover {
            background: none !important;
        }

        .sidebar::-webkit-scrollbar {
            width: 5px;
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: transparent;
        }
    </style>
    <style>
        :root {
            --primary: #1E5AA8;
            --secondary: #4A7FC4;
            --dark: #15407A;
            --light-bg: #F0F4F8;
            --sidebar-width: 260px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: var(--light-bg);
            font-family: 'Inter', sans-serif;
            color: #333;
            overflow-x: hidden;
            margin: 0;
        }

        /* â”€â”€ SIDEBAR â”€â”€ */
        .sidebar {
            background: #0f172a;
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            padding: 24px 16px;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            box-shadow: 5px 0 20px rgba(0, 0, 0, .2);
            overflow-y: auto;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 6px;
        }

        .sidebar-brand-icon {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #4A7FC4, #1E5AA8);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sidebar-brand span {
            font-weight: 800;
            font-size: 20px;
            color: #fff;
        }

        .sidebar-user {
            background: rgba(255, 255, 255, .06);
            border-radius: 12px;
            padding: 12px 14px;
            margin: 16px 0 24px;
        }

        .sidebar-user .welcome {
            font-size: 11px;
            color: rgba(255, 255, 255, .45);
            margin-bottom: 2px;
        }

        .sidebar-user .uname {
            font-weight: 700;
            font-size: 15px;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            border-radius: 8px;
            color: #94a3b8;
            text-decoration: none;
            margin-bottom: 4px;
            font-weight: 600;
            font-size: 15px;
            transition: .2s;
        }

        .sidebar a i {
            width: 20px;
            text-align: center;
            font-size: 15px;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background: #2563eb;
            color: #ffffff;
        }

        .sidebar-logout {
            margin-top: auto;
        }

        .sidebar-logout a {
            color: #ff7070 !important;
        }

        .sidebar-logout a:hover {
            background: rgba(255, 112, 112, .12) !important;
            box-shadow: none !important;
        }

        /* â”€â”€ MAIN â”€â”€ */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 36px 44px;
            min-height: 100vh;
        }

        .page-title {
            font-weight: 800;
            font-size: 26px;
            color: var(--dark);
            margin: 0;
            letter-spacing: -.5px;
        }

        .page-sub {
            color: #94a3b8;
            font-size: 14px;
            margin: 2px 0 0;
        }

        /* â”€â”€ CARDS â”€â”€ */
        .card-prem {
            background: #fff;
            border: none;
            border-radius: 20px;
            box-shadow: 0 4px 24px rgba(0, 0, 0, .05);
        }

        .card-head {
            padding: 22px 28px 16px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .card-head h5 {
            font-weight: 800;
            font-size: 16px;
            color: var(--dark);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .card-body-p {
            padding: 24px 28px;
        }

        /* â”€â”€ SEARCH â”€â”€ */
        .search-wrap {
            position: relative;
            flex: 1;
            min-width: 180px;
        }

        .search-wrap input {
            width: 100%;
            padding: 9px 14px 9px 38px;
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            background: #E6EEF8;
            font-size: 13px;
            font-family: inherit;
            transition: .2s;
            outline: none;
        }

        .search-wrap input:focus {
            border-color: var(--secondary);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(74, 127, 196, .15);
        }

        .search-wrap .si {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 13px;
            pointer-events: none;
        }

        /* â”€â”€ TABLE â”€â”€ */
        .appt-table {
            width: 100%;
            border-collapse: collapse;
        }

        .appt-table thead th {
            padding: 10px 14px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #94a3b8;
            border-bottom: 1.5px solid #f1f5f9;
            white-space: nowrap;
        }

        .appt-table tbody tr {
            cursor: pointer;
            transition: background .12s;
        }

        .appt-table tbody tr:hover {
            background: #E6EEF8;
        }

        .appt-table tbody td {
            padding: 15px 14px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
            font-size: 14px;
        }

        .appt-table tbody tr:last-child td {
            border-bottom: none;
        }

        /* â”€â”€ PET AVATAR â”€â”€ */
        .pet-avatar {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, #e0f2fe, #bae6fd);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: var(--secondary);
            flex-shrink: 0;
        }

        /* â”€â”€ STATUS BADGES â”€â”€ */
        .badge-s {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            border: 1.5px solid transparent;
        }

        .badge-pending {
            background: #fff7ed;
            color: #ea580c;
            border-color: #fed7aa;
        }

        .badge-approved {
            background: #f0fdf4;
            color: #16a34a;
            border-color: #bbf7d0;
        }

        .badge-completed {
            background: #eff6ff;
            color: #2563eb;
            border-color: #bfdbfe;
        }

        .badge-cancelled {
            background: #fff1f2;
            color: #e11d48;
            border-color: #fecdd3;
        }

        .badge-default {
            background: #E6EEF8;
            color: #64748b;
            border-color: #e2e8f0;
        }

        .badge-proposed {
            background: #f5f3ff;
            color: #7e22ce;
            border-color: #ddd6fe;
        }


        /* â”€â”€ WIZARD FORM STYLES â”€â”€ */
        .wz-container {
            position: relative;
        }

        /* Progress Bar */
        .wz-progress {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 28px;
            position: relative;
            padding: 0 4px;
        }

        .wz-progress-track {
            position: absolute;
            top: 50%;
            left: 40px;
            right: 40px;
            height: 3px;
            background: #e2e8f0;
            border-radius: 4px;
            transform: translateY(-50%);
            z-index: 0;
            overflow: hidden;
        }

        .wz-progress-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            border-radius: 4px;
            transition: width .45s cubic-bezier(.34, 1.56, .64, 1);
        }

        .wz-dot {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #f1f5f9;
            border: 2.5px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 800;
            color: #94a3b8;
            position: relative;
            z-index: 1;
            transition: all .3s;
            cursor: default;
            flex-shrink: 0;
        }

        .wz-dot.wz-dot-active {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
            box-shadow: 0 0 0 4px rgba(30, 90, 168, .15);
            transform: scale(1.08);
        }

        .wz-dot.wz-dot-done {
            background: #16a34a;
            border-color: #16a34a;
            color: #fff;
        }

        .wz-dot-label {
            position: absolute;
            top: calc(100% + 8px);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #94a3b8;
            white-space: nowrap;
            transition: color .3s;
        }

        .wz-dot.wz-dot-active .wz-dot-label,
        .wz-dot.wz-dot-done .wz-dot-label {
            color: var(--dark);
        }

        /* Steps */
        .wz-step {
            display: none;
            animation: wzFadeIn .35s ease;
        }

        .wz-step.wz-active {
            display: block;
        }

        @keyframes wzFadeIn {
            from { opacity: 0; transform: translateX(18px); }
            to { opacity: 1; transform: none; }
        }

        .wz-step.wz-done .wz-step-inner {
            opacity: .5;
        }

        .wz-step-title {
            font-size: 17px;
            font-weight: 800;
            color: var(--dark);
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .wz-step-sub {
            font-size: 12px;
            color: #94a3b8;
            margin-bottom: 20px;
        }

        .wz-step-icon {
            width: 32px;
            height: 32px;
            border-radius: 9px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            flex-shrink: 0;
        }

        /* Form fields inside wizard */
        .wz-step label.lbl {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #64748b;
            margin-bottom: 6px;
            display: block;
        }

        .wz-step .form-control,
        .wz-step .form-select {
            border-radius: 10px;
            padding: 10px 14px;
            border: 1.5px solid #e2e8f0;
            font-size: 14px;
            background: #fafcff;
            font-family: inherit;
            transition: .2s;
            outline: none;
            width: 100%;
        }

        .wz-step .form-control:focus,
        .wz-step .form-select:focus {
            border-color: var(--secondary);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(74, 127, 196, .12);
        }

        .wz-step .form-control.wz-error,
        .wz-step .form-select.wz-error {
            border-color: #e11d48;
            box-shadow: 0 0 0 3px rgba(225, 29, 72, .12);
        }

        @keyframes wzShake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-6px); }
            40% { transform: translateX(6px); }
            60% { transform: translateX(-4px); }
            80% { transform: translateX(4px); }
        }

        .wz-shake {
            animation: wzShake .45s ease;
        }

        /* Navigation buttons */
        .wz-nav {
            display: flex;
            gap: 10px;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid #f1f5f9;
        }

        .wz-btn {
            flex: 1;
            padding: 12px 20px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 14px;
            font-family: inherit;
            cursor: pointer;
            transition: .25s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
        }

        .wz-btn-primary {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 6px 18px rgba(30, 90, 168, .25);
        }

        .wz-btn-primary:hover {
            background: var(--dark);
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(18, 26, 47, .3);
        }

        .wz-btn-secondary {
            background: #E6EEF8;
            color: #64748b;
            border: 1.5px solid #e2e8f0;
        }

        .wz-btn-secondary:hover {
            background: #d1dce8;
            color: #334155;
        }

        .wz-btn-success {
            background: #16a34a;
            color: #fff;
            box-shadow: 0 6px 18px rgba(22, 163, 74, .25);
        }

        .wz-btn-success:hover {
            background: #15803d;
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(22, 163, 74, .3);
        }

        /* Review card */
        .wz-review-card {
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            border-radius: 14px;
            padding: 20px;
            margin-bottom: 16px;
        }

        .wz-review-row {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 8px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .wz-review-row:last-child {
            border-bottom: none;
        }

        .wz-review-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
            color: #94a3b8;
            min-width: 90px;
            flex-shrink: 0;
            padding-top: 2px;
        }

        .wz-review-value {
            font-size: 14px;
            font-weight: 600;
            color: #0f172a;
        }

        .loc-toggle {
            display: flex;
            gap: 8px;
        }

        .loc-btn {
            flex: 1;
            padding: 10px;
            border: 1.5px solid #e2e8f0;
            border-radius: 10px;
            background: #fafcff;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
            color: #64748b;
            text-align: center;
            transition: .2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .loc-btn.active {
            border-color: var(--primary);
            background: var(--primary);
            color: #fff;
        }

        .btn-submit {
            width: 100%;
            padding: 13px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 50px;
            font-weight: 700;
            font-size: 15px;
            font-family: inherit;
            cursor: pointer;
            transition: .25s;
            box-shadow: 0 6px 18px rgba(30, 90, 168, .25);
        }

        .btn-submit:hover {
            background: var(--dark);
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(18, 26, 47, .3);
        }

        /* â”€â”€ ALERT TOAST â”€â”€ */
        .alert-toast {
            position: fixed;
            top: 24px;
            right: 32px;
            z-index: 9999;
            min-width: 320px;
            max-width: 440px;
            border-radius: 14px;
            padding: 16px 20px;
            font-weight: 500;
            font-size: 14px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, .14);
            animation: toastIn .4s ease;
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }

        .alert-toast.success {
            background: #f0fdf4;
            border: 1.5px solid #bbf7d0;
            color: #15803d;
        }

        /* â”€â”€ FEEDBACK MODAL PREMIUM STYLES â”€â”€ */
        .feedback-stars i {
            font-size: 32px;
            color: #e2e8f0;
            cursor: pointer;
            transition: .2s;
        }

        .feedback-stars i.active {
            color: #fbbf24;
            transform: scale(1.1);
        }

        .feedback-modal-content {
            border-radius: 30px;
            border: none;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
        }

        .feedback-header {
            background: #eff6ff;
            border: none;
            padding: 30px 30px 10px;
            position: relative;
        }

        .feedback-body {
            padding: 30px;
            text-align: center;
        }

        .feedback-icon-bg {
            width: 80px;
            height: 80px;
            background: #fff;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        }

        .feedback-btn {
            background: #1E5AA8;
            color: #fff;
            border: none;
            border-radius: 15px;
            padding: 14px;
            font-weight: 700;
            width: 100%;
            transition: .2s;
            margin-top: 10px;
        }

        .feedback-btn:hover {
            background: #15407A;
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(30, 90, 168, 0.3);
        }

        .feedback-textarea {
            border-radius: 15px;
            border: 1.5px solid #e2e8f0;
            background: #f8fafc;
            padding: 15px;
            font-size: 14px;
        }

        .feedback-textarea:focus {
            border-color: #3b82f6;
            box-shadow: none;
            background: #fff;
        }

        .alert-toast.danger {
            background: #fff1f2;
            border: 1.5px solid #fecdd3;
            color: #be123c;
        }

        @keyframes toastIn {
            from {
                opacity: 0;
                transform: translateY(-16px) scale(.96);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        /* â”€â”€ DETAIL MODAL â”€â”€ */
        .dmodal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, .5);
            z-index: 99998;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 16px;
            opacity: 0;
            transition: opacity .18s;
        }

        .dmodal-backdrop.open {
            display: flex;
        }

        .dmodal {
            background: #fff;
            border-radius: 20px;
            width: 100%;
            max-width: 520px;
            max-height: 88vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 24px 64px rgba(0, 0, 0, .2);
            overflow: hidden;
            transform: scale(.95) translateY(12px);
            transition: transform .2s, opacity .2s;
            opacity: 0;
        }

        .dmodal-backdrop.open .dmodal {
            transform: none;
            opacity: 1;
        }

        .dmodal-header {
            padding: 20px 24px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .dmodal-header h5 {
            font-weight: 800;
            font-size: 17px;
            color: var(--dark);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .dmodal-close {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 1.5px solid #e2e8f0;
            background: #E6EEF8;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            color: #64748b;
            transition: .15s;
        }

        .dmodal-close:hover {
            background: #fee2e2;
            border-color: #fca5a5;
            color: #e11d48;
        }

        .dmodal-body {
            overflow-y: auto;
            padding: 24px;
            flex: 1;
        }

        .dmodal-footer {
            padding: 16px 24px;
            border-top: 1px solid #f1f5f9;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }

        .info-item label {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #94a3b8;
            display: block;
            margin-bottom: 3px;
        }

        .info-item .val {
            font-size: 14px;
            font-weight: 600;
            color: #0f172a;
        }

        .info-item.full {
            grid-column: 1/-1;
        }

        .service-hero {
            text-align: center;
            background: linear-gradient(135deg, #eff6ff, #e0f2fe);
            border-radius: 14px;
            padding: 18px;
            margin-bottom: 16px;
        }

        .service-hero .sname {
            font-size: 20px;
            font-weight: 800;
            color: var(--primary);
        }

        .service-hero .slim {
            font-size: 13px;
            color: #64748b;
            margin-top: 2px;
        }

        .notice-box {
            border-radius: 12px;
            padding: 14px 16px;
            font-size: 13px;
            margin-bottom: 14px;
        }

        .notice-box.warn {
            background: #fff7ed;
            border: 1.5px solid #fed7aa;
            color: #9a3412;
        }

        .btn-action {
            flex: 1;
            padding: 11px 16px;
            border-radius: 50px;
            border: none;
            font-weight: 700;
            font-size: 13px;
            font-family: inherit;
            cursor: pointer;
            transition: .2s;
        }

        .btn-action.green {
            background: #16a34a;
            color: #fff;
        }

        .btn-action.red {
            background: #fff;
            border: 1.5px solid #fca5a5;
            color: #e11d48;
        }

        .btn-action.gray {
            background: #E6EEF8;
            border: 1.5px solid #e2e8f0;
            color: #64748b;
        }

        .btn-action.danger-solid {
            background: #e11d48;
            color: #fff;
        }

        .btn-action:hover {
            opacity: .88;
            transform: translateY(-1px);
        }

        #homeAddressContainer,
        #endDateContainer {
            display: none;
        }

        .no-appt {
