        </div>
    </div>

    <!-- â”€â”€ CLIENT RESCHEDULE REQUEST MODAL â”€â”€ -->
    <div id="rescheduleBackdrop" class="dmodal-backdrop">
        <div class="dmodal" style="max-width:440px;">
            <div class="dmodal-header">
                <h5><i class="fa fa-calendar-plus me-1 text-primary"></i> Request Reschedule</h5>
                <button class="dmodal-close" onclick="closeRescheduleModal()">&times;</button>
            </div>
            <div class="dmodal-body">
                <form method="POST" id="reschedForm">
                    <input type="hidden" name="request_reschedule" value="1">
                    <input type="hidden" name="reschedule_apt_id" id="resched-aid">
                    <input type="hidden" name="appt_type" id="resched-type">

                    <div
                        style="background:#f8fafc; border-radius:12px; padding:15px; margin-bottom:20px; border:1px solid #e2e8f0;">
                        <div
                            style="font-size:11px; font-weight:800; color:#94a3b8; text-transform:uppercase; margin-bottom:4px;">
                            Shifting Schedule For</div>
                        <div id="resched-pet" style="font-weight:700; color:#0f172a; font-size:15px;">Buddy</div>
                        <div id="resched-old-date" style="font-size:13px; color:#64748b;">Oct 24, 2023 at 09:00 AM</div>
                    </div>

                    <div class="mb-3">
                        <label class="lbl">Proposed New Date & Time</label>
                        <input type="text" name="new_proposed_date_time" id="resched-new-date" class="form-control"
                            placeholder="Select new schedule..." required>
                        <input type="hidden" name="new_proposed_date" id="h-resched-date">
                        <input type="hidden" name="new_proposed_time" id="h-resched-time">
                    </div>

                    <div class="mb-4">
                        <label class="lbl">Reason for Shifting</label>
                        <textarea name="reschedule_reason" class="form-control" rows="3"
                            placeholder="e.g. Work emergency, pet not feeling well enough to travel..."
                            required></textarea>
                    </div>

                    <p style="font-size:12px; color:#64748b; line-height:1.5; margin-bottom:20px;">
                        <i class="fa fa-info-circle me-1 text-primary"></i> Your request will be sent to the clinic
                        staff. You will be notified once they review and update your schedule.
                    </p>

                    <button type="submit" class="btn-submit">Send Reschedule Request</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('reschedForm') && document.getElementById('reschedForm').addEventListener('submit', function (e) {
            var dt = document.getElementById('resched-new-date').value;
            if (dt) {
                var parts = dt.split(' ');
                document.getElementById('h-resched-date').value = parts[0];
                document.getElementById('h-resched-time').value = parts[1] || '08:00';
            }
        });
    </script>


    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // â”€â”€ TOAST AUTO DISMISS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        (function () {
            var t = document.getElementById('toastMsg');
            if (t) setTimeout(function () { t.style.opacity = '0'; t.style.transform = 'translateY(-16px)'; setTimeout(function () { t.remove(); }, 400); }, 4000);
        })();

        // â”€â”€ NO PET MODAL AUTO-SHOW â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        (function () {
            var backdrop = document.getElementById('noPetBackdrop');
            if (!backdrop) return; // user has pets, modal not rendered
            // Small delay so page renders first, then modal fades in smoothly
            setTimeout(function () {
                backdrop.classList.add('visible');
            }, 350);
        })();

        function closeNoPetModal() {
            var backdrop = document.getElementById('noPetBackdrop');
            if (!backdrop) return;
            backdrop.classList.remove('visible');
            setTimeout(function () { backdrop.style.display = 'none'; }, 280);
        }

        function openRegisterPetModal() {
            closeNoPetModal();
            setTimeout(function () {
                var modal = new bootstrap.Modal(document.getElementById('registerPetModal'));
                modal.show();
                // Init flatpickr on the vaccine fields inside this modal
                if (typeof flatpickr !== 'undefined') {
                    document.querySelectorAll('.flatpickr-rpa').forEach(function (el) {
                        if (!el._flatpickr) flatpickr(el, { dateFormat: 'Y-m-d' });
                    });
                }
            }, 300);
        }

        // Close on backdrop click
        document.addEventListener('DOMContentLoaded', function () {
            var backdrop = document.getElementById('noPetBackdrop');
            if (backdrop) {
                backdrop.addEventListener('click', function (e) {
                    if (e.target === backdrop) closeNoPetModal();
                });
            }
        });

        // Close on Escape key (won't conflict with detail modal since it checks which is open)
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                var backdrop = document.getElementById('noPetBackdrop');
                if (backdrop && backdrop.classList.contains('visible')) closeNoPetModal();
            }
        });


        // â”€â”€ LIVE SEARCH â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        (function () {
            var inp = document.getElementById('apptSearch');
            var body = document.getElementById('apptBody');
            var noRes = document.getElementById('noSearchResult');
            var activeFilter = 'all';

            function applyFilters() {
                if (!body) return;
                var q = (inp ? inp.value : '').toLowerCase().trim();
                var rows = body.querySelectorAll('.appt-row');
                var visible = 0;
                rows.forEach(function (r) {
                    var statusMatch = activeFilter === 'all' ||
                        (activeFilter === 'action_needed' ? r.dataset.actionNeeded === '1' : r.dataset.status === activeFilter);
                    var textMatch = !q || r.innerText.toLowerCase().includes(q);
                    var show = statusMatch && textMatch;
                    r.style.display = show ? '' : 'none';
                    if (show) visible++;
                });
                if (noRes) noRes.style.display = visible === 0 ? 'block' : 'none';
            }
            window.applyFilters = applyFilters;

            if (inp) inp.addEventListener('input', applyFilters);

            // Filter tabs
            document.querySelectorAll('.filter-tab').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('.filter-tab').forEach(function (b) { b.classList.remove('active'); });
                    btn.classList.add('active');
                    activeFilter = btn.dataset.filter;
                    applyFilters();
                });
            });
        })();

        // â”€â”€ DETAIL MODAL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
        function statusBadgeHtml(s) {
            var cls = 'badge-default', dot = '#94a3b8';
            if (s === 'Pending') { cls = 'badge-pending'; dot = '#ea580c'; }
            else if (s === 'Approved') { cls = 'badge-approved'; dot = '#16a34a'; }
            else if (s === 'Completed') { cls = 'badge-completed'; dot = '#2563eb'; }
            else if (s === 'Reschedule Proposed') { cls = 'badge-proposed'; dot = '#7e22ce'; }
            else if (s.includes('Cancel') || s.includes('Reject')) { cls = 'badge-cancelled'; dot = '#e11d48'; }
            return '<span class="badge-s ' + cls + '" style="font-size:14px;padding:7px 18px;"><span style="width:9px;height:9px;border-radius:50%;background:' + dot + ';flex-shrink:0;"></span>' + esc(s) + '</span>';
        }

        function esc(s) { return s ? String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') : '-'; }

        function fmtDate(d) { if (!d) return '-'; var o = new Date(d + 'T00:00:00'); return o.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }); }
        function fmtTime(t) { if (!t) return ''; var p = t.split(':'); var h = parseInt(p[0]), m = p[1], ap = h >= 12 ? 'PM' : 'AM'; h = h % 12 || 12; return h + ':' + m + ' ' + ap; }
        function fmtDT(d, t) { return fmtDate(d) + (t ? ' at ' + fmtTime(t) : ''); }
        function fmtFull(s) { if (!s) return '-'; return new Date(s).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true }); }

        function openDetailModal(data) {
            document.getElementById('dm-service').textContent = data.service_type || 'Appointment';
            document.getElementById('dm-datetime').textContent = fmtDT(data.appointment_date, data.appointment_time);
            document.getElementById('dm-status-wrap').innerHTML = statusBadgeHtml(data.status);
            document.getElementById('dm-pet').textContent = data.pet_name || '-';
            document.getElementById('dm-doctor').textContent = data.doctor_name || 'Clinic Assigned';
            document.getElementById('dm-location').textContent = data.service_location || '-';
            document.getElementById('dm-created').textContent = fmtFull(data.created_at);

            var addrW = document.getElementById('dm-address-wrap');
            if (data.service_location === 'Home Service' && data.home_address) {
                addrW.style.display = 'block';
                document.getElementById('dm-address').textContent = data.home_address;
            } else { addrW.style.display = 'none'; }

            // Admin notice / reschedule
            var notice = document.getElementById('dm-notice');
            var noticeTxt = document.getElementById('dm-notice-text');
            if (data.admin_message) {
                notice.style.display = 'block';
                noticeTxt.textContent = data.admin_message;
            } else { notice.style.display = 'none'; }

            // Footer buttons
            var footer = document.getElementById('dm-footer');
            footer.innerHTML = '';

            // Close btn always
            var closeBtn = document.createElement('button');
            closeBtn.className = 'btn-action gray'; closeBtn.textContent = 'Close';
            closeBtn.onclick = closeDetailModal;
            footer.appendChild(closeBtn);

            // Pending: cancel button
            if (data.status === 'Pending') {
                var cancelBtn = document.createElement('button');
                cancelBtn.className = 'btn-action danger-solid';
                cancelBtn.innerHTML = '<i class="fa fa-times-circle me-1"></i> Cancel Request';
                cancelBtn.onclick = function () {
                    if (!confirm('Are you sure you want to cancel this pending request?')) return;
                    var f = document.createElement('form'); f.method = 'POST'; f.style.display = 'none';
                    f.innerHTML = '<input name="cancel_appt" value="1"><input name="cancel_appt_id" value="' + data.id + '"><input name="appt_type" value="' + (data._type || 'Appointment') + '">';
                    document.body.appendChild(f); f.submit();
                };
                footer.appendChild(cancelBtn);
            }

            // Approved: allow client to request reschedule
            if (data.status === 'Approved') {
                var reschedBtn = document.createElement('button');
                reschedBtn.className = 'btn-action gray';
                reschedBtn.innerHTML = '<i class="fa fa-calendar-alt me-1"></i> Request Reschedule';
                reschedBtn.onclick = function () { openRescheduleModal(data); };
                footer.insertBefore(reschedBtn, closeBtn);
            }


            // Reschedule proposed: accept/decline
            if (data.client_action_needed == 1 && data.admin_message) {
                var acceptBtn = document.createElement('button');
                acceptBtn.className = 'btn-action green';
                acceptBtn.innerHTML = '<i class="fa fa-check me-1"></i> Accept Reschedule';
                acceptBtn.onclick = function () {
                    if (!confirm('Accept the proposed reschedule and confirm appointment?')) return;
                    var f = document.createElement('form'); f.method = 'POST'; f.style.display = 'none';
                    f.innerHTML = '<input name="accept_reschedule" value="1"><input name="reschedule_apt_id" value="' + data.id + '"><input name="appt_type" value="' + (data._type || 'Appointment') + '">';
                    document.body.appendChild(f); f.submit();
                };
                var declineBtn = document.createElement('button');
                declineBtn.className = 'btn-action red';
                declineBtn.innerHTML = '<i class="fa fa-times me-1"></i> Decline';
                declineBtn.onclick = function () {
                    if (!confirm('Decline this reschedule? The request will be permanently cancelled.')) return;
                    var f = document.createElement('form'); f.method = 'POST'; f.style.display = 'none';
                    f.innerHTML = '<input name="decline_reschedule" value="1"><input name="reschedule_apt_id" value="' + data.id + '"><input name="appt_type" value="' + (data._type || 'Appointment') + '">';
                    document.body.appendChild(f); f.submit();
                };
                footer.insertBefore(declineBtn, closeBtn);
                footer.insertBefore(acceptBtn, declineBtn);
            }

            // Show modal
            var bd = document.getElementById('detailBackdrop');
            bd.classList.add('open');
            setTimeout(function () { bd.style.opacity = '1'; }, 10);
        }

        function closeDetailModal() {
            var bd = document.getElementById('detailBackdrop');
            bd.style.opacity = '0';
            setTimeout(function () { bd.classList.remove('open'); bd.style.opacity = ''; }, 180);
        }

        document.getElementById('detailBackdrop').addEventListener('click', function (e) {
            if (e.target === this) closeDetailModal();
        });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeDetailModal(); });

        function openRescheduleModal(data) {
            closeDetailModal();
            document.getElementById('resched-aid').value = data.id;
            document.getElementById('resched-type').value = data._type || 'Appointment';
            document.getElementById('resched-pet').textContent = data.pet_name;
            document.getElementById('resched-old-date').textContent = fmtDT(data.appointment_date, data.appointment_time);

            var bd = document.getElementById('rescheduleBackdrop');
            bd.classList.add('open');
            setTimeout(function () { bd.style.opacity = '1'; }, 10);

            // Initialize flatpickr for the new date
            flatpickr('#resched-new-date', {
                minDate: 'today',
                dateFormat: 'Y-m-d H:i',
                enableTime: true,
                defaultDate: data.appointment_date + ' ' + (data.appointment_time || '08:00'),
                disableMobile: true
            });
        }

        function closeRescheduleModal() {
            var bd = document.getElementById('rescheduleBackdrop');
            bd.style.opacity = '0';
            setTimeout(function () { bd.classList.remove('open'); bd.style.opacity = ''; }, 180);
        }
    </script>

    <!-- Flatpickr + Doctor Leave JS -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="js_smart_slots.js"></script>
    <script src="js_appointment_wizard.js"></script>
    <style>
        .tp-col::-webkit-scrollbar {
            display: none;
        }

        .tp-item {
            height: 42px;
            line-height: 42px;
            font-size: 18px;
            font-weight: 600;
            color: #94a3b8;
            scroll-snap-align: center;
            cursor: pointer;
            transition: color .15s, font-size .15s;
            user-select: none;
        }

        .tp-item.selected {
            color: #0f172a;
            font-size: 20px;
        }
    </style>
    <script>
        (function () {
            var doctorLeaves = <?php echo $doctorLeavesJSON; ?>;
            var fpDate, fpTime, fpEnd;

            // â”€â”€ Date picker â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            fpDate = flatpickr('#appointmentDate', {
                minDate: 'today',
                dateFormat: 'Y-m-d',
                disableMobile: true,
                onChange: function (sel, ds) {
                    // Update end date min
                    if (fpEnd) fpEnd.set('minDate', ds);
                    checkDoctorLeave(ds);
                    if (typeof loadAvailableSlots === 'function') {
                        loadAvailableSlots();
                    }
                }
            });

            // â”€â”€ Custom Drum Time Picker â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            (function () {
                var hours = [], mins = [], ampm = ['AM', 'PM'];
                for (var i = 1; i <= 12; i++) hours.push((i < 10 ? '0' : '') + i);
                for (var i = 0; i < 60; i += 5) mins.push((i < 10 ? '0' : '') + i);

                function buildCol(el, items, startIdx) {
                    el.innerHTML = '';
                    items.forEach(function (v) {
                        var d = document.createElement('div');
                        d.className = 'tp-item'; d.textContent = v;
                        el.appendChild(d);
                    });
                    scrollToIdx(el, startIdx);
                }

                function scrollToIdx(el, idx) {
                    el.scrollTop = idx * 42;
                }

                function getIdx(el) {
                    return Math.round(el.scrollTop / 42);
                }

                function highlightAll() {
                    [colH, colM, colA].forEach(function (col) {
                        var idx = getIdx(col);
                        Array.from(col.children).forEach(function (c, i) { c.classList.toggle('selected', i === idx); });
                    });
                }

                var colH = document.getElementById('tpHours');
                var colM = document.getElementById('tpMins');
                var colA = document.getElementById('tpAmpm');
                var pickerOpen = false;

                buildCol(colH, hours, 7); // default 08
                buildCol(colM, mins, 0);  // default :00
                buildCol(colA, ampm, 0);  // default AM

                [colH, colM, colA].forEach(function (col) {
                    col.addEventListener('scroll', function () { clearTimeout(col._st); col._st = setTimeout(function () { var i = getIdx(col); scrollToIdx(col, i); highlightAll(); }, 80); });
                });
                highlightAll();

                window.openTimePicker = function () {
                    var dp = document.getElementById('timePickerDropdown');
                    dp.style.display = pickerOpen ? 'none' : 'block';
                    pickerOpen = !pickerOpen;
                    highlightAll();
                };
                window.cancelTimePicker = function () {
                    document.getElementById('timePickerDropdown').style.display = 'none';
                    pickerOpen = false;
                };
                window.confirmTimePicker = function () {
                    var h = hours[getIdx(colH)] || '08';
                    var m = mins[getIdx(colM)] || '00';
                    var a = ampm[getIdx(colA)] || 'AM';
                    document.getElementById('appointmentTime').value = h + ':' + m + ' ' + a;
                    document.getElementById('timePickerDropdown').style.display = 'none';
                    pickerOpen = false;
                };

                // Close on outside click
                document.addEventListener('click', function (e) {
                    var dp = document.getElementById('timePickerDropdown');
                    var inp = document.getElementById('appointmentTime');
                    if (pickerOpen && !dp.contains(e.target) && e.target !== inp) {
                        dp.style.display = 'none'; pickerOpen = false;
                    }
                });
            })();

            // â”€â”€ End date picker â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            fpEnd = flatpickr('#endDateInput', {
                minDate: 'today',
                dateFormat: 'Y-m-d',
                disableMobile: true
            });

            // â”€â”€ Doctor leave validation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            function checkDoctorLeave(selectedDate) {
                var sel = document.getElementById('doctorSelect');
                var warn = document.getElementById('doctorLeaveWarn');
                var warnMsg = document.getElementById('doctorLeaveMsg');
                if (!sel) return;

                // Reset all options
                Array.from(sel.options).forEach(function (opt) {
                    if (!opt.value) return;
                    opt.disabled = false;
                    opt.text = opt.text.replace(' (Unavailable this day)', '');
                });

                if (!selectedDate) { if (warn) warn.style.display = 'none'; return; }

                var hasWarn = false;
                Array.from(sel.options).forEach(function (opt) {
                    if (!opt.value) return;
                    var docId = opt.value;
                    var leaves = doctorLeaves[docId] || [];
                    if (leaves.indexOf(selectedDate) !== -1) {
                        opt.disabled = true;
                        opt.text += ' (Unavailable this day)';
                        // If this doctor was selected, reset
                        if (sel.value === docId) { sel.value = ''; }
                        hasWarn = true;
                    }
                });

                if (warn) {
                    if (hasWarn) {
                        warn.style.display = 'block';
                        warnMsg.textContent = 'One or more doctors are on leave on this date and cannot be selected.';
                    } else {
                        warn.style.display = 'none';
                    }
                }
            }

            // Also run when doctor dropdown changes
            var docSel = document.getElementById('doctorSelect');
            if (docSel) {
                docSel.addEventListener('change', function () {
                    var dateVal = document.getElementById('appointmentDate').value;
                    if (!dateVal) return;
                    var docId = this.value;
                    var warn = document.getElementById('doctorLeaveWarn');
                    var warnMsg = document.getElementById('doctorLeaveMsg');
                    var leaves = doctorLeaves[docId] || [];
                    if (docId && leaves.indexOf(dateVal) !== -1) {
                        this.value = '';
                        if (warn) { warn.style.display = 'block'; warnMsg.textContent = 'This doctor is on leave on the selected date. Please choose another.'; }
                    }
                });
            }

            // â”€â”€ Submit guard: save signature + validate time â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
            var form = document.getElementById('appointmentForm');
            if (form) {
                form.addEventListener('submit', function (e) {
                    var c = document.getElementById('signatureCanvas');
                    if (c) document.getElementById('signatureData').value = c.toDataURL('image/png');

                    var dateVal = document.getElementById('appointmentDate').value;
                    var timeVal = document.getElementById('appointmentTime').value;
                    var today = new Date();
                    var todayStr = today.getFullYear() + '-' + String(today.getMonth() + 1).padStart(2, '0') + '-' + String(today.getDate()).padStart(2, '0');
                    if (dateVal === todayStr && timeVal) {
                        var nowTime = String(today.getHours()).padStart(2, '0') + ':' + String(today.getMinutes()).padStart(2, '0');
                        if (timeVal < nowTime) {
                            e.preventDefault();
                            alert('You cannot book an appointment for a time that has already passed today.');
                            return;
                        }
                    }

                    // End date check
                    var edInp = document.getElementById('endDateInput');
                    if (edInp && edInp.hasAttribute('required') && edInp.value && edInp.value < dateVal) {
                        e.preventDefault();
                        alert('The Discharge/End Date cannot be earlier than the Start Date!');
                    }
                });
            }
        })();
    </script>

    <!-- FEEDBACK MODAL -->
    <?php if ($pending_feedback): ?>
        <div class="modal fade" id="autoFeedbackModal" data-bs-backdrop="static" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content feedback-modal-content">
                    <div class="feedback-header text-center">
                        <button type="button" class="btn-close position-absolute" data-bs-dismiss="modal"
                            style="top:20px; right:20px;"></button>
                        <div class="feedback-icon-bg">
                            <i class="fa fa-comments text-primary" style="font-size:35px;"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1">Submit Your Feedback</h3>
                        <p class="text-muted small">We'd love to hear about your experience with
                            <b><?php echo htmlspecialchars($pending_feedback['pet_name']); ?></b>'s
                            <?php echo htmlspecialchars($pending_feedback['service_type']); ?>.</p>
                    </div>
                    <div class="feedback-body">
                        <div class="feedback-stars mb-4 d-flex justify-content-center gap-2">
                            <i class="fa fa-star star-item" data-value="1"></i>
                            <i class="fa fa-star star-item" data-value="2"></i>
                            <i class="fa fa-star star-item" data-value="3"></i>
                            <i class="fa fa-star star-item" data-value="4"></i>
                            <i class="fa fa-star star-item" data-value="5"></i>
                        </div>

                        <form id="feedbackForm">
                            <input type="hidden" name="appointment_id" value="<?php echo $pending_feedback['id']; ?>">
                            <input type="hidden" name="rating" id="feedbackRatingInput" value="0">
                            <input type="hidden" name="submit_review" value="1">

                            <div class="mb-3 text-start">
                                <textarea name="comments" class="form-control feedback-textarea" rows="3"
                                    placeholder="Your message (Optional)..."></textarea>
                            </div>

                            <button type="button" class="feedback-btn" onclick="submitFeedbackAjax()">
                                <i class="fa fa-paper-plane me-2"></i> SEND FEEDBACK
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var fbModal = new bootstrap.Modal(document.getElementById('autoFeedbackModal'));
                fbModal.show();

                // Star Interaction
                const stars = document.querySelectorAll('.star-item');
                stars.forEach(s => {
                    s.addEventListener('click', function () {
                        const val = this.getAttribute('data-value');
                        document.getElementById('feedbackRatingInput').value = val;
                        stars.forEach(st => {
                            if (st.getAttribute('data-value') <= val) st.classList.add('active');
                            else st.classList.remove('active');
                        });
                    });
                });
            });

            function submitFeedbackAjax() {
                const rating = document.getElementById('feedbackRatingInput').value;
                if (rating == "0") {
                    alert("Please select a rating star first.");
                    return;
                }

                const btn = document.querySelector('.feedback-btn');
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i> SENDING...';
                btn.disabled = true;

                const formData = new FormData(document.getElementById('feedbackForm'));
                fetch('feedback.php', {
                    method: 'POST',
                    body: formData
                })
                    .then(() => {
                        btn.innerHTML = '<i class="fa fa-check me-2"></i> THANK YOU!';
                        btn.style.background = '#10b981';
                        setTimeout(() => {
                            bootstrap.Modal.getInstance(document.getElementById('autoFeedbackModal')).hide();
                        }, 1500);
                    })
                    .catch(() => {
                        alert("Something went wrong. Please try again.");
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    });
            }
        </script>
    <?php endif; ?>

    <?php include("chat_widget.php"); ?>
    <script src="mousetrail.js"></script>
</body>

</html>