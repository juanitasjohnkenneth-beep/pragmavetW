                                        <th>Service Flow</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody id="apptBody">
                                    <?php foreach ($apptRows as $row):
                                        $status = $row['status'];
                                        $badgeCls = match (true) {
                                            $status === 'Pending' => 'badge-pending',
                                            $status === 'Approved' => 'badge-approved',
                                            $status === 'Completed' => 'badge-completed',
                                            $status === 'Reschedule Proposed' => 'badge-proposed',
                                            $status === 'Reschedule Requested' => 'badge-proposed',
                                            str_contains($status, 'Cancel') || str_contains($status, 'Reject') => 'badge-cancelled',
                                            default => 'badge-default'
                                        };
                                        $badgeDot = match (true) {
                                            $status === 'Pending' => '#ea580c',
                                            $status === 'Approved' => '#16a34a',
                                            $status === 'Completed' => '#2563eb',
                                            $status === 'Reschedule Proposed' => '#7e22ce',
                                            $status === 'Reschedule Requested' => '#7c3aed',
                                            str_contains($status, 'Cancel') || str_contains($status, 'Reject') => '#e11d48',
                                            default => '#94a3b8'
                                        };
                                        $rowData = json_encode($row, JSON_HEX_TAG | JSON_HEX_QUOT | JSON_HEX_AMP);
                                        ?>
                                        <tr class="appt-row" data-status="<?php echo htmlspecialchars($status); ?>"
                                            data-action-needed="<?php echo (isset($row['client_action_needed']) && $row['client_action_needed'] == 1 && !str_contains($status, 'Cancel') && !str_contains($status, 'Reject')) ? '1' : '0'; ?>"
                                            onclick="openDetailModal(<?php echo htmlspecialchars($rowData, ENT_QUOTES); ?>)">
                                            <td>
                                                <div style="display:flex;align-items:center;gap:12px;">
                                                    <?php 
                                                    $petPic = $row['pet_picture'] ?? '';
                                                    echo function_exists('petAvatarHtml') 
                                                        ? petAvatarHtml($petPic, $row['pet_name'], 42) 
                                                        : '<div class="pet-avatar"><i class="fa fa-paw"></i></div>'; 
                                                    ?>
                                                    <div>
                                                        <div style="font-weight:700;color:#0f172a;font-size:14px;">
                                                            <?php echo htmlspecialchars($row['pet_name']); ?>
                                                        </div>
                                                        <div style="font-size:12px;font-weight:600;color:var(--secondary);">
                                                            <?php echo htmlspecialchars($row['service_type']); ?>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div style="font-weight:600;color:#0f172a;font-size:13px;"><i
                                                        class="far fa-calendar-alt"
                                                        style="color:#94a3b8;margin-right:5px;"></i><?php echo date("M d, Y", strtotime($row['appointment_date'])); ?>
                                                </div>
                                                <div style="font-size:12px;color:#64748b;margin-top:2px;"><i
                                                        class="far fa-clock"
                                                        style="margin-right:4px;"></i><?php echo date("h:i A", strtotime($row['appointment_time'])); ?>
                                                </div>
                                            </td>
                                            <td>
                                                <?php if ($row['service_location'] === 'Home Service'): ?>
                                                    <span
                                                        style="display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:8px;background:#e0f2fe;color:#0369a1;font-size:12px;font-weight:600;"><i
                                                            class="fa fa-home"></i> Home Visit</span>
                                                <?php else: ?>
                                                    <span
                                                        style="display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:8px;background:#f1f5f9;color:#475569;font-size:12px;font-weight:600;"><i
                                                            class="fa fa-hospital"></i> On-Site</span>
                                                <?php endif; ?>
                                            </td>
                                            <td>
                                                <span class="badge-s <?php echo $badgeCls; ?>">
                                                    <span
                                                        style="width:7px;height:7px;border-radius:50%;background:<?php echo $badgeDot; ?>;flex-shrink:0;"></span>
                                                    <?php echo htmlspecialchars($status); ?>
                                                </span>
                                            </td>
                                        </tr>
                                    <?php endforeach; ?>
                                </tbody>
