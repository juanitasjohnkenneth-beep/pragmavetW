                                                onclick="openCctvModal('<?php echo htmlspecialchars($currently_occupied_by['cctv_link']); ?>', '<?php echo htmlspecialchars($currently_occupied_by['pet_name']); ?>', '<?php echo $currently_occupied_by['res_id']; ?>')"><i
