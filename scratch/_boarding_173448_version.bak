<?php
ob_start();
session_start();
include("dbconnection.php");
include("paymongo_config.php");

if (!isset($_SESSION['user_id'])) {
    header("Location: index.php");
    exit();
}

$user_id = $_SESSION['user_id'];
$user_name = $_SESSION['user'];

// Fetch user's pets for the booking modal dropdown
$stmt_pets = $conn->prepare("SELECT name, species FROM pets WHERE user_id=? ORDER BY name ASC");
$stmt_pets->bind_param("i", $user_id);
$stmt_pets->execute();
$pets_result = $stmt_pets->get_result();

// â”€â”€ PayMongo Success Callback â€” runs after demo payment completes â”€â”€
if (isset($_GET['pm_success'], $_GET['res_id'])) {
    $res_id = (int) $_GET['res_id'];
    $pay_type = $_GET['pm_success'];          // 'downpayment' or 'full'
    $total = (float) ($_GET['total'] ?? 0);
    $dp = (float) ($_GET['dp'] ?? 0);
    $now = date('Y-m-d H:i:s');

    // Ensure billing columns exist (safe for all MySQL versions)
    $needed = [
        'downpayment_amount' => "DECIMAL(10,2) NOT NULL DEFAULT 0",
        'downpayment_status' => "VARCHAR(20) NOT NULL DEFAULT 'Unpaid'",
        'downpayment_paid_at' => 'DATETIME DEFAULT NULL',
        'is_boarding' => 'TINYINT(1) NOT NULL DEFAULT 0',
    ];
    foreach ($needed as $col => $def) {
        $r = $conn->query("SHOW COLUMNS FROM billing LIKE '$col'");
        if ($r && $r->num_rows === 0)
            $conn->query("ALTER TABLE billing ADD COLUMN `$col` $def");
    }

    // Create or update billing record
    $existing = $conn->query("SELECT id FROM billing WHERE appointment_id=$res_id");
    if ($existing && $existing->num_rows > 0) {
        $bill_id = $existing->fetch_assoc()['id'];
    } else {
        $conn->query("INSERT INTO billing(appointment_id, total_amount, downpayment_amount, is_boarding, downpayment_status, payment_status)
                      VALUES($res_id, $total, $dp, 1, 'Unpaid', 'Unpaid')");
        $bill_id = $conn->insert_id;
    }

    if ($pay_type === 'downpayment') {
        $conn->query("UPDATE billing SET downpayment_status='Paid', downpayment_amount=$dp, downpayment_paid_at='$now' WHERE id=$bill_id");
        $conn->query("UPDATE boarding_reservations SET status='Approved' WHERE id=$res_id AND user_id=$user_id");
        $_SESSION['message'] = "âœ… Downpayment of â‚±" . number_format($dp, 2) . " confirmed! Your reservation is now approved.";
        $_SESSION['msg_type'] = 'success';
    } else {
        $conn->query("UPDATE billing SET payment_status='Paid', downpayment_status='Paid', downpayment_amount=$dp, downpayment_paid_at='$now' WHERE id=$bill_id");
        $conn->query("UPDATE boarding_reservations SET status='Approved' WHERE id=$res_id AND user_id=$user_id");
        $_SESSION['message'] = "âœ… Full payment of â‚±" . number_format($total, 2) . " confirmed! Your reservation is approved.";
        $_SESSION['msg_type'] = 'success';
    }
    header("Location: boarding.php");
    exit();
}

// â”€â”€ PayMongo Cancel â€” clean up pending reservation â”€â”€
if (isset($_GET['pm_cancelled'])) {
    $res_id = (int) ($_GET['res_id'] ?? 0);
    if ($res_id)
        $conn->query("DELETE FROM boarding_reservations WHERE id=$res_id AND status='Pending' AND user_id=$user_id");
    $_SESSION['message'] = "Payment was cancelled. Your reservation was not confirmed.";
    $_SESSION['msg_type'] = 'warning';
    header("Location: boarding.php");
    exit();
}

// â”€â”€ Book Cage: Create reservation then redirect to demo payment â”€â”€
if (isset($_POST['book_cage'])) {
    $pet = trim($_POST['pet_name']);
    $cage_no = (int) $_POST['cage_number'];
    $date = $_POST['appointment_date'];
    $end_date = $_POST['end_date'];
    $time = $_POST['appointment_time'] ?? '10:00 AM';
    $pay_type = $_POST['payment_type'] ?? 'downpayment';
    $service = 'Pet Boarding Reservation';

    // JS redirect â€” works even if headers already sent
    function js_redirect($url)
    {
        echo '<!DOCTYPE html><html><head>'
            . '<meta http-equiv="refresh" content="0;url=' . htmlspecialchars($url, ENT_QUOTES) . '">'
            . '<script>window.location.replace(' . json_encode($url) . ');</script>'
            . '    <link rel="stylesheet" href="assets/pragmavet.css">
    <link href="assets/global-style.css" rel="stylesheet">
</head><body>    <script src="mousetrail.js"></script>
</body></html>';
        exit();
    }

    // Validate dates
    $days = max(1, round((strtotime($end_date) - strtotime($date)) / 86400));
    if (strtotime($end_date) <= strtotime($date)) {
        $_SESSION['message'] = 'Check-out must be at least 1 day after check-in.';
        $_SESSION['msg_type'] = 'danger';
        js_redirect('boarding.php');
    }

    // Overlap check
    $chk = $conn->prepare("SELECT id FROM boarding_reservations WHERE cage_number=? AND status NOT IN ('Completed','Cancelled','Rejected') AND appointment_date < ? AND end_date > ?");
    $chk->bind_param('iss', $cage_no, $end_date, $date);
    $chk->execute();
    if ($chk->get_result()->num_rows > 0) {
        $_SESSION['message'] = "Cage $cage_no is already booked for those dates.";
        $_SESSION['msg_type'] = 'danger';
        js_redirect('boarding.php');
    }

    // Costs
    $total = round($days * 800, 2);
    $dp = round($total * 0.30, 2);
    $charge = ($pay_type === 'full') ? $total : $dp;
    $label = ($pay_type === 'full')
        ? "Pet Boarding â€” Full Payment ($days day" . ($days > 1 ? 's' : '') . " â€” $pet)"
        : "Pet Boarding â€” 30% Downpayment (Non-Refundable) â€” $pet";

    // Insert reservation as Pending
    $ins = $conn->prepare("INSERT INTO boarding_reservations(user_id, pet_name, service_type, appointment_date, appointment_time, end_date, cage_number, status) VALUES(?,?,?,?,?,?,?,'Pending')");
    $ins->bind_param('isssssi', $user_id, $pet, $service, $date, $time, $end_date, $cage_no);
    if (!$ins->execute()) {
        $_SESSION['message'] = 'Reservation error: ' . $conn->error;
        $_SESSION['msg_type'] = 'danger';
        js_redirect('boarding.php');
    }
    $res_id = $conn->insert_id;

    // Build URLs â€” billing is created AFTER payment succeeds (no billing insert here)
    $domain = (isset($_SERVER['HTTPS']) && $_SERVER['HTTPS'] === 'on' ? 'https' : 'http')
        . '://' . $_SERVER['HTTP_HOST'] . '/pragmavet';
    $success_url = $domain . '/boarding.php?pm_success=' . urlencode($pay_type)
        . '&res_id=' . $res_id . '&total=' . $total . '&dp=' . $dp;
    $cancel_url = $domain . '/boarding.php?pm_cancelled=1&res_id=' . $res_id;

    // In DEMO_MODE go directly to payment_demo.php
    $demo_url = $domain . '/payment_demo.php'
        . '?amount=' . urlencode($charge)
        . '&description=' . urlencode($label)
        . '&success_url=' . urlencode($success_url)
        . '&cancel_url=' . urlencode($cancel_url);

    js_redirect($demo_url);
}

// â”€â”€ Handle Automatic Boarding Reschedule â”€â”€
if (isset($_POST['reschedule_boarding_request'])) {
    $apt_id = (int)$_POST['apt_id'];
    $new_start = $_POST['new_start_date'];
    $new_end = $_POST['new_end_date'];
    $today = date('Y-m-d');

    // 1. Fetch current reservation to check cage and current date
    $curr_q = $conn->prepare("SELECT appointment_date, cage_number FROM boarding_reservations WHERE id=? AND user_id=?");
    $curr_q->bind_param("ii", $apt_id, $user_id);
    $curr_q->execute();
    $curr = $curr_q->get_result()->fetch_assoc();

    if (!$curr) {
        $_SESSION['message'] = "Reservation not found.";
        $_SESSION['msg_type'] = "danger";
    } elseif ($curr['appointment_date'] <= $today) {
        $_SESSION['message'] = "Stays starting today or already in progress cannot be rescheduled.";
        $_SESSION['msg_type'] = "warning";
    } else {
        $cage_no = $curr['cage_number'];
        // 2. Overlap check for NEW dates (excluding self)
        $chk = $conn->prepare("SELECT id FROM boarding_reservations WHERE id != ? AND cage_number=? AND status NOT IN ('Completed','Cancelled','Rejected') AND appointment_date < ? AND end_date > ?");
        $chk->bind_param('iiss', $apt_id, $cage_no, $new_end, $new_start);
        $chk->execute();
        
        if ($chk->get_result()->num_rows > 0) {
            $_SESSION['message'] = "The cage is occupied by another guest during those new dates.";
            $_SESSION['msg_type'] = "danger";
        } else {
            // 3. Update directly
            $stmt = $conn->prepare("UPDATE boarding_reservations SET appointment_date=?, end_date=?, status='Approved', proposed_reschedule_date=NULL, proposed_reschedule_end_date=NULL, client_action_needed=0 WHERE id=? AND user_id=?");
            $stmt->bind_param("ssii", $new_start, $new_end, $apt_id, $user_id);
            if ($stmt->execute()) {
                $_SESSION['message'] = "Reservation successfully updated to new dates!";
                $_SESSION['msg_type'] = "success";
            }
        }
    }
    header("Location: boarding.php");
    exit();
}




// Process Cancellation
if (isset($_POST['cancel_boarding'])) {
    $apt_id = $_POST['apt_id'];
    $stmt = $conn->prepare("SELECT appointment_date FROM boarding_reservations WHERE id=? AND user_id=?");
    $stmt->bind_param("ii", $apt_id, $user_id);
    $stmt->execute();
    $res = $stmt->get_result();
    if ($res->num_rows > 0) {
        $row = $res->fetch_assoc();
        $drop_off = strtotime($row['appointment_date']);
        if (($drop_off - time()) >= 86400) {
            $conn->query("UPDATE boarding_reservations SET status='Cancelled' WHERE id=$apt_id");
            $_SESSION['message'] = "Boarding reservation successfully cancelled.";
            $_SESSION['msg_type'] = "success";
        } else {
            $_SESSION['message'] = "Cancellation failed: Must be completed at least 24 hours prior to drop-off.";
            $_SESSION['msg_type'] = "danger";
        }
    }
    header("Location: boarding.php");
    exit();
}

// Process Extension Request
if (isset($_POST['extend_boarding'])) {
    $apt_id = $_POST['apt_id'];
    $new_end_date = $_POST['new_end_date'];

    $stmt = $conn->prepare("SELECT cage_number, end_date, pet_name FROM boarding_reservations WHERE id=? AND user_id=?");
    $stmt->bind_param("ii", $apt_id, $user_id);
    $stmt->execute();
    $my_apt = $stmt->get_result()->fetch_assoc();

    if ($my_apt && strtotime($new_end_date) > strtotime($my_apt['end_date'])) {
        $old_end = $my_apt['end_date'];
        $curr_cage = $my_apt['cage_number'];
        // Update current appointment to cover extended dates and flag as Pending for approval
        $upd = $conn->prepare("UPDATE boarding_reservations SET end_date=?, status='Pending' WHERE id=?");
        $upd->bind_param("si", $new_end_date, $apt_id);

        if ($upd->execute()) {
            $_SESSION['message'] = "Your extension request to " . date("M d", strtotime($new_end_date)) . " has been sent to the admin for approval.";
            $_SESSION['msg_type'] = "success";
        } else {
            $_SESSION['message'] = "Database Error submitting extension.";
            $_SESSION['msg_type'] = "danger";
        }
    } else {
        $_SESSION['message'] = "Invalid extension date.";
        $_SESSION['msg_type'] = "danger";
    }
    header("Location: boarding.php");
    exit();
}

// Process Reschedule Accept/Decline
if (isset($_POST['accept_reschedule_boarding'])) {
    $apt_id = (int) $_POST['reschedule_apt_id'];
    $stmt = $conn->prepare("UPDATE boarding_reservations SET appointment_date = proposed_reschedule_date, end_date = proposed_reschedule_end_date, status = 'Approved', client_action_needed = 0 WHERE id = ? AND user_id = ?");
    $stmt->bind_param("ii", $apt_id, $user_id);
    if ($stmt->execute()) {
        $_SESSION['message'] = "Reschedule successfully accepted. Your boarding is now Approved for the new dates.";
        $_SESSION['msg_type'] = "success";
        $conn->query("INSERT INTO notifications(user_id, message) VALUES(1, 'Client accepted the BOARDING reschedule proposal for appointment ID $apt_id')");
    }
    header("Location: boarding.php");
    exit();
}

if (isset($_POST['decline_reschedule_boarding'])) {
    $apt_id = (int) $_POST['reschedule_apt_id'];
    $stmt = $conn->prepare("UPDATE boarding_reservations SET status = 'Cancelled', client_action_needed = 0 WHERE id = ? AND user_id = ?");
    $stmt->bind_param("ii", $apt_id, $user_id);
    if ($stmt->execute()) {
        $_SESSION['message'] = "Reschedule declined. Boarding has been permanently cancelled.";
        $_SESSION['msg_type'] = "danger";
        $conn->query("INSERT INTO notifications(user_id, message) VALUES(1, 'Client DECLINED the BOARDING reschedule proposal for appointment ID $apt_id.')");
    }
    header("Location: boarding.php");
    exit();
}

// Fetch Cage Count from settings
$count_q = $conn->query("SELECT setting_value FROM clinic_settings WHERE setting_key = 'boarding_cage_count'");
$cage_count = ($count_q && $count_q->num_rows > 0) ? (int)$count_q->fetch_assoc()['setting_value'] : 5;

// Prepare base cages
$cages = [];
$flatpickr_disable = [];
for($i = 1; $i <= $cage_count; $i++) {
    $cages[$i] = [];
    $flatpickr_disable[$i] = [];
}

// Fetch all active Boarding bookings mapped onto cages
// Fetch all active Boarding bookings mapped onto cages
$sql = "SELECT id, cage_number, user_id, pet_name, appointment_date, end_date, appointment_time, status, service_type, created_at, admin_message, client_action_needed, cctv_link, cctv_enabled 
        FROM boarding_reservations 
        WHERE cage_number IS NOT NULL 
        AND status NOT IN ('Completed', 'Cancelled', 'Rejected')
        AND end_date >= CURDATE()
        ORDER BY appointment_date ASC";
$res = $conn->query($sql);

if ($res && $res->num_rows > 0) {
    while ($row = $res->fetch_assoc()) {
        $cNo = $row['cage_number'];
        if (isset($cages[$cNo])) {
            $cages[$cNo][] = $row;
            $flatpickr_disable[$cNo][] = [
                'from' => $row['appointment_date'],
                'to' => $row['end_date']
            ];
        }
    }
}
