        <!-- CAGE MATRIX -->
        <div class="row g-4 mb-5">
            <?php
            $today_str = date("Y-m-d");
            $today_time = strtotime($today_str);

            for ($i = 1; $i <= $cage_count; $i++):
                $currently_occupied_by = null;
                if (!empty($cages[$i])) {
                    foreach ($cages[$i] as $b) {
                        if (strtotime($b['appointment_date']) <= $today_time && strtotime($b['end_date']) > $today_time) {
                            $currently_occupied_by = [
                                'pet_name' => $b['pet_name'],
                                'user_id' => $b['user_id'],
                                'res_id' => $b['id'],
                                'cctv_link' => $b['cctv_link'] ?? '',
                                'cctv_enabled' => $b['cctv_enabled'] ?? 0,
                                'status' => $b['status']
                            ];
                            break;
                        }
                    }
                }
                ?>
                <div class="col-xl-4 col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden <?php echo $currently_occupied_by ? ($currently_occupied_by['user_id'] == $user_id ? 'border-primary' : 'border-danger') : 'border-success'; ?>"
                        style="border-top: 4px solid <?php echo $currently_occupied_by ? ($currently_occupied_by['user_id'] == $user_id ? '#1E5AA8' : '#dc3545') : '#198754'; ?> !important;">
