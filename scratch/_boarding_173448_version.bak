                        <i class="fa fa-video"></i> Live Feed
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <div id="cctvStreamContainer" class="rounded-3 overflow-hidden shadow-inner"
                        style="background: #000; min-height: 400px;">
                        <!-- Content injected via JS -->
                    </div>
                </div>
                <div class="modal-footer border-0 p-3 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Close
                        Monitor</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script>
        // Theme toggle logic
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');
        const body = document.body;

        if (localStorage.getItem('theme') === 'dark') {
            body.classList.add('dark-mode');
            themeIcon.classList.replace('fa-moon', 'fa-sun');
        }

        themeToggle.addEventListener('click', () => {
            body.classList.toggle('dark-mode');
            if (body.classList.contains('dark-mode')) {
                localStorage.setItem('theme', 'dark');
                themeIcon.classList.replace('fa-moon', 'fa-sun');
            } else {
                localStorage.setItem('theme', 'light');
                themeIcon.classList.replace('fa-sun', 'fa-moon');
            }
        });

        // Setup Flatpickr disable arrays from PHP
        const disabledDatesData = <?php echo json_encode($flatpickr_disable); ?>;

        let fpCheckIn = null;
        let fpCheckOut = null;

        document.getElementById('bookCageModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var cage = button ? button.getAttribute('data-cage') : '';
            document.getElementById('modalCageId').value = cage;
            document.getElementById('priceBox').style.display = 'none';
            document.getElementById('payButtons').style.display = 'none';

            let disableArr = disabledDatesData[cage] || [];

            if (fpCheckIn) fpCheckIn.destroy();
            if (fpCheckOut) fpCheckOut.destroy();

            fpCheckIn = flatpickr("#checkinDate", {
                minDate: "today",
                disable: disableArr,
                dateFormat: "Y-m-d",
                onChange: function (selectedDates) {
                    if (selectedDates.length > 0) {
                        let minOut = new Date(selectedDates[0]);
                        minOut.setDate(minOut.getDate() + 1);
                        fpCheckOut.set("minDate", minOut);
                    }
                    updatePrice();
                }
            });

            fpCheckOut = flatpickr("#checkoutDate", {
                minDate: new Date().fp_incr(1),
                disable: disableArr,
                dateFormat: "Y-m-d",
                onChange: function () { updatePrice(); }
            });
        });

        function updatePrice() {
            var cin = document.getElementById('checkinDate').value;
            var cout = document.getElementById('checkoutDate').value;
            if (!cin || !cout) return;
            var diff = (new Date(cout) - new Date(cin)) / 86400000;
            var days = Math.max(1, Math.round(diff));
            if (days <= 0) return;
            var total = days * 800;
            var dp = Math.round(total * 0.30 * 100) / 100;
            document.getElementById('calcDays').textContent = days + ' day' + (days > 1 ? 's' : '');
            document.getElementById('calcTotal').textContent = 'â‚±' + total.toLocaleString('en-PH', { minimumFractionDigits: 2 });
            document.getElementById('calcDP').textContent = 'â‚±' + dp.toLocaleString('en-PH', { minimumFractionDigits: 2 });
            document.getElementById('btnPayDP').textContent = '';
            document.getElementById('btnPayDP').innerHTML = '<i class="fa fa-shield-halved me-2"></i>Pay Downpayment â‚±' + dp.toLocaleString('en-PH', { minimumFractionDigits: 2 }) + ' (30%) via PayMongo';
            document.getElementById('btnPayFull').innerHTML = '<i class="fa fa-credit-card me-2"></i>Pay Full â‚±' + total.toLocaleString('en-PH', { minimumFractionDigits: 2 }) + ' via PayMongo';
            document.getElementById('priceBox').style.display = 'block';
            document.getElementById('payButtons').style.display = 'block';
        }

        function submitPayment(type) {
            document.getElementById('paymentType').value = type;
            document.getElementById('realSubmitBtn').click();
        }


        // CCTV Modal Logic
        var cctvModal = null;
        function openCctvModal(link, petName, resId) {
            document.getElementById('cctvModalTitle').innerText = 'Live Feed: ' + petName;

            // Auto-normalize: bare port URL (IP Webcam style) â†’ append /video for direct MJPEG stream
            if (/:(8080|4747|8000|8888|1234)\/?$/.test(link)) {
                link = link.replace(/\/?$/, '/video');
            }

            // Detect MJPEG stream
            var isMjpeg = link.indexOf('/video') !== -1
                || link.indexOf('.mjpg') !== -1
                || link.indexOf('.cgi') !== -1
                || link.indexOf('mjpeg') !== -1
                || link.indexOf('videofeed') !== -1;

            var container = document.getElementById('cctvStreamContainer');

            // Build stream element
            var streamInner = '';
            if (isMjpeg) {
                streamInner = '<img src="' + link + '" alt="Live Camera Feed" style="display:block;width:100%;height:100%;object-fit:contain;">';
            } else {
                streamInner = '<iframe src="' + link + '" frameborder="0" scrolling="no" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="display:block;width:100%;height:100%;border:0;overflow:hidden;"></iframe>';
            }

            // Build same layout as admin viewer
            container.innerHTML = '<div style="width:100%;height:50vh;background:#000;border-radius:10px;overflow:hidden;display:flex;align-items:center;justify-content:center;">' + streamInner + '</div>'
                + '<div class="d-flex gap-2 mt-2">'

                + '<a href="camera_view.php?id=' + resId + '" target="_blank" class="btn btn-danger btn-sm flex-fill fw-bold"><i class="fa fa-expand me-1"></i> Fullscreen</a>'
                + '</div>';

            if (!cctvModal) {
                cctvModal = new bootstrap.Modal(document.getElementById('cctvModal'));
            }
            cctvModal.show();
        }
        function closeCctvModal() {
            document.getElementById('cctvStreamContainer').innerHTML = ''; // Stop video/stream
        }

        // Boarding Detail Logic
        let boardingDetailModal = null;
        let boardingRescheduleModal = null;
        let reschedFpStart = null;
        let reschedFpEnd = null;

        function openBoardingDetail(data) {
            document.getElementById('detPetName').innerText = data.pet_name;
            document.getElementById('detCheckIn').innerText = new Date(data.appointment_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            document.getElementById('detCheckOut').innerText = new Date(data.end_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            document.getElementById('detCreated').innerText = new Date(data.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            
            const badge = document.getElementById('detStatus');
            badge.innerText = data.status;
            badge.className = 'badge rounded-pill ' + (data.status === 'Approved' ? 'bg-success' : (data.status === 'Pending' ? 'bg-warning text-dark' : 'bg-primary'));

            const actionArea = document.getElementById('boardingActionArea');
            actionArea.innerHTML = '';
            
            const today = new Date();
            today.setHours(0,0,0,0);
            const startDate = new Date(data.appointment_date);
            startDate.setHours(0,0,0,0);

            if (startDate > today && (data.status === 'Approved' || data.status === 'Pending')) {
                actionArea.innerHTML = `
                    <button class="btn btn-primary rounded-pill py-3 fw-bold" onclick="openBoardingReschedule(${data.id}, ${data.cage_number})">
                        <i class="fa fa-sync me-2"></i> Instant Reschedule
                    </button>
                    <p class="text-center text-muted small mt-2 m-0">Instant update & free of charge</p>
                `;
            } else if (startDate <= today) {
                actionArea.innerHTML = `
                    <div class="alert alert-secondary border-0 rounded-4 small text-center mb-0">
                        <i class="fa fa-lock me-1"></i> Rescheduling is disabled for stays starting today or already in progress.
                    </div>
                `;
            }

            if (!boardingDetailModal) boardingDetailModal = new bootstrap.Modal(document.getElementById('boardingDetailModal'));
            boardingDetailModal.show();
        }

        function openBoardingReschedule(id, cage) {
            if (boardingDetailModal) boardingDetailModal.hide();
            
            document.getElementById('reschedAptId').value = id;
            
            let disableArr = disabledDatesData[cage] || [];
            
            if (reschedFpStart) reschedFpStart.destroy();
            if (reschedFpEnd) reschedFpEnd.destroy();

            reschedFpStart = flatpickr("#reschedStart", {
                minDate: "today",
                disable: disableArr,
                dateFormat: "Y-m-d",
                onChange: function(selectedDates) {
                    if (selectedDates.length > 0) {
                        let minOut = new Date(selectedDates[0]);
                        minOut.setDate(minOut.getDate() + 1);
                        reschedFpEnd.set("minDate", minOut);
                    }
                }
            });

            reschedFpEnd = flatpickr("#reschedEnd", {
                minDate: new Date().fp_incr(1),
                disable: disableArr,
                dateFormat: "Y-m-d"
            });

            if (!boardingRescheduleModal) boardingRescheduleModal = new bootstrap.Modal(document.getElementById('boardingRescheduleModal'));
            boardingRescheduleModal.show();
        }

        document.getElementById('cctvModal').addEventListener('hidden.bs.modal', function () {
            closeCctvModal();
        });
    </script>
    <script src="mousetrail.js"></script>
</body>