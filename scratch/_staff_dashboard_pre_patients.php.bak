        <script>
        const STAFF_CALENDAR_EVENTS = <?= json_encode($calendar_events) ?>;

        window.triggerModal = function(id, title, client, pet, service, time, status, created, approved, dateStr) {
            var found = STAFF_CALENDAR_EVENTS.find(function(e) { return e.appt_id == id; });
            if (found && typeof openAppointmentDetails === 'function') {
                openAppointmentDetails({
                    id: found.appt_id,
                    pet_name: found.pet,
                    owner_name: found.owner,
                    contact_number: found.contact || 'N/A',
                    service_type: found.type,
                    appointment_date: found.raw_date,
                    formatted_date: new Date(found.raw_date + 'T12:00:00').toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }),
                    appointment_time: found.time,
                    raw_time: found.raw_time,
                    status: found.status,
                    doctor_id: found.doctorId,
                    doctor_name: found.doctor,
                    admin_message: found.notes
                });
            }
        };

        function openAppointmentDetails(data) {
            document.getElementById('mPetName').textContent = data.pet_name;
            document.getElementById('mService').textContent = data.service_type;
            document.getElementById('mOwnerName').textContent = data.owner_name;
            document.getElementById('mPhone').textContent = data.contact_number;
            document.getElementById('mDateTime').textContent = data.formatted_date + ' at ' + data.appointment_time;
            document.getElementById('mDoctorName').textContent = data.doctor_name || 'Unassigned';

            // Status badge
            var badgeEl = document.getElementById('mStatusBadge');
            badgeEl.className = 'badge-status';
            var st = data.status;
            if (st === 'Approved') badgeEl.className += ' status-approved';
            else if (st === 'Checked In') badgeEl.className += ' status-checked-in';
            else if (st === 'In Progress') badgeEl.className += ' status-in-progress';
            else if (st === 'Completed') badgeEl.className += ' status-completed';
            else if (st === 'Pending') badgeEl.className += ' status-pending';
            else badgeEl.className += ' status-cancelled';
            badgeEl.textContent = st;

            // Audit
            var auditWrap = document.getElementById('mAuditWrap');
            if (data.admin_message) {
                auditWrap.style.display = 'block';
                document.getElementById('mAuditNote').textContent = data.admin_message;
            } else {
                auditWrap.style.display = 'none';
            }

            // Populate forms
            document.getElementById('assignAptId').value = data.id;
            document.getElementById('assignDoctorSelect').value = data.doctor_id || '';
            document.getElementById('reschedAptId').value = data.id;
            document.getElementById('reschedDate').value = data.appointment_date;
            document.getElementById('reschedTime').value = data.raw_time;

            // Action buttons
            var btnContainer = document.getElementById('statusActionButtons');
            btnContainer.innerHTML = '';

            if (st === 'Pending') {
                btnContainer.innerHTML += `
                    <form method="POST">
                        <input type="hidden" name="action" value="accept_appointment">
                        <input type="hidden" name="apt_id" value="${data.id}">
                        <input type="hidden" name="redirect_tab" value="calendar">
                        <button type="submit" class="btn btn-success w-100 fw-bold py-2"><i class="fa fa-check me-1"></i> Accept & Confirm Appointment</button>
                    </form>
                    <button type="button" class="btn btn-outline-danger w-100 fw-bold py-2" onclick="showRejectInput()"><i class="fa fa-times me-1"></i> Decline / Cancel</button>
                    <div id="inlineRejectForm" style="display:none;" class="mt-2">
                        <form method="POST">
                            <input type="hidden" name="action" value="reject_appointment">
                            <input type="hidden" name="apt_id" value="${data.id}">
                            <input type="hidden" name="redirect_tab" value="calendar">
                            <input type="text" name="reject_reason" class="form-control form-control-sm mb-2" placeholder="Reason for decline..." required>
                            <button type="submit" class="btn btn-danger btn-sm w-100">Confirm Reject</button>
                        </form>
                    </div>
                `;
            } else if (st === 'Approved') {
                btnContainer.innerHTML += `
                    <form method="POST">
                        <input type="hidden" name="action" value="update_status">
                        <input type="hidden" name="apt_id" value="${data.id}">
                        <input type="hidden" name="new_status" value="Checked In">
                        <input type="hidden" name="redirect_tab" value="calendar">
                        <button type="submit" class="btn btn-primary w-100 fw-bold py-2"><i class="fa fa-door-open me-1"></i> Check In Patient (Arrived at Front Desk)</button>
                    </form>
                `;
            } else if (st === 'Checked In' || st === 'In Progress') {
                btnContainer.innerHTML += `
                    <a href="staff_dashboard.php?tab=appointments&filter=all&open=${data.id}" class="btn btn-success w-100 fw-bold py-2">
                        <i class="fa fa-file-invoice-dollar me-1"></i> List Services, Issue Invoice &amp; Complete
                    </a>
                `;
            }

            // Always allow No Show toggle if not completed
            if (st === 'Pending' || st === 'Approved') { // only before check-in
                btnContainer.innerHTML += `
                    <form method="POST" id="noShowForm_cal_${data.id}">
                        <input type="hidden" name="action" value="update_status">
                        <input type="hidden" name="apt_id" value="${data.id}">
                        <input type="hidden" name="new_status" value="No Show">
                        <input type="hidden" name="redirect_tab" value="calendar">
                        <button type="button" class="btn btn-outline-secondary w-100 btn-sm" onclick="pragmaConfirm('Mark this patient as No Show?', 'This will update the appointment status to No Show.', 'warning', function(){ document.getElementById('noShowForm_cal_${data.id}').submit(); })">
                            <i class="fa fa-user-slash me-1"></i> Mark No Show
                        </button>
                    </form>
                `;
            }

            var modal = new bootstrap.Modal(document.getElementById('calendarApptModal'));
            modal.show();
        }

        function showRejectInput() {
            var el = document.getElementById('inlineRejectForm');
            el.style.display = (el.style.display === 'none') ? 'block' : 'none';
        }
        </script>
    <?php endif; ?>

