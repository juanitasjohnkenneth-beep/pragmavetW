<div class="modal fade" id="pragmaConfirmModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false" style="z-index:99999;background:rgba(15,23,42,.35);">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px; z-index: 9999;">
        <div class="modal-content" style="border-radius:20px; overflow:hidden; border:none; box-shadow: 0 20px 60px rgba(0,0,0,0.2);">
            <div id="pragmaConfirmStripe" style="height:5px; background:linear-gradient(90deg,#dc2626,#ef4444);"></div>
            <div class="modal-body p-4">
                <div class="d-flex align-items-start gap-3 mb-4">
                    <div id="pragmaConfirmIconWrap"
                         style="width:52px;height:52px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;background:rgba(220,38,38,.1);color:#dc2626;">
                        <i id="pragmaConfirmIcon" class="fa fa-exclamation-triangle"></i>
                    </div>
                    <div>
                        <h5 id="pragmaConfirmTitle" class="fw-bold mb-1" style="font-size:16px;color:#1e293b;"></h5>
                        <p id="pragmaConfirmMessage" class="text-muted mb-0" style="font-size:13.5px;line-height:1.55;"></p>
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-end">
                    <button type="button" class="btn btn-light fw-semibold px-4 rounded-pill" data-bs-dismiss="modal" style="font-size:13.5px;border:1px solid #e2e8f0;">
                        <i class="fa fa-times me-1 opacity-50"></i> Cancel
                    </button>
                    <button type="button" id="pragmaConfirmOkBtn" class="btn fw-bold px-4 rounded-pill btn-danger" style="font-size:13.5px;">
                        <i class="fa fa-check me-1"></i> <span id="pragmaConfirmOkLabel">Confirm</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
        // ── Services availed builder (Appointment Requests → Complete) ──
        function svcBox(id) { return document.getElementById('svcBox' + id); }
        function svcTotal(id) {
            const box = svcBox(id); if (!box) return;
            let t = 0;
            box.querySelectorAll('.svc-row').forEach(r => {
                t += (parseFloat(r.querySelector('[name="svc_qty[]"]').value) || 0) * (parseFloat(r.querySelector('[name="svc_price[]"]').value) || 0);
            });
            // Declared medicines are billed too
            const mb = document.getElementById('medBox' + id);
            if (mb) mb.querySelectorAll('.med-row').forEach(r => {
                if (!r.querySelector('[name="med_id[]"]').value) return;
                t += (parseFloat(r.querySelector('[name="med_qty[]"]').value) || 0) * (parseFloat(r.querySelector('[name="med_price[]"]').value) || 0);
            });
            box.querySelector('.svc-total').textContent = t.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            box.dataset.total = t;
            payChange(id);
        }
        // Balance after the reservation fee credit
        function payDue(id) {
            const box = svcBox(id);
            return box ? Math.max(0, (parseFloat(box.dataset.total) || 0) - (parseFloat(box.dataset.credit) || 0)) : 0;
        }
        function payMode(id) {
            const pb = document.getElementById('payBox' + id); if (!pb) return;
            const cash = pb.querySelector('input[name="pay_now"][value="cash"]').checked;
            pb.querySelector('.cash-fields').style.display = cash ? '' : 'none';
            const inp = pb.querySelector('[name="cash_tendered"]');
            inp.required = cash;
            if (cash && !inp.value) inp.value = payDue(id).toFixed(2);
            payChange(id);
        }
        function payChange(id) {
            const pb = document.getElementById('payBox' + id); if (!pb) return;
            const due = payDue(id);
            const got = parseFloat(pb.querySelector('[name="cash_tendered"]').value) || 0;
            const fmt = v => v.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            pb.querySelector('.cash-due').textContent = fmt(due);
            const ch = pb.querySelector('.cash-change');
            ch.textContent = got >= due ? fmt(got - due) : 'Short ₱' + fmt(due - got);
            ch.style.color = got >= due ? '#15803d' : '#dc2626';
        }
        function svcPick(sel) {
            const opt = sel.options[sel.selectedIndex];
            const row = sel.closest('.svc-row');
            row.querySelector('[name="svc_price[]"]').value = parseFloat(opt.dataset.price || 0).toFixed(2);
            svcTotal(sel.closest('.svc-box').id.replace('svcBox', ''));
        }
        function svcAddRow(id) {
            const box = svcBox(id);
            const first = box.querySelector('.svc-row');
            const row = first.cloneNode(true);
            row.querySelector('[name="svc_qty[]"]').value = 1;
            const sel = row.querySelector('select');
            sel.selectedIndex = 0;
            box.querySelector('.svc-rows').appendChild(row);
            svcPick(sel);
        }
        function svcRemove(btn, id) {
            const rows = svcBox(id).querySelectorAll('.svc-row');
            if (rows.length <= 1) { alert('At least one service is required.'); return; }
            btn.closest('.svc-row').remove();
            svcTotal(id);
        }
        // ── Medicines used ──
        function medPick(sel) {
            const opt = sel.options[sel.selectedIndex];
            const row = sel.closest('.med-row');
            const qty = row.querySelector('[name="med_qty[]"]');
            const price = row.querySelector('[name="med_price[]"]');
            if (sel.value) {
                qty.max = opt.dataset.stock;
                if (!qty.value) qty.value = 1;
                price.value = parseFloat(opt.dataset.price || 0).toFixed(2);
                qty.required = true;
            } else { qty.value = ''; price.value = ''; qty.required = false; qty.removeAttribute('max'); }
            svcTotal(sel.closest('.med-box').id.replace('medBox', ''));
        }
        function medAddRow(id) {
            const box = document.getElementById('medBox' + id);
            const row = box.querySelector('.med-row').cloneNode(true);
            row.querySelector('select').selectedIndex = 0;
            row.querySelectorAll('input').forEach(i => { i.value = ''; i.required = false; i.removeAttribute('max'); });
            box.querySelector('.med-rows').appendChild(row);
        }
        function medRemove(btn, id) {
            const rows = document.getElementById('medBox' + id).querySelectorAll('.med-row');
            const row = btn.closest('.med-row');
            if (rows.length <= 1) { row.querySelector('select').selectedIndex = 0; medPick(row.querySelector('select')); return; }
            row.remove();
            svcTotal(id);
        }
        function medCheck(id) {
            const box = document.getElementById('medBox' + id); if (!box) return '';
            for (const r of box.querySelectorAll('.med-row')) {
                const sel = r.querySelector('[name="med_id[]"]'); if (!sel.value) continue;
                const q = parseInt(r.querySelector('[name="med_qty[]"]').value, 10) || 0;
                const stock = parseInt(sel.options[sel.selectedIndex].dataset.stock, 10) || 0;
                const name = sel.options[sel.selectedIndex].text.split(' — ')[0].trim();
                if (q < 1) return 'Enter the quantity used for ' + name + '.';
                if (q > stock) return 'Only ' + stock + ' ' + name + ' left in stock.';
            }
            return '';
        }

        function svcValidate(id, btn) {
            const box = svcBox(id);
            if (!box || !box.querySelector('.svc-row')) { pragmaConfirm('No services listed', 'Add at least one service availed before completing.', 'warning', null); return false; }
            const form = btn ? btn.closest('form') : box.closest('form');
            const medErr = medCheck(id);
            if (medErr) { pragmaConfirm('Check medicines used', medErr, 'warning', null); return false; }
            const pb = document.getElementById('payBox' + id);
            const cash = pb && pb.querySelector('input[name="pay_now"][value="cash"]').checked;
            const due = payDue(id);
            const got = cash ? (parseFloat(pb.querySelector('[name="cash_tendered"]').value) || 0) : 0;
            if (cash && due > 0 && got < due) {
                pragmaConfirm('Cash is short', 'Cash received (₱' + got.toFixed(2) + ') is less than the balance due (₱' + due.toFixed(2) + ').', 'warning', null);
                return false;
            }
            pragmaConfirm(cash ? 'Complete & record cash payment?' : 'Issue invoice & complete?',
                cash
                    ? 'Invoice <strong>₱' + box.querySelector('.svc-total').textContent + '</strong>, cash received <strong>₱' + got.toFixed(2) + '</strong>' + (got > due ? ', change <strong>₱' + (got - due).toFixed(2) + '</strong>' : '') + '. The invoice will be marked <strong>Paid</strong> and the receipt will open for printing.'
                    : 'The client will be billed <strong>₱' + box.querySelector('.svc-total').textContent + '</strong> for the services availed and this appointment will be marked <strong>Completed</strong>.',
                'success', function () { form.submit(); });
            return false;
        }
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.svc-box').forEach(b => svcTotal(b.id.replace('svcBox', '')));
            // ?open=<id> (from the calendar) opens that appointment's details
            const openId = new URLSearchParams(location.search).get('open');
            const m = openId && document.getElementById('apptDetailModal' + parseInt(openId));
            if (m && window.bootstrap) bootstrap.Modal.getOrCreateInstance(m).show();
        });

</script>
<script>
// ── pragmaConfirm ──────────────────────────────────────────────────────────
(function() {
    var _cb = null, _modal = null;
    var palettes = {
        danger:  { stripe:'linear-gradient(90deg,#dc2626,#ef4444)', iconBg:'rgba(220,38,38,.1)', iconColor:'#dc2626', btn:'btn-danger',  icon:'fa-exclamation-triangle', label:'Yes, Confirm' },
        warning: { stripe:'linear-gradient(90deg,#d97706,#f59e0b)', iconBg:'rgba(217,119,6,.1)',  iconColor:'#d97706', btn:'btn-warning', icon:'fa-exclamation-circle',  label:'Yes, Proceed'  },
        success: { stripe:'linear-gradient(90deg,#16a34a,#22c55e)', iconBg:'rgba(22,163,74,.1)',  iconColor:'#16a34a', btn:'btn-success', icon:'fa-file-invoice-dollar',  label:'Yes, Issue Invoice' },
        info:    { stripe:'linear-gradient(90deg,#2563eb,#3b82f6)', iconBg:'rgba(37,99,235,.1)',  iconColor:'#2563eb', btn:'btn-primary', icon:'fa-info-circle',          label:'OK'            },
    };
    window.pragmaConfirm = function(title, message, type, callback) {
        var p = palettes[type] || palettes.danger;
        document.getElementById('pragmaConfirmStripe').style.background    = p.stripe;
        document.getElementById('pragmaConfirmIconWrap').style.background  = p.iconBg;
        document.getElementById('pragmaConfirmIconWrap').style.color       = p.iconColor;
        document.getElementById('pragmaConfirmIcon').className             = 'fa ' + p.icon;
        document.getElementById('pragmaConfirmTitle').textContent          = title;
        document.getElementById('pragmaConfirmMessage').innerHTML          = message;
        document.getElementById('pragmaConfirmOkLabel').textContent        = p.label;
        var btn = document.getElementById('pragmaConfirmOkBtn');
        btn.className = 'btn fw-bold px-4 rounded-pill ' + p.btn;
        _cb = callback;
        if (!_modal) _modal = new bootstrap.Modal(document.getElementById('pragmaConfirmModal'));
        _modal.show();
    };
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('pragmaConfirmOkBtn').addEventListener('click', function() {
            if (_modal) _modal.hide();
            if (typeof _cb === 'function') setTimeout(_cb, 200);
        });
    });
})();
</script>
</body>
</html>
