                                            <span class="badge bg-secondary">Unassigned</span>
                                        <?php endif; ?>
                                    </td>
                                    <td>
                                        <span class="badge-status <?= ($b['status'] === 'Approved') ? 'status-approved' : (($b['status'] === 'Pending') ? 'status-pending' : 'status-completed') ?>">
