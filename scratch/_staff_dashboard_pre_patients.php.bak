                                            </button>
                                        <?php elseif ($b['status'] === 'Approved'): ?>
                                            <form method="POST" class="d-inline">
                                                <input type="hidden" name="action" value="update_boarding_status">
                                                <input type="hidden" name="b_id" value="<?= $b['id'] ?>">
                                                <input type="hidden" name="b_status" value="Checked In">
                                                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fa fa-sign-in-alt me-1"></i> Check In</button>
                                            </form>
                                        <?php elseif ($b['status'] === 'Checked In'): ?>
                                            <form method="POST" class="d-inline">
                                                <input type="hidden" name="action" value="update_boarding_status">
