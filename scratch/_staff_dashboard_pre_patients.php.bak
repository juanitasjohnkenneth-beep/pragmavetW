        <script>
        // Appointment Requests: live search + status chips (client-side, on the rows already loaded)
        (function () {
            const rows = [...document.querySelectorAll('#arBody .ar-row')];
            if (!rows.length) return;
            const groups = [
                ['All', () => true],
                ['Pending', s => s === 'Pending'],
                ['Approved', s => s === 'Approved'],
                ['Checked In', s => s === 'Checked In' || s === 'In Progress'],
                ['Reschedule', s => s.indexOf('Reschedule') === 0],
                ['Completed', s => s === 'Completed'],
                ['Cancelled / No Show', s => s === 'Cancelled' || s === 'Rejected' || s === 'No Show'],
            ];
            let active = 0;
            const chips = document.getElementById('arChips');
            groups.forEach(([label, test], i) => {
                const count = rows.filter(r => test(r.dataset.status)).length;
                if (i > 0 && count === 0) return;
                const b = document.createElement('button');
                b.type = 'button';
                b.className = 'ar-chip' + (i === 0 ? ' on' : '');
                b.innerHTML = label + ' <span>' + count + '</span>';
                b.onclick = () => { active = i; chips.querySelectorAll('.ar-chip').forEach(c => c.classList.toggle('on', c === b)); apply(); };
                chips.appendChild(b);
            });
            const search = document.getElementById('arSearch');
            function apply() {
                const q = search.value.trim().toLowerCase();
                let shown = 0;
                rows.forEach(r => {
                    const ok = groups[active][1](r.dataset.status) && (!q || r.dataset.search.includes(q));
                    r.style.display = ok ? '' : 'none';
                    if (ok) shown++;
                });
                document.getElementById('arEmpty').style.display = shown ? 'none' : 'block';
            }
            search.addEventListener('input', apply);
            rows.forEach(r => r.addEventListener('keydown', e => { if (e.key === 'Enter') r.click(); }));
        })();
        </script>
