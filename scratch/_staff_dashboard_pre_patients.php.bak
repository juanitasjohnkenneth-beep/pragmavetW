                                                </div>
                                                <div class="col-2"><input type="number" name="svc_qty[]" class="form-control form-control-sm" min="1" value="<?= max(1, $p_qty) ?>" oninput="svcTotal(<?= $apt['id'] ?>)" title="Quantity"></div>
                                                <div class="col-3"><input type="number" name="svc_price[]" class="form-control form-control-sm" min="0" step="0.01" value="<?= number_format($p_price, 2, '.', '') ?>" oninput="svcTotal(<?= $apt['id'] ?>)" title="Price (₱)"></div>
                                                <div class="col-1 text-end"><button type="button" class="btn btn-sm text-danger p-0" onclick="svcRemove(this, <?= $apt['id'] ?>)" title="Remove"><i class="fa fa-times-circle"></i></button></div>
