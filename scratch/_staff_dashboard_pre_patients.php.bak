            <h6 class="fw-bold text-dark mb-2"><i class="fa fa-th-large me-1 text-primary"></i> Real-Time Cage Allocation (Cages 1 - 12)</h6>
            <?php
            $active_cages = [];
            $c_res = $conn->query("SELECT cage_number, pet_name, end_date FROM boarding_reservations WHERE status IN ('Approved', 'Checked In') AND cage_number > 0");
            while ($cr = $c_res->fetch_assoc()) {
                $active_cages[$cr['cage_number']] = $cr;
            }
            ?>
            <div class="cage-grid mb-4">
                <?php for ($i = 1; $i <= 12; $i++): ?>
                    <?php if (isset($active_cages[$i])): ?>
                        <div class="cage-slot occupied">
                            <div class="fw-bold text-danger"><i class="fa fa-lock me-1"></i> Cage #<?= $i ?></div>
                            <small class="fw-bold text-dark d-block text-truncate"><?= htmlspecialchars($active_cages[$i]['pet_name']) ?></small>
                            <span class="badge bg-danger bg-opacity-25 text-danger" style="font-size: 10px;">Occupied</span>
                        </div>
                    <?php else: ?>
                        <div class="cage-slot vacant">
                            <div class="fw-bold text-success"><i class="fa fa-door-open me-1"></i> Cage #<?= $i ?></div>
                            <small class="text-muted d-block">Available</small>
                            <span class="badge bg-success bg-opacity-25 text-success" style="font-size: 10px;">Vacant</span>
                        </div>
                    <?php endif; ?>
                <?php endfor; ?>
            </div>

            <!-- Boarding Requests & Active Reservations -->
            <?php
            $b_res = $conn->query("
                SELECT b.*, u.fullname as owner_name, u.contact_number
