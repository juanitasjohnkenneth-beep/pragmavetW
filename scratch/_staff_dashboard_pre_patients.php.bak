                                        <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-1" style="font-size:13px;">
                                            <span class="text-muted">Qty · Price each (₱). <?= ($apt['downpayment_status'] ?? '') === 'Paid' ? 'Reservation fee ₱' . number_format((float)$apt['downpayment_amount'], 2) . ' will be deducted.' : '' ?></span>
                                            <span class="fw-bold">Total: ₱<span class="svc-total">0.00</span></span>
                                        </div>
                                    </div>
                                    <div class="p-3 mb-3 rounded-3 border med-box" id="medBox<?= $apt['id'] ?>" style="background:#f8fafc;">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <label class="fw-bold m-0 text-primary" style="font-size:12px;"><i class="fa fa-pills me-1"></i> Medicines Used (deducted from inventory)</label>
                                            <button type="button" class="btn btn-sm btn-link text-decoration-none fw-semibold p-0" onclick="medAddRow(<?= $apt['id'] ?>)"><i class="fa fa-plus me-1"></i>Add medicine</button>
                                        </div>
                                        <div class="med-rows">
                                            <div class="row g-2 align-items-center mb-2 med-row">
                                                <div class="col-6">
                                                    <select name="med_id[]" class="form-select form-select-sm" onchange="medPick(this)">
                                                        <option value="" data-price="0" data-stock="0">-- No medicine used --</option>
                                                        <?php foreach ($inventory_items as $inv):
                                                            $inv_exp = !empty($inv['expiry_date']) && $inv['expiry_date'] !== '1970-01-01' && $inv['expiry_date'] < date('Y-m-d'); ?>
                                                            <option value="<?= $inv['id'] ?>" data-price="<?= (float)$inv['price_per_unit'] ?>" data-stock="<?= (int)$inv['quantity'] ?>" <?= $inv_exp ? 'disabled' : '' ?>>
                                                                <?= htmlspecialchars($inv['item_name']) ?> — <?= (int)$inv['quantity'] ?> <?= htmlspecialchars($inv['unit_of_measure'] ?? 'pc') ?> left<?= $inv_exp ? ' (EXPIRED)' : '' ?><?= (float)$inv['price_per_unit'] > 0 ? ' · ₱' . number_format($inv['price_per_unit'], 2) : '' ?>
                                                            </option>
                                                        <?php endforeach; ?>
                                                    </select>
                                                </div>
                                                <div class="col-2"><input type="number" name="med_qty[]" class="form-control form-control-sm" min="1" placeholder="Qty" oninput="svcTotal(<?= $apt['id'] ?>)" title="Quantity used"></div>
                                                <div class="col-3"><input type="number" name="med_price[]" class="form-control form-control-sm" min="0" step="0.01" placeholder="Price" oninput="svcTotal(<?= $apt['id'] ?>)" title="Price each (₱)"></div>
                                                <div class="col-1 text-end"><button type="button" class="btn btn-sm text-danger p-0" onclick="medRemove(this, <?= $apt['id'] ?>)" title="Remove"><i class="fa fa-times-circle"></i></button></div>
                                            </div>
                                        </div>
                                        <div class="text-muted" style="font-size:11.5px;"><i class="fa fa-circle-info me-1"></i>Declare every medicine given. Expired items can't be selected; quantity can't exceed stock. Medicines are added to the invoice.</div>
                                    </div>
                                    <button type="submit" class="btn btn-success w-100 fw-bold py-2" onclick="return svcValidate(<?= $apt['id'] ?>, this);"><i class="fa fa-file-invoice-dollar me-2"></i> Issue Invoice &amp; Mark Completed</button>
                                </form>
                            <?php elseif ($s === 'Completed'):
                                $bill = $conn->query("SELECT * FROM billing WHERE appointment_id = " . (int)$apt['id'] . " AND is_boarding = 0 AND COALESCE(payment_status,'') <> 'Void' ORDER BY id DESC LIMIT 1")->fetch_assoc();
                                if ($bill):
                                    $b_items  = json_decode($bill['items_json'] ?? '', true) ?: [];
                                    $b_credit = $bill['downpayment_status'] === 'Paid' ? (float)$bill['downpayment_amount'] : 0;
                                    $b_bal    = $bill['payment_status'] === 'Paid' ? 0 : max(0, (float)$bill['total_amount'] - $b_credit);
                                    $b_paid   = $bill['payment_status'] === 'Paid'; ?>
                                <div class="p-3 rounded-3 border" style="background:#f8fafc;">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold" style="font-size:13px;"><i class="fa fa-file-invoice me-1 text-primary"></i> Invoice <?= htmlspecialchars($bill['invoice_no'] ?: '#' . $bill['id']) ?></span>
                                        <span class="badge-status <?= $b_paid ? 'status-completed' : 'status-pending' ?>"><?= $b_paid ? 'Paid' : 'Awaiting Payment' ?></span>
                                    </div>
                                    <table class="table table-sm mb-2" style="font-size:12.5px;">
                                        <?php foreach ($b_items as $it): ?>
                                        <tr><td><?= htmlspecialchars($it['name'] ?? '') ?> <span class="text-muted">× <?= (int)($it['qty'] ?? 1) ?></span></td><td class="text-end">₱<?= number_format(($it['qty'] ?? 1) * ($it['price'] ?? 0), 2) ?></td></tr>
                                        <?php endforeach; ?>
                                        <tr class="fw-bold"><td>Total</td><td class="text-end">₱<?= number_format($bill['total_amount'], 2) ?></td></tr>
                                        <?php if ($b_credit > 0): ?><tr class="text-muted"><td>Less reservation fee</td><td class="text-end">− ₱<?= number_format($b_credit, 2) ?></td></tr><?php endif; ?>
                                        <tr class="fw-bold <?= $b_paid ? 'text-success' : 'text-danger' ?>"><td><?= $b_paid ? 'Paid' . ($bill['payment_method'] ? ' via ' . htmlspecialchars($bill['payment_method']) : '') : 'Balance Due' ?></td><td class="text-end">₱<?= number_format($b_paid ? max(0, (float)$bill['total_amount'] - $b_credit) : $b_bal, 2) ?></td></tr>
                                    </table>
                                    <?php if ($b_paid): ?>
                                        <a href="staff_receipt.php?bill=<?= (int)$bill['id'] ?>" target="_blank" class="btn btn-success w-100 fw-bold py-2"><i class="fa fa-print me-2"></i> Print Receipt</a>
                                    <?php else: ?>
                                        <p class="small text-muted mb-2"><i class="fa fa-circle-info me-1"></i>The client was notified and can pay online in Billing. If they pay at the front desk, record it here.</p>
                                        <form method="POST" class="row g-2 align-items-end" onsubmit="var f=this; pragmaConfirm('Record payment?', 'Record <strong>₱' + parseFloat(f.amount_tendered.value || 0).toFixed(2) + '</strong> received via ' + f.payment_method.value + ' and open the receipt for printing.', 'info', function(){ f.submit(); }); return false;">
                                            <input type="hidden" name="action" value="record_payment">
                                            <input type="hidden" name="bill_id" value="<?= (int)$bill['id'] ?>">
                                            <div class="col-4"><label class="text-muted fw-bold" style="font-size:10px;">Method</label>
                                                <select name="payment_method" class="form-select form-select-sm"><option>Cash</option><option>GCash</option><option>Card</option></select></div>
                                            <div class="col-4"><label class="text-muted fw-bold" style="font-size:10px;">Amount Received (₱)</label>
                                                <input type="number" name="amount_tendered" class="form-control form-control-sm" min="<?= number_format($b_bal, 2, '.', '') ?>" step="0.01" value="<?= number_format($b_bal, 2, '.', '') ?>" required></div>
                                            <div class="col-4"><label class="text-muted fw-bold" style="font-size:10px;">Reference # (optional)</label>
                                                <input type="text" name="reference_no" class="form-control form-control-sm" maxlength="100"></div>
                                            <div class="col-12"><button type="submit" class="btn btn-primary w-100 fw-bold py-2"><i class="fa fa-cash-register me-2"></i> Record Payment &amp; Print Receipt</button></div>
                                        </form>
                                    <?php endif; ?>
                                </div>
                                <?php else: ?>
                                <p class="small text-muted mb-0"><i class="fa fa-circle-info me-1"></i>No invoice was issued for this appointment.</p>
                                <?php endif; ?>
                            <?php endif; ?>

                            <?php if (in_array($s, ['Pending', 'Approved'])): // Reschedule / No Show only before check-in ?>
                                <form method="POST" class="border rounded-3 p-3 mt-1" style="background:#fff8f0;">
                                    <input type="hidden" name="action" value="reschedule_appointment">
                                    <input type="hidden" name="apt_id" value="<?= $apt['id'] ?>">
                                    <input type="hidden" name="redirect_tab" value="appointments">
                                    <label class="fw-bold text-warning mb-2 d-block" style="font-size:11px;"><i class="fa fa-calendar-alt me-1"></i> Reschedule Appointment</label>
                                    <div class="row g-2 mb-2">
                                        <div class="col-6">
                                            <input type="date" name="new_date" class="form-control form-control-sm" min="<?= date('Y-m-d') ?>" value="<?= $apt['appointment_date'] ?>" required>
                                        </div>
                                        <div class="col-6">
                                            <input type="time" name="new_time" class="form-control form-control-sm" value="<?= $apt['appointment_time'] ?>" required>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-warning w-100 btn-sm fw-bold"><i class="fa fa-sync me-1"></i> Reschedule &amp; Notify Client</button>
                                </form>
                                <form method="POST" id="noShowForm_<?= $apt['id'] ?>">
                                    <input type="hidden" name="action" value="update_status">
                                    <input type="hidden" name="apt_id" value="<?= $apt['id'] ?>">
                                    <input type="hidden" name="new_status" value="No Show">
                                    <input type="hidden" name="redirect_tab" value="appointments">
                                    <button type="button" class="btn btn-outline-secondary w-100 btn-sm" onclick="pragmaConfirm('Mark this patient as No Show?', 'This will update the appointment status to No Show.', 'warning', function(){ document.getElementById('noShowForm_<?= $apt['id'] ?>').submit(); })">
                                        <i class="fa fa-user-slash me-1"></i> Mark as No Show
                                    </button>
                                </form>
                            <?php endif; ?>

                        </div>
                    </div>
                </div>
            </div>
        </div>
        <?php endforeach; ?>

    <?php endif; ?>


        <!-- ── TAB 3: BOARDING MANAGEMENT ──────────────────────────────────────── -->
    <?php if ($active_tab === 'boarding'): ?>
        <div class="content-panel">
            <div class="panel-header">
                <div class="panel-title">
                    <i class="fa fa-hotel text-primary"></i> Pet Hotel & Boarding Management
