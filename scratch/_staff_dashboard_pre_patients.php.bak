            <!-- Remaining Today for Selected Staff -->
            <div class="mb-3">
                <p class="fw-bold text-uppercase text-secondary mb-2" style="font-size:10px;letter-spacing:.08em;"><i class="fa fa-clock me-1"></i> Remaining Today</p>
                <?php
                $today_q = $conn->query("
                    SELECT a.*, u.fullname as client_name
                    FROM appointments a
                    LEFT JOIN users u ON a.user_id = u.id
                    WHERE a.appointment_date = '$today_date' 
                      AND ($staff_scope_sql)
                      AND a.status NOT IN ('Completed', 'Cancelled', 'Rejected', 'No Show')
                      AND a.is_archived = 0
                    ORDER BY a.appointment_time ASC
                ");
                if ($today_q && $today_q->num_rows > 0):
                    while ($t_row = $today_q->fetch_assoc()): ?>
                    <div class="d-flex align-items-start mb-2 p-2 rounded-2" style="background:#f8fafc;border:1px solid #eef2f6;">
                        <span class="text-primary mt-1 me-2" style="font-size:8px;"><i class="fa fa-circle"></i></span>
                        <div class="overflow-hidden">
