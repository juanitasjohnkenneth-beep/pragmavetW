                WHERE b.is_archived = 0
                ORDER BY b.appointment_date DESC
                LIMIT 30
            ");
            ?>
            <h6 class="fw-bold text-dark mb-3"><i class="fa fa-list me-1 text-primary"></i> Boarding Reservations</h6>
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th>ID</th>
