<?php
if (session_status() === PHP_SESSION_NONE) {
    session_start();
}
include("dbconnection.php");
include_once("assets/saas_calendar_component.php");

// 1. AUTHENTICATION & ACCESS GUARD
if (!isset($_SESSION['user_id'])) {
    header("Location: index.php");
    exit();
}

$user_id = $_SESSION['user_id'];
$user_role = $_SESSION['role'] ?? ($_SESSION['user_role'] ?? '');
$user_name = $_SESSION['user'] ?? 'Vet Staff';

// Allow staff and admin
if ($user_role !== 'staff' && $user_role !== 'admin') {
    if ($user_role === 'doctor') {
        header("Location: doctor.php");
    } elseif ($user_role === 'clinic_owner' || $user_role === 'owner') {
        header("Location: owner_dashboard.php");
    } else {
        header("Location: dashboard.php");
    }
    exit();
}

// 2. BACKEND ACTION PROCESSORS
$flash_msg = '';
$flash_type = 'success';

// Action: Handle Appointments (Accept, Reject, Reschedule, Assign Doctor, Update Status)
if (($_SERVER['REQUEST_METHOD'] ?? '') === 'POST' && isset($_POST['action'])) {
    $action = $_POST['action'];
    $redirect_tab = $_POST['redirect_tab'] ?? 'calendar';

    // 2.1 Accept Appointment
    if ($action === 'accept_appointment' && !empty($_POST['apt_id'])) {
        $apt_id = intval($_POST['apt_id']);
        $audit_note = "Approved by Vet Staff: {$user_name} (" . date('M d, Y h:i A') . ")";
        $stmt = $conn->prepare("UPDATE appointments SET status='Approved', approved_at=NOW(), admin_message=?, staff_id=COALESCE(staff_id, ?) WHERE id=?");
        $stmt->bind_param("sii", $audit_note, $user_id, $apt_id);
        if ($stmt->execute()) {
            $q = $conn->query("SELECT user_id, pet_name, appointment_date FROM appointments WHERE id=$apt_id");
            if ($q && $r = $q->fetch_assoc()) {
                $msg = "Great news! Your appointment for {$r['pet_name']} on " . date('M d, Y', strtotime($r['appointment_date'])) . " has been Approved by clinic staff.";
                $n = $conn->prepare("INSERT INTO notifications (user_id, message, is_read, created_at) VALUES (?, ?, 0, NOW())");
                $n->bind_param("is", $r['user_id'], $msg);
                $n->execute();
            }
            $_SESSION['flash_msg'] = "Appointment #$apt_id successfully approved.";
            $_SESSION['flash_type'] = "success";
        }
        header("Location: staff_dashboard.php?tab=" . urlencode($redirect_tab));
        exit();
    }

    // 2.2 Reject Appointment
    if ($action === 'reject_appointment' && !empty($_POST['apt_id'])) {
        $apt_id = intval($_POST['apt_id']);
        $reason = trim($_POST['reject_reason'] ?? 'Schedule unavailable');
        $audit_reason = "Declined by Vet Staff ({$user_name}): {$reason}";
        $stmt = $conn->prepare("UPDATE appointments SET status='Cancelled', admin_message=? WHERE id=?");
        $stmt->bind_param("si", $audit_reason, $apt_id);
        if ($stmt->execute()) {
            $q = $conn->query("SELECT user_id, pet_name FROM appointments WHERE id=$apt_id");
            if ($q && $r = $q->fetch_assoc()) {
                $msg = "Your appointment for {$r['pet_name']} could not be accommodated: $reason. Please reschedule or call us.";
                $n = $conn->prepare("INSERT INTO notifications (user_id, message, is_read, created_at) VALUES (?, ?, 0, NOW())");
                $n->bind_param("is", $r['user_id'], $msg);
                $n->execute();
            }
            $_SESSION['flash_msg'] = "Appointment #$apt_id cancelled.";
            $_SESSION['flash_type'] = "warning";
        }
        header("Location: staff_dashboard.php?tab=" . urlencode($redirect_tab));
        exit();
    }

    // 2.3 Reschedule Appointment
    if ($action === 'reschedule_appointment' && !empty($_POST['apt_id'])) {
        $apt_id = intval($_POST['apt_id']);
        $new_date = $_POST['new_date'] ?? '';
        $new_time = $_POST['new_time'] ?? '';
        if ($new_date && $new_time) {
            // Staff propose the new schedule; the client accepts it or declines and picks another date
            $audit_reschedule = "Reschedule proposed by Vet Staff ({$user_name}): $new_date $new_time";
            $stmt = $conn->prepare("UPDATE appointments SET status='Reschedule Proposed', proposed_reschedule_date=?, proposed_reschedule_time=?, client_action_needed=1, admin_message=?, staff_id=COALESCE(staff_id, ?) WHERE id=?");
            $stmt->bind_param("sssii", $new_date, $new_time, $audit_reschedule, $user_id, $apt_id);
            if ($stmt->execute()) {
                $q = $conn->query("SELECT user_id, pet_name FROM appointments WHERE id=$apt_id");
                if ($q && $r = $q->fetch_assoc()) {
                    $formatted_dt = date('M d, Y', strtotime($new_date)) . " at " . date('h:i A', strtotime($new_time));
                    $msg = "The clinic proposed a new schedule for {$r['pet_name']}: $formatted_dt. Tap to accept or choose another date.";
                    $link = "appointments.php?open_appt=$apt_id";
                    $n = $conn->prepare("INSERT INTO notifications (user_id, message, is_read, created_at, link) VALUES (?, ?, 0, NOW(), ?)");
                    $n->bind_param("iss", $r['user_id'], $msg, $link);
                    $n->execute();
                }
                $_SESSION['flash_msg'] = "New schedule proposed for Appointment #$apt_id. Waiting for the client to accept.";
                $_SESSION['flash_type'] = "success";
            }
        }
        header("Location: staff_dashboard.php?tab=" . urlencode($redirect_tab));
        exit();
    }

    // 2.4 Assign Doctor
    if ($action === 'assign_doctor' && !empty($_POST['apt_id'])) {
        $apt_id = intval($_POST['apt_id']);
        $doctor_id = intval($_POST['doctor_id'] ?? 0);
        $stmt = $conn->prepare("UPDATE appointments SET doctor_id=?, staff_id=COALESCE(staff_id, ?) WHERE id=?");
        $stmt->bind_param("iii", $doctor_id, $user_id, $apt_id);
        if ($stmt->execute()) {
            $_SESSION['flash_msg'] = "Doctor successfully assigned to Appointment #$apt_id.";
            $_SESSION['flash_type'] = "success";
        }
        header("Location: staff_dashboard.php?tab=" . urlencode($redirect_tab));
        exit();
    }

    // 2.4b Record a payment received at the front desk, then go to the printable receipt
    if ($action === 'record_payment' && !empty($_POST['bill_id'])) {
        $bill_id = intval($_POST['bill_id']);
        $bq = $conn->prepare("SELECT * FROM billing WHERE id=? AND COALESCE(payment_status,'') NOT IN ('Paid','Void')");
        $bq->bind_param("i", $bill_id);
        $bq->execute();
        $bill = $bq->get_result()->fetch_assoc();
        if (!$bill) {
            $_SESSION['flash_msg'] = "Invoice not found or already paid.";
            $_SESSION['flash_type'] = "warning";
            header("Location: staff_dashboard.php?tab=appointments&filter=all");
            exit();
        }
        $credit   = ($bill['downpayment_status'] === 'Paid') ? (float)$bill['downpayment_amount'] : 0.0;
        $balance  = max(0, round((float)$bill['total_amount'] - $credit, 2));
        $tendered = round((float)($_POST['amount_tendered'] ?? 0), 2);
        $method   = in_array($_POST['payment_method'] ?? 'Cash', ['Cash', 'GCash', 'Card'], true) ? $_POST['payment_method'] : 'Cash';
        $ref      = trim($_POST['reference_no'] ?? '');
        if ($tendered < $balance) {
            $_SESSION['flash_msg'] = "Amount received (₱" . number_format($tendered, 2) . ") is less than the balance due (₱" . number_format($balance, 2) . ").";
            $_SESSION['flash_type'] = "danger";
            header("Location: staff_dashboard.php?tab=appointments&filter=all");
            exit();
        }
        $change = round($tendered - $balance, 2);
        $up = $conn->prepare("UPDATE billing SET payment_status='Paid', amount_paid=total_amount, change_amount=?, payment_method=?, reference_no=?, paid_at=NOW() WHERE id=?");
        $up->bind_param("dssi", $change, $method, $ref, $bill_id);
        $up->execute();
        if (!empty($bill['user_id'])) {
            $msg  = "Payment received for invoice " . ($bill['invoice_no'] ?: "#$bill_id") . " (₱" . number_format($balance, 2) . " via $method). Thank you!";
            $link = "billing.php";
            $nt = $conn->prepare("INSERT INTO notifications (user_id, message, is_read, created_at, link) VALUES (?, ?, 0, NOW(), ?)");
            $nt->bind_param("iss", $bill['user_id'], $msg, $link);
            $nt->execute();
        }
        header("Location: staff_receipt.php?bill=$bill_id");
        exit();
    }

    // 2.5 Update Appointment Status (Checked In, In Progress, Completed, No Show)
    if ($action === 'update_status' && !empty($_POST['apt_id'])) {
        $apt_id = intval($_POST['apt_id']);
        $new_status = $_POST['new_status'] ?? 'Approved';

        // Completing requires the services availed (they become the client's invoice)
        $svc_items = [];
        if ($new_status === 'Completed') {
            foreach (($_POST['svc_name'] ?? []) as $i => $nm) {
                $nm = trim((string)$nm);
                if ($nm === '') continue;
                $svc_items[] = [
                    'name'  => mb_substr($nm, 0, 120),
                    'qty'   => max(1, (int)($_POST['svc_qty'][$i] ?? 1)),
                    'price' => max(0, round((float)($_POST['svc_price'][$i] ?? 0), 2)),
                ];
            }
            if (!$svc_items) {
                $_SESSION['flash_msg'] = "Add at least one service availed before completing Appointment #$apt_id.";
                $_SESSION['flash_type'] = "danger";
                header("Location: staff_dashboard.php?tab=" . urlencode($redirect_tab));
                exit();
            }

            // Medicines used (declared by staff): must exist, not be expired, and be in stock
            $med_used = []; $med_err = '';
            foreach (($_POST['med_id'] ?? []) as $i => $mid) {
                $mid = (int)$mid;
                $mqty = (int)($_POST['med_qty'][$i] ?? 0);
                if ($mid <= 0) continue;
                if ($mqty <= 0) { $med_err = "Enter the quantity used for each medicine."; break; }
                $mr = $conn->query("SELECT id, item_name, quantity, price_per_unit, expiry_date FROM inventory WHERE id = $mid")->fetch_assoc();
                if (!$mr) { $med_err = "A selected medicine no longer exists in inventory."; break; }
                $already = $med_used[$mid]['qty'] ?? 0;
                if (!empty($mr['expiry_date']) && $mr['expiry_date'] !== '1970-01-01' && $mr['expiry_date'] < date('Y-m-d')) { $med_err = "{$mr['item_name']} is expired and can't be used."; break; }
                if ($mqty + $already > (int)$mr['quantity']) { $med_err = "Only {$mr['quantity']} {$mr['item_name']} left in stock."; break; }
                $mprice = ($_POST['med_price'][$i] ?? '') !== '' ? max(0, round((float)$_POST['med_price'][$i], 2)) : (float)$mr['price_per_unit'];
                $med_used[$mid] = ['name' => $mr['item_name'], 'qty' => $mqty + $already, 'price' => $mprice];
            }
            if ($med_err) {
                $_SESSION['flash_msg'] = "Appointment #$apt_id not completed: $med_err";
                $_SESSION['flash_type'] = "danger";
                header("Location: staff_dashboard.php?tab=" . urlencode($redirect_tab) . "&filter=all&open=$apt_id");
                exit();
            }
        }
        $audit_status = "Status changed to '$new_status' by Vet Staff: {$user_name} (" . date('M d, Y h:i A') . ")";
        $stmt = $conn->prepare("UPDATE appointments SET status=?, admin_message=?, staff_id=COALESCE(staff_id, ?) WHERE id=?");
        $stmt->bind_param("ssii", $new_status, $audit_status, $user_id, $apt_id);
        if ($stmt->execute()) {
            $_SESSION['flash_msg'] = "Appointment #$apt_id status updated to '$new_status'.";
            $_SESSION['flash_type'] = "info";

            if ($new_status === 'Completed') {
                // Medicines used: deduct from inventory (stock history shows the appointment) and add to the invoice
                if (!empty($med_used)) {
                    include_once("includes/inventory_helper.php");
                    inv_ensure($conn);
                    $pet_for_ref = $conn->query("SELECT pet_name FROM appointments WHERE id = $apt_id")->fetch_assoc()['pet_name'] ?? '';
                    inv_set_context($conn, 'Used', "Appointment #$apt_id" . ($pet_for_ref !== '' ? " · $pet_for_ref" : ''));
                    $ded = $conn->prepare("UPDATE inventory SET quantity = GREATEST(0, quantity - ?) WHERE id = ?");
                    foreach ($med_used as $mid => $m) {
                        $ded->bind_param("ii", $m['qty'], $mid);
                        $ded->execute();
                        $svc_items[] = ['name' => $m['name'], 'qty' => $m['qty'], 'price' => $m['price']];
                    }
                }

                // Issue (or update) the client's invoice for the services availed
                $apt_info = $conn->query("SELECT user_id, pet_name, downpayment_status, downpayment_amount FROM appointments WHERE id = $apt_id")->fetch_assoc();
                if ($apt_info) {
                    $u_id   = (int)$apt_info['user_id'];
                    $client = $conn->query("SELECT fullname, contact_number FROM users WHERE id = $u_id")->fetch_assoc();
                    $c_name = $client['fullname'] ?? ''; $c_phone = $client['contact_number'] ?? '';
                    $total_amount = 0;
                    foreach ($svc_items as $it) $total_amount += $it['qty'] * $it['price'];
                    $total_amount = round($total_amount, 2);
                    $items_json = json_encode($svc_items, JSON_UNESCAPED_UNICODE);
                    // Reservation fee already paid is credited against this invoice
                    $dp_amt = ($apt_info['downpayment_status'] === 'Paid') ? (float)$apt_info['downpayment_amount'] : 0.0;
                    $dp_st  = $dp_amt > 0 ? 'Paid' : 'Unpaid';
                    $balance = max(0, round($total_amount - $dp_amt, 2));
                    $pay_st = $balance <= 0 ? 'Paid' : 'Unpaid';

                    $ex = $conn->query("SELECT id, invoice_no FROM billing WHERE appointment_id = $apt_id AND is_boarding = 0 AND COALESCE(payment_status,'') NOT IN ('Paid','Void') ORDER BY id DESC LIMIT 1")->fetch_assoc();
                    if ($ex) {
                        $bill_id = (int)$ex['id'];
                        $ub = $conn->prepare("UPDATE billing SET items_json=?, total_amount=?, user_id=?, client_name=?, client_phone=?, pet_name=?, service_category='Clinic', downpayment_amount=?, downpayment_status=?, payment_status=? WHERE id=?");
                        $ub->bind_param("sdisssdssi", $items_json, $total_amount, $u_id, $c_name, $c_phone, $apt_info['pet_name'], $dp_amt, $dp_st, $pay_st, $bill_id);
                        $ub->execute();
                    } else {
                        $ib = $conn->prepare("INSERT INTO billing (appointment_id, user_id, client_name, client_phone, pet_name, service_category, items_json, total_amount, payment_status, is_boarding, downpayment_amount, downpayment_status, created_at) VALUES (?, ?, ?, ?, ?, 'Clinic', ?, ?, ?, 0, ?, ?, NOW())");
                        $ib->bind_param("iissssdsds", $apt_id, $u_id, $c_name, $c_phone, $apt_info['pet_name'], $items_json, $total_amount, $pay_st, $dp_amt, $dp_st);
                        $ib->execute();
                        $bill_id = $conn->insert_id;
                    }
                    $inv_no = $ex['invoice_no'] ?? '';
                    if (!$inv_no) {
                        $inv_no = "INV-" . date('Y') . "-" . str_pad($bill_id, 5, '0', STR_PAD_LEFT);
                        $conn->query("UPDATE billing SET invoice_no = '$inv_no' WHERE id = $bill_id");
                    }
                    if ($pay_st === 'Paid') {
                        $conn->query("UPDATE billing SET amount_paid = total_amount, payment_method = 'Reservation Fee', paid_at = NOW() WHERE id = $bill_id");
                    }

                    $msg = "Your invoice $inv_no for {$apt_info['pet_name']} is ready: ₱" . number_format($total_amount, 2)
                         . ($dp_amt > 0 ? " (less ₱" . number_format($dp_amt, 2) . " reservation fee)" : "")
                         . ". " . ($balance > 0 ? "Balance due: ₱" . number_format($balance, 2) . ". Tap to pay." : "Fully paid — thank you!");
                    $link = "billing.php";
                    $nt = $conn->prepare("INSERT INTO notifications (user_id, message, is_read, created_at, link) VALUES (?, ?, 0, NOW(), ?)");
                    $nt->bind_param("iss", $u_id, $msg, $link);
                    $nt->execute();

                    $_SESSION['flash_msg'] = "Appointment #$apt_id completed. Invoice $inv_no issued: ₱" . number_format($total_amount, 2) . ($balance > 0 ? " (balance ₱" . number_format($balance, 2) . ")." : " (fully paid).");
                    $_SESSION['flash_type'] = "success";

                    // Client paid cash at the desk right now → mark the invoice paid and open the receipt
                    if (($_POST['pay_now'] ?? '') === 'cash' && $balance > 0) {
                        $tendered = round((float)($_POST['cash_tendered'] ?? 0), 2);
                        if ($tendered >= $balance) {
                            $change = round($tendered - $balance, 2);
                            $pc = $conn->prepare("UPDATE billing SET payment_status='Paid', amount_paid=total_amount, change_amount=?, payment_method='Cash', paid_at=NOW() WHERE id=?");
                            $pc->bind_param("di", $change, $bill_id);
                            $pc->execute();
                            $pmsg = "Payment received for invoice $inv_no (₱" . number_format($balance, 2) . " cash). Thank you!";
                            $nt2 = $conn->prepare("INSERT INTO notifications (user_id, message, is_read, created_at, link) VALUES (?, ?, 0, NOW(), ?)");
                            $nt2->bind_param("iss", $u_id, $pmsg, $link);
                            $nt2->execute();
                            header("Location: staff_receipt.php?bill=$bill_id");
                            exit();
                        }
                        $_SESSION['flash_msg'] .= " Cash not recorded: ₱" . number_format($tendered, 2) . " is less than the balance ₱" . number_format($balance, 2) . " — record the payment from the appointment.";
                        $_SESSION['flash_type'] = "warning";
                    }
                }
            }
        }
        header("Location: staff_dashboard.php?tab=" . urlencode($redirect_tab));
        exit();
    }

    // 2.6 Boarding: Accept / Reject / Assign Cage / Update Status
    if ($action === 'boarding_decision' && !empty($_POST['b_id'])) {
        $b_id = intval($_POST['b_id']);
        $decision = $_POST['decision'] ?? 'Approved';
        $cage = intval($_POST['cage_number'] ?? 0);

        if ($decision === 'Approved') {
            $b_audit = "Boarding confirmed & Cage #$cage assigned by Vet Staff: {$user_name} (" . date('M d, Y h:i A') . ")";
            $stmt = $conn->prepare("UPDATE boarding_reservations SET status='Approved', cage_number=?, approved_at=NOW(), admin_message=? WHERE id=?");
            $stmt->bind_param("isi", $cage, $b_audit, $b_id);
        } else {
            $reason = trim($_POST['b_reason'] ?? 'Boarding full');
            $b_audit = "Declined by Vet Staff ({$user_name}): {$reason}";
            $stmt = $conn->prepare("UPDATE boarding_reservations SET status='Cancelled', admin_message=? WHERE id=?");
            $stmt->bind_param("si", $b_audit, $b_id);
        }
        if ($stmt->execute()) {
            $q = $conn->query("SELECT user_id, pet_name FROM boarding_reservations WHERE id=$b_id");
            if ($q && $r = $q->fetch_assoc()) {
                $b_msg = ($decision === 'Approved') 
                    ? "Your boarding reservation for {$r['pet_name']} has been confirmed! Cage #$cage is reserved." 
                    : "Your boarding reservation for {$r['pet_name']} was declined: $reason.";
                $n = $conn->prepare("INSERT INTO notifications (user_id, message, is_read, created_at) VALUES (?, ?, 0, NOW())");
                $n->bind_param("is", $r['user_id'], $b_msg);
                $n->execute();
            }
            $_SESSION['flash_msg'] = "Boarding reservation #$b_id updated.";
            $_SESSION['flash_type'] = ($decision === 'Approved') ? "success" : "warning";
        }
        header("Location: staff_dashboard.php?tab=boarding");
        exit();
    }

    // 2.7 Boarding Status Update (Active, Checked In, Completed/Checked Out)
    if ($action === 'update_boarding_status' && !empty($_POST['b_id'])) {
        $b_id = intval($_POST['b_id']);
        $b_status = $_POST['b_status'] ?? 'Approved';
        $stmt = $conn->prepare("UPDATE boarding_reservations SET status=? WHERE id=?");
        $stmt->bind_param("si", $b_status, $b_id);
        $stmt->execute();
        $_SESSION['flash_msg'] = "Boarding #$b_id status updated to $b_status.";
        $_SESSION['flash_type'] = "info";
        header("Location: staff_dashboard.php?tab=boarding");
        exit();
    }

    // 2.8 Patient Support: Record Vitals & Basic Care Notes
    if ($action === 'record_vitals') {
        $pet_id = intval($_POST['pet_id'] ?? 0);
        $temp = floatval($_POST['temperature'] ?? 0);
        $hr = intval($_POST['heart_rate'] ?? 0);
        $notes = trim($_POST['vitals_notes'] ?? '');
        $special_instructions = trim($_POST['special_instructions'] ?? '');
        $dietary_notes = trim($_POST['dietary_notes'] ?? '');

        if ($pet_id > 0) {
            if ($temp > 0 || $hr > 0 || !empty($notes)) {
                $m_stmt = $conn->prepare("INSERT INTO monitoring (pet_id, temperature, heart_rate, notes, recorded_at) VALUES (?, ?, ?, ?, NOW())");
                $m_stmt->bind_param("idis", $pet_id, $temp, $hr, $notes);
                $m_stmt->execute();
            }
            if (!empty($special_instructions) || !empty($dietary_notes)) {
                $pn_stmt = $conn->prepare("INSERT INTO pet_notes (pet_id, special_instructions, dietary_notes) VALUES (?, ?, ?) ON DUPLICATE KEY UPDATE special_instructions=VALUES(special_instructions), dietary_notes=VALUES(dietary_notes), updated_at=NOW()");
                $pn_stmt->bind_param("iss", $pet_id, $special_instructions, $dietary_notes);
                $pn_stmt->execute();
            }
            $_SESSION['flash_msg'] = "Care notes and patient vitals recorded successfully.";
            $_SESSION['flash_type'] = "success";
        }
        header("Location: staff_dashboard.php?tab=patients");
        exit();
    }

    // 2.9 Inventory: Supply Replenishment Request to Admin
    if ($action === 'request_supplies') {
        $item_name = trim($_POST['item_name'] ?? '');
        $quantity = intval($_POST['request_qty'] ?? 1);
        $urgency = trim($_POST['urgency'] ?? 'Normal');
        $notes = trim($_POST['request_notes'] ?? '');

        $admin_q = $conn->query("SELECT id FROM users WHERE role='admin' LIMIT 1");
        if ($admin_q && $a = $admin_q->fetch_assoc()) {
            $admin_id = $a['id'];
            $req_msg = "📦 <b>Supply Request from Staff ({$user_name})</b>: {$quantity}x {$item_name} [Urgency: {$urgency}]. Notes: {$notes}";
            $notif = $conn->prepare("INSERT INTO notifications (user_id, message, is_read, created_at) VALUES (?, ?, 0, NOW())");
            $notif->bind_param("is", $admin_id, $req_msg);
            $notif->execute();
            $_SESSION['flash_msg'] = "Supply replenishment request for '{$item_name}' transmitted to Admin.";
            $_SESSION['flash_type'] = "success";
        }
        header("Location: staff_dashboard.php?tab=inventory");
        exit();
    }

    // 2.10 Client Assistance: Direct Pet Care Update / Notification
    if ($action === 'send_client_update') {
        $client_user_id = intval($_POST['client_user_id'] ?? 0);
        $update_msg = trim($_POST['update_message'] ?? '');
        if ($client_user_id > 0 && !empty($update_msg)) {
            $formatted_msg = "🐾 <b>PragmaVet Staff Update:</b> " . htmlspecialchars($update_msg);
            $n_stmt = $conn->prepare("INSERT INTO notifications (user_id, message, is_read, created_at) VALUES (?, ?, 0, NOW())");
            $n_stmt->bind_param("is", $client_user_id, $formatted_msg);
            $n_stmt->execute();
            $_SESSION['flash_msg'] = "Client care update sent successfully.";
            $_SESSION['flash_type'] = "success";
        }
        header("Location: staff_dashboard.php?tab=client_assistance");
        exit();
    }

    // 2.11 Rapid Walk-In Intake
    if ($action === 'create_walkin') {
        $client_name = trim($_POST['walkin_client'] ?? 'Walk-In Client');
        $pet_name = trim($_POST['walkin_pet'] ?? 'Pet');
        $service = trim($_POST['walkin_service'] ?? 'General Consultation');
        $doc_id = intval($_POST['walkin_doctor'] ?? 0);
        $today = date('Y-m-d');
        $now_time = date('H:i:s');

        $w_user = $conn->query("SELECT id FROM users WHERE email='walkin@pragmavet.com' LIMIT 1");
        if ($w_user && $w_user->num_rows > 0) {
            $w_uid = $w_user->fetch_assoc()['id'];
        } else {
            $default_w = $conn->query("SELECT id FROM users WHERE role='client' LIMIT 1");
            $w_uid = ($default_w && $default_w->num_rows > 0) ? $default_w->fetch_assoc()['id'] : $user_id;
        }

        $audit_walkin = "Walk-in registered by Vet Staff: {$user_name} (" . date('M d, Y h:i A') . ")";
        $ins_w = $conn->prepare("INSERT INTO appointments (user_id, pet_name, service_type, appointment_date, appointment_time, status, doctor_id, staff_id, admin_message, created_at) VALUES (?, ?, ?, ?, ?, 'Approved', ?, ?, ?, NOW())");
        $ins_w->bind_param("issssiss", $w_uid, $pet_name, $service, $today, $now_time, $doc_id, $user_id, $audit_walkin);
        if ($ins_w->execute()) {
            $_SESSION['flash_msg'] = "Walk-in patient '{$pet_name}' registered and scheduled on today's appointment calendar.";
            $_SESSION['flash_type'] = "success";
        }
        header("Location: staff_dashboard.php?tab=calendar");
        exit();
    }
}

// Read and clear flash
if (isset($_SESSION['flash_msg'])) {
    $flash_msg = $_SESSION['flash_msg'];
    $flash_type = $_SESSION['flash_type'] ?? 'success';
    unset($_SESSION['flash_msg'], $_SESSION['flash_type']);
}

// Active navigation tab (Default: calendar)
$active_tab = $_GET['tab'] ?? 'calendar';

// 3. STATS & SUMMARY DATA
$today_date = date('Y-m-d');

// Real-time metric counters
$c_today_appts = $conn->query("SELECT COUNT(*) as c FROM appointments WHERE appointment_date='$today_date' AND is_archived=0")->fetch_assoc()['c'] ?? 0;
$c_in_exam = $conn->query("SELECT COUNT(*) as c FROM appointments WHERE appointment_date='$today_date' AND status = 'In Progress'")->fetch_assoc()['c'] ?? 0;
$c_boarding = $conn->query("SELECT COUNT(*) as c FROM boarding_reservations WHERE status IN ('Approved', 'Checked In') AND (end_date >= '$today_date' OR end_date IS NULL)")->fetch_assoc()['c'] ?? 0;
$c_pending_requests = $conn->query("SELECT COUNT(*) as c FROM appointments WHERE status = 'Pending' AND is_archived=0")->fetch_assoc()['c'] ?? 0;
$c_boarding_requests = $conn->query("SELECT COUNT(*) as c FROM boarding_reservations WHERE status = 'Pending'")->fetch_assoc()['c'] ?? 0;


// Fetch Active Inventory Items
$inv_res = $conn->query("SELECT id, item_name, quantity, price_per_unit, expiry_date, unit_of_measure FROM inventory WHERE quantity > 0 ORDER BY item_name ASC");
$inventory_items = [];
while ($inv = $inv_res->fetch_assoc()) {
    $inventory_items[] = $inv;
}
include_once("includes/service_prices.php");
$svc_price_list = sp_all($conn);
$inventory_json = json_encode($inventory_items, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP | JSON_UNESCAPED_UNICODE);

// Fetch Available Doctors for assignments
$doctors_res = $conn->query("SELECT id, fullname FROM users WHERE role='doctor' ORDER BY fullname ASC");
$doctors = [];
while ($d = $doctors_res->fetch_assoc()) {
    $doctors[] = $d;
}

// Fetch Active Patients & Owners for dropdowns
$clients_res = $conn->query("SELECT id, fullname, email, contact_number FROM users WHERE role IN ('client', 'user') ORDER BY fullname ASC");
$clients = [];
while ($cl = $clients_res->fetch_assoc()) {
    $clients[] = $cl;
}

// Staff Member Selection (Show only schedules and events assigned to the selected Vet Staff)
$staff_members_res = $conn->query("SELECT id, fullname, email FROM users WHERE role='staff' ORDER BY fullname ASC");
$staff_members = [];
while ($sm = $staff_members_res->fetch_assoc()) {
    $staff_members[] = $sm;
}

$staff_ids = array_column($staff_members, 'id');
$selected_staff_id = (isset($_GET['staff_id']) && in_array((int)$_GET['staff_id'], array_map('intval', $staff_ids))) ? (int)$_GET['staff_id'] : 'all';
$staff_scope_sql = ($selected_staff_id === 'all') ? '1=1' : 'a.staff_id = ' . (int)$selected_staff_id;

$selected_staff_name = 'All Staff';
foreach ($staff_members as $sm) {
    if ($sm['id'] == $selected_staff_id) {
        $selected_staff_name = $sm['fullname'];
        break;
    }
}

// 4. PREPARE VET STAFF CALENDAR EVENTS (Strictly isolated to selected Vet Staff)
$calendar_events = [];
$cal_appts_q = $conn->query("
    SELECT a.*, u.fullname as owner_name, u.contact_number, u.email as owner_email, d.fullname as doctor_name, s.fullname as staff_name
    FROM appointments a
    LEFT JOIN users u ON a.user_id = u.id
    LEFT JOIN users d ON a.doctor_id = d.id
    LEFT JOIN users s ON a.staff_id = s.id
    WHERE a.is_archived = 0 AND ($staff_scope_sql)
    ORDER BY a.appointment_date ASC, a.appointment_time ASC
");

if ($cal_appts_q) {
    while ($r = $cal_appts_q->fetch_assoc()) {
        $service = $r['service_type'] ?? 'General Consultation';
        $color = 'blue';
        if (stripos($service, 'vaccin') !== false) { $color = 'green'; }
        elseif (stripos($service, 'surg') !== false) { $color = 'orange'; }
        
        // Colour by status so the calendar matches the legend
        $st = $r['status'];
        $status_colors = ['Pending' => 'orange', 'Approved' => 'blue', 'Checked In' => 'cyan', 'In Progress' => 'purple', 'Completed' => 'green'];
        $color = $status_colors[$st] ?? ((stripos($st, 'Cancel') !== false || $st === 'Rejected' || $st === 'No Show') ? 'red' : 'gray');

        $calendar_events[] = [
            'type'        => $service,
            'color'       => $color,
            'status'      => $r['status'],
            'time'        => date("h:i A", strtotime($r['appointment_time'])),
            'raw_time'    => $r['appointment_time'],
            'title'       => $r['owner_name'] ?? 'Client',
            'pet'         => $r['pet_name'] ?? 'Pet',
            'ownerId'     => $r['user_id'],
            'owner'       => $r['owner_name'] ?? 'Client',
            'doctorId'    => $r['doctor_id'],
            'doctor'      => $r['doctor_name'] ?? 'Unassigned',
            'staffId'     => $r['staff_id'],
            'staff'       => $r['staff_name'] ?? 'Unassigned',
            'contact'     => $r['contact_number'] ?? '',
            'raw_date'    => $r['appointment_date'],
            'appt_id'     => $r['id'],
            'location'    => $r['service_location'] ?? 'Clinic',
            'notes'       => $r['admin_message'] ?? '',
            'created_at'  => $r['created_at'] ?? ''
        ];
    }
}

// Fetch staff unavailability/leaves for selected staff
$staff_leaves_q = ($selected_staff_id === 'all') ? false : $conn->query("SELECT * FROM staff_unavailability WHERE staff_id = " . (int)$selected_staff_id);
if ($staff_leaves_q) {
    while ($sl = $staff_leaves_q->fetch_assoc()) {
        $calendar_events[] = [
            'type'     => 'Leave',
            'color'    => 'red',
            'status'   => 'Leave',
            'time'     => 'All Day',
            'title'    => 'On Leave',
            'pet'      => 'N/A',
            'ownerId'  => null,
            'owner'    => 'N/A',
            'doctorId' => null,
            'doctor'   => 'N/A',
            'staffId'  => $sl['staff_id'],
            'staff'    => $selected_staff_name,
            'raw_date' => $sl['unavailable_date'],
            'appt_id'  => null
        ];
    }
}
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vet Staff Portal & Schedule Calendar | PragmaVet</title>
    <!-- Fonts & Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FullCalendar 6 CDN -->
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>

    <style>
        /* ═══════════════════════════════════════════════════════════
           PRAGMAVET STAFF DASHBOARD — Unified Design System
           Matches client portal: dark sidebar, navy primary palette
        ═══════════════════════════════════════════════════════════ */
        :root {
            --primary:      #2563eb;
            --primary-dark: #1e40af;
            --primary-hover:#1d4ed8;
            --secondary:    #3b82f6;
            --sidebar-width: 260px;
            --bg-color:     #F4F9FB;
            --card-bg:      #ffffff;
            --text-main:    #333333;
            --text-heading: #1e40af;
            --border-color: #edf2f6;
            --input-bg:     #fafcff;
            --slate-muted:  #64748b;
        }

        * { box-sizing: border-box; }

        body {
            background: var(--bg-color);
            font-family: 'Inter', sans-serif;
            color: var(--text-main);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            transition: background-color 0.4s ease, color 0.4s ease;
        }

        /* ── DARK SIDEBAR (matches client portal) ─────────────────── */
        .sidebar {
            background: #0f172a;
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0; left: 0;
            padding: 24px 16px;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            box-shadow: 5px 0 20px rgba(0,0,0,.2);
            overflow-y: auto;
        }

        .sidebar h4 {
            color: #ffffff;
            font-weight: 800;
            font-size: 22px;
            margin-bottom: 30px;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Brand row */
        .brand-container {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-bottom: 20px;
            margin-bottom: 8px;
        }
        .brand-icon-box {
            width: 44px; height: 44px;
            background: var(--primary);
            border-radius: 13px;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 20px;
            box-shadow: 0 4px 14px rgba(37,99,235,.35);
        }
        .brand-name { font-size: 22px; font-weight: 800; color: #fff; letter-spacing: -0.4px; }

        /* User welcome card inside sidebar */
        .user-welcome-card {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            padding: 14px 16px;
            margin-bottom: 20px;
        }
        .user-welcome-card .greeting { font-size: 12px; color: #94a3b8; font-weight: 500; }
        .user-welcome-card .user-title { font-weight: 700; color: #ffffff; font-size: 14.5px; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .user-welcome-card .role-badge { display: inline-block; background: rgba(37,99,235,.35); color: #93c5fd; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 6px; margin-top: 4px; }

        .nav-section-title { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.9px; color: #475569; margin: 14px 10px 6px; }

        .sidebar-nav { list-style: none; padding: 0; margin: 0; flex-grow: 1; overflow-y: auto; }

        /* Nav items */
        .nav-link-item {
            display: flex; align-items: center; gap: 10px;
            padding: 12px 16px;
            border-radius: 8px;
            color: #94a3b8;
            text-decoration: none;
            font-weight: 600; font-size: 15px;
            margin-bottom: 4px;
            transition: .2s;
        }
        .nav-link-item i { width: 30px; font-size: 18px; }
        .nav-link-item:hover, .nav-link-item.active { background: var(--primary); color: #ffffff; }
        .nav-link-item.active i { color: #ffffff; }

        .nav-badge-pill { margin-left: auto; background: #ef4444; color: #fff; font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 10px; }

        .sidebar-footer { padding-top: 15px; border-top: 1px solid rgba(255,255,255,.07); margin-top: auto; }
        .logout-link { display: flex; align-items: center; gap: 10px; padding: 10px 16px; color: #ff6b6b; text-decoration: none; font-weight: 600; border-radius: 8px; transition: background 0.2s; }
        .logout-link:hover { background: rgba(255,107,107,0.12); color: #ff4757; }

        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 10px; }

        /* ── MAIN CONTENT ──────────────────────────────────────────── */
        .main-wrapper {
            margin-left: var(--sidebar-width);
            padding: 40px 50px;
            min-height: 100vh;
        }

        .top-action-bar {
            display: flex; align-items: center;
            justify-content: space-between;
            margin-bottom: 32px;
            flex-wrap: wrap; gap: 16px;
        }

        .page-heading h1 { font-size: 26px; font-weight: 800; color: var(--text-heading); margin: 0; letter-spacing: -0.5px; }
        .page-heading p { color: var(--slate-muted); margin: 4px 0 0; font-size: 14px; }

        /* ── STAT CARDS (match client gradient style) ──────────────── */
        @keyframes slideUpEntrance {
            0%   { opacity: 0; transform: translateY(30px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        .stat-card-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 32px; }

        .stat-card {
            border-radius: 20px;
            padding: 28px 24px;
            color: white;
            position: relative;
            overflow: hidden;
            transition: 0.3s;
            box-shadow: 0 10px 20px rgba(0,0,0,.05);
            animation: slideUpEntrance 0.7s cubic-bezier(0.165,0.84,0.44,1) forwards;
            opacity: 0;
        }
        .stat-card.delay-1 { animation-delay: 0.05s; }
        .stat-card.delay-2 { animation-delay: 0.1s; }
        .stat-card.delay-3 { animation-delay: 0.15s; }
        .stat-card.delay-4 { animation-delay: 0.2s; }
        .stat-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.1); }

        .stat-card .stat-icon-bg { position: absolute; right: -20px; bottom: -20px; font-size: 100px; opacity: 0.15; transform: rotate(-15deg); }
        .stat-card .stat-val  { font-size: 42px; font-weight: 800; margin: 0; line-height: 1; }
        .stat-card .stat-title { font-size: 15px; opacity: 0.9; font-weight: 500; margin-bottom: 8px; }

        .bg-primary-custom { background: linear-gradient(135deg, #2563eb, #1d4ed8); }
        .bg-success-custom  { background: linear-gradient(135deg, #3b82f6, #268dae); }
        .bg-warning-custom  { background: linear-gradient(135deg, #405F6E, #284451); }
        .bg-purple-custom   { background: linear-gradient(135deg, #6d28d9, #4338ca); }


        /* ═══ Sidebar — same look as the pet owner portal ═══ */
        .sidebar { background:#ffffff !important; width:var(--sidebar-width, 260px) !important; height:100vh !important; position:fixed !important; top:0 !important; left:0 !important;
                   padding:28px 20px 24px !important; z-index:1000 !important; display:flex !important; flex-direction:column !important; border-right:1px solid #eef2f6 !important; box-shadow:none !important; overflow-y:auto !important; }
        .sidebar-brand { display:flex !important; align-items:center !important; gap:12px !important; margin-bottom:24px !important; padding:0 4px !important; }
        .sidebar-brand-icon { width:44px !important; height:44px !important; min-width:44px !important; border-radius:13px !important; background:#2563eb !important; display:flex !important; align-items:center !important; justify-content:center !important; color:#fff !important; font-size:20px !important; box-shadow:0 4px 14px rgba(37,99,235,.28) !important; }
        .sidebar-brand span { font-weight:800 !important; color:#182032 !important; font-size:22px !important; letter-spacing:-.4px !important; }
        .sidebar-user { margin-bottom:24px !important; padding:15px 18px !important; border-radius:14px !important; background:#f8fafc !important; border:1px solid #eef2f6 !important; }
        .sidebar-user .welcome { font-size:13px !important; color:#64748b !important; font-weight:500 !important; }
        .sidebar-user .uname { font-weight:700 !important; color:#0f172a !important; font-size:15.5px !important; margin-top:3px !important; white-space:nowrap !important; overflow:hidden !important; text-overflow:ellipsis !important; }
        .sidebar-role { display:inline-block; margin-top:6px; font-size:11px; font-weight:700; color:#2563eb; background:#eff6ff; border-radius:999px; padding:2px 10px; }
        .sidebar > a { display:flex !important; align-items:center !important; gap:14px !important; padding:13px 18px !important; border-radius:12px !important; color:#334155 !important; text-decoration:none !important; margin-bottom:4px !important; font-weight:600 !important; font-size:15px !important; transition:all .2s ease !important; background:transparent; }
        .sidebar > a i { width:22px !important; text-align:center !important; font-size:17px !important; color:#64748b !important; transition:color .2s !important; flex-shrink:0 !important; }
        .sidebar > a:hover { background:#f8fafc !important; color:#0f172a !important; }
        .sidebar > a:hover i { color:#2563eb !important; }
        .sidebar > a.active { background:#2563eb !important; color:#fff !important; font-weight:700 !important; box-shadow:0 4px 14px rgba(37,99,235,.28) !important; }
        .sidebar > a.active i { color:#fff !important; }
        .sidebar .sb-badge { margin-left:auto; color:#fff; font-size:11px; font-weight:800; min-width:22px; height:22px; border-radius:999px; display:inline-flex; align-items:center; justify-content:center; padding:0 7px; }
        .sidebar > a.active .sb-badge { background:#fff !important; color:#2563eb; }
        .sidebar .sidebar-logout { margin-top:auto !important; padding-top:20px !important; border-top:1px solid #f1f5f9 !important; }
        .sidebar .sidebar-logout a { display:flex !important; align-items:center !important; gap:14px !important; padding:13px 18px !important; border-radius:12px !important; color:#dc2626 !important; font-weight:600 !important; text-decoration:none !important; }
        .sidebar .sidebar-logout a i { width:22px !important; text-align:center !important; color:#dc2626 !important; }
        .sidebar .sidebar-logout a:hover { background:#fef2f2 !important; color:#b91c1c !important; }
        .sidebar::-webkit-scrollbar { width:5px; } .sidebar::-webkit-scrollbar-thumb { background:rgba(0,0,0,.06); border-radius:10px; }

        /* ═══ Appointment Requests ═══ */
        .ar-head { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; flex-wrap:wrap; margin-bottom:18px; }
        .ar-seg { display:inline-flex; background:#f1f5f9; border-radius:12px; padding:4px; gap:4px; }
        .ar-seg a { padding:8px 16px; border-radius:9px; font-weight:700; font-size:13px; color:#475569; text-decoration:none; transition:all .15s; }
        .ar-seg a.on { background:#fff; color:#2563eb; box-shadow:0 2px 6px rgba(15,23,42,.08); }
        .ar-seg a:not(.on):hover { color:#0f172a; }
        .ar-toolbar { display:flex; gap:14px; align-items:center; flex-wrap:wrap; margin-bottom:14px; }
        .ar-search { position:relative; flex:1; min-width:240px; max-width:380px; }
        .ar-search i { position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:13px; }
        .ar-search input { width:100%; padding:10px 14px 10px 38px !important; border-radius:12px !important; border:1px solid #e2e8f0 !important; background:#f8fafc !important; font-size:13.5px; }
        .ar-search input:focus { background:#fff !important; border-color:#93c5fd !important; box-shadow:0 0 0 4px rgba(37,99,235,.08) !important; outline:none; }
        .ar-chips { display:flex; gap:6px; flex-wrap:wrap; }
        .ar-chip { border:1px solid #e2e8f0 !important; background:#fff !important; color:#475569 !important; border-radius:999px !important; padding:6px 12px !important; font-size:12.5px; font-weight:700; cursor:pointer; transition:all .15s; box-shadow:none !important; transform:none !important; }
        .ar-chip span { display:inline-block; margin-left:4px; background:#f1f5f9; color:#64748b; border-radius:999px; padding:0 7px; font-size:11px; }
        .ar-chip:hover { border-color:#bfdbfe !important; color:#2563eb !important; }
        .ar-chip.on { background:#2563eb !important; border-color:#2563eb !important; color:#fff !important; }
        .ar-chip.on span { background:rgba(255,255,255,.25); color:#fff; }
        .ar-table thead th { background:#f8fafc; color:#64748b; font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:.06em; border:none; padding:12px 14px; }
        .ar-table thead th:first-child { border-radius:12px 0 0 12px; } .ar-table thead th:last-child { border-radius:0 12px 12px 0; }
        .ar-table td { padding:14px; border-bottom:1px solid #f1f5f9; vertical-align:middle; }
        .ar-row { cursor:pointer; transition:background .15s, box-shadow .15s; }
        .ar-row:hover { background:#f8fbff; box-shadow:inset 3px 0 0 #2563eb; }
        .ar-row:focus { outline:2px solid #93c5fd; outline-offset:-2px; }
        .ar-date { width:46px; height:50px; border-radius:12px; background:#f1f5f9; display:flex; flex-direction:column; align-items:center; justify-content:center; flex-shrink:0; line-height:1; }
        .ar-date .m { font-size:10px; font-weight:800; text-transform:uppercase; color:#64748b; letter-spacing:.05em; }
        .ar-date .d { font-size:19px; font-weight:800; color:#0f172a; margin-top:3px; }
        .ar-date.today { background:#2563eb; } .ar-date.today .m, .ar-date.today .d { color:#fff; }
        .ar-id { font-size:11.5px; color:#94a3b8; margin-top:2px; }
        .ar-avatar { width:34px; height:34px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-weight:800; font-size:14px; flex-shrink:0; }
        .ar-service { display:inline-block; font-size:12px; font-weight:700; color:#334155; background:#f1f5f9; border-radius:8px; padding:4px 10px; }
        .ar-doc { font-size:12.5px; color:#334155; font-weight:600; } .ar-doc i { color:#94a3b8; }
        .ar-open { border:1px solid #dbeafe !important; background:#eff6ff !important; color:#2563eb !important; border-radius:10px !important; padding:6px 14px !important; font-size:12.5px; font-weight:700; transition:all .15s; box-shadow:none !important; transform:none !important; }
        .ar-open:hover { background:#2563eb !important; color:#fff !important; }

        /* ── NEW WALK-IN PATIENT BUTTON ─────────────────────────────── */
        .btn-walkin {
            display: inline-flex !important; align-items: center !important; gap: 10px !important;
            background: linear-gradient(135deg, #2563eb, #1d4ed8) !important; color: #fff !important;
            border: none !important; border-radius: 999px !important; padding: 12px 24px !important;
            font-weight: 700 !important; font-size: 14.5px !important; letter-spacing: .1px;
            box-shadow: 0 6px 18px rgba(37, 99, 235, .30) !important; transition: transform .15s, box-shadow .15s !important;
        }
        .btn-walkin i { width: 30px; height: 30px; border-radius: 50%; background: rgba(255, 255, 255, .2); display: inline-flex; align-items: center; justify-content: center; font-size: 13px; margin: 0 !important; }
        .btn-walkin:hover { transform: translateY(-2px) !important; box-shadow: 0 10px 24px rgba(37, 99, 235, .38) !important; color: #fff !important; }
        .btn-walkin:active { transform: translateY(0) !important; }
        .btn-walkin:focus-visible { outline: 3px solid #93c5fd !important; outline-offset: 2px; }

        /* ── CALENDAR LEGEND ───────────────────────────────────────── */
        .legend-pill {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 4px 10px; border-radius: 999px;
            font-size: 11.5px; font-weight: 700;
            color: var(--c); background: var(--bg);
            border: 1px solid color-mix(in srgb, var(--c) 25%, transparent);
        }
        .legend-pill::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--c); }

        /* ── CONTENT PANELS ────────────────────────────────────────── */
        .content-panel {
            background: var(--card-bg);
            border-radius: 20px;
            border: none;
            padding: 28px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.04);
            margin-bottom: 30px;
            animation: slideUpEntrance 0.7s cubic-bezier(0.165,0.84,0.44,1) forwards;
            animation-delay: 0.25s;
            opacity: 0;
        }

        .panel-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; flex-wrap: wrap; gap: 12px; }
        .panel-title { font-size: 17px; font-weight: 700; color: var(--text-heading); display: flex; align-items: center; gap: 10px; }

        /* ── TABS NAV ──────────────────────────────────────────────── */
        .tab-nav { display: flex; gap: 4px; background: #f1f5f9; padding: 5px; border-radius: 14px; flex-wrap: wrap; }
        .tab-nav a {
            padding: 9px 18px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            color: var(--slate-muted);
            transition: all 0.2s;
            display: flex; align-items: center; gap: 7px;
        }
        .tab-nav a.active { background: #ffffff; color: var(--primary); box-shadow: 0 2px 8px rgba(0,0,0,0.07); }
        .tab-nav a:hover:not(.active) { color: #334155; }
        .tab-nav .tab-badge { background: #ef4444; color: #fff; font-size: 10px; font-weight: 700; padding: 1px 5px; border-radius: 6px; }

        /* ── TABLES ────────────────────────────────────────────────── */
        .table-custom { width: 100%; margin-bottom: 0; vertical-align: middle; color: var(--text-main); }

        .table-custom thead th {
            font-size: 12px; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.8px; color: #8898aa;
            background: #f8fafc;
            border-bottom: 2px solid var(--border-color);
            padding: 12px 16px;
        }

        .table-custom tbody tr { transition: 0.2s; }
        .table-custom tbody tr:hover { background: rgba(37,99,235,0.03); }

        .table-custom tbody td {
            padding: 16px;
            border-bottom: 1px solid var(--border-color);
            font-size: 14px;
            font-weight: 500;
            vertical-align: middle;
        }

        /* ── STATUS BADGES ─────────────────────────────────────────── */
        .badge-status { padding: 5px 12px; border-radius: 30px; font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 5px; }
        .badge-custom  { padding: 6px 12px; border-radius: 30px; font-weight: 600; font-size: 12px; }

        /* Same colours as the calendar legend */
        .status-approved    { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
        .status-checked-in  { background: #ecfeff; color: #0e7490; border: 1px solid #a5f3fc; }
        .status-in-progress { background: #faf5ff; color: #7e22ce; border: 1px solid #e9d5ff; }
        .status-pending     { background: #fff7ed; color: #c2410c; border: 1px solid #fed7aa; }
        .status-cancelled   { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
        .status-completed   { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
        .badge-status::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }

        /* Appointment detail modal header icon */
        .stat-icon { display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; flex-shrink: 0; }
        .stat-icon.blue { background: #eff6ff; color: #2563eb; }
        #calendarApptModal .modal-header { padding: 20px 24px 8px; }

        /* Distinct action buttons in the appointment modal (global theme makes every .btn the same gradient) */
        #calendarApptModal #statusActionButtons .btn { border-radius: 12px; box-shadow: none; transform: none; }
        #calendarApptModal #statusActionButtons .btn-success { background: #16a34a !important; color: #fff !important; }
        #calendarApptModal #statusActionButtons .btn-primary { background: #2563eb !important; color: #fff !important; }
        #calendarApptModal #statusActionButtons .btn-info    { background: #7c3aed !important; color: #fff !important; }
        #calendarApptModal #statusActionButtons .btn-danger  { background: #be123c !important; color: #fff !important; }
        #calendarApptModal #statusActionButtons .btn-outline-danger    { background: #fff !important; color: #be123c !important; border: 1.5px solid #fecdd3 !important; }
        #calendarApptModal #statusActionButtons .btn-outline-secondary { background: #f8fafc !important; color: #64748b !important; border: 1px solid #e2e8f0 !important; }
        #calendarApptModal #statusActionButtons .btn:hover { filter: brightness(.96); }

        /* Confirm dialog buttons: light Cancel, coloured confirm (overrides the global gradient) */
        #pragmaConfirmModal .btn { box-shadow: none !important; transform: none !important; }
        #pragmaConfirmModal .btn-light { background: #fff !important; color: #475569 !important; border: 1px solid #e2e8f0 !important; }
        #pragmaConfirmModal .btn-success { background: #16a34a !important; color: #fff !important; border: none !important; }
        #pragmaConfirmModal .btn-danger  { background: #dc2626 !important; color: #fff !important; border: none !important; }
        #pragmaConfirmModal .btn-warning { background: #f59e0b !important; color: #fff !important; border: none !important; }
        #pragmaConfirmModal .btn-primary { background: #2563eb !important; color: #fff !important; border: none !important; }

        /* ── FORMS & INPUTS ────────────────────────────────────────── */
        .form-control, .form-select {
            border-radius: 12px;
            padding: 12px 16px;
            border: 1px solid var(--border-color);
            background: var(--input-bg);
            color: var(--text-main);
            font-size: 14px;
            transition: 0.3s;
        }
        .form-control:focus, .form-select:focus {
            box-shadow: 0 0 0 4px rgba(74,127,196,0.15);
            border-color: var(--secondary);
            background: #fff;
        }

        /* Buttons */
        .btn-primary   { background: var(--primary); border-color: var(--primary); }
        .btn-primary:hover { background: var(--primary-dark); border-color: var(--primary-dark); transform: translateY(-1px); box-shadow: 0 6px 16px rgba(37,99,235,.25); }

        /* ── CAGE GRID ─────────────────────────────────────────────── */
        .cage-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 14px; margin-top: 15px; }
        .cage-slot { border: 2px solid var(--border-color); border-radius: 12px; padding: 14px 10px; text-align: center; background: #fff; transition: all 0.2s; }
        .cage-slot.occupied { border-color: #fca5a5; background: #fff1f2; }
        .cage-slot.vacant   { border-color: #6ee7b7; background: #ecfdf5; }

        /* ── CALENDAR ──────────────────────────────────────────────── */
        .fc { font-family: inherit; }
        .fc-toolbar-title { font-size: 1.3rem !important; font-weight: 800 !important; color: var(--text-heading) !important; }
        .fc-button-primary { background-color: var(--primary) !important; border-color: var(--primary) !important; font-weight: 600 !important; border-radius: 8px !important; }
        .fc-button-primary:hover { background-color: var(--primary-dark) !important; }
        .fc-button-active { background-color: var(--primary-dark) !important; }
        .fc-event { border-radius: 6px !important; padding: 2px 6px !important; font-size: 12px !important; font-weight: 600 !important; cursor: pointer; box-shadow: 0 2px 4px rgba(0,0,0,.08); transition: transform .15s; }
        .fc-event:hover { transform: scale(1.02); }

        /* ── MODALS ────────────────────────────────────────────────── */
        .modal-content { border: none; border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,0.12); }
        .modal-header  { border-bottom: 1px solid var(--border-color); }
        .modal-footer  { border-top: 1px solid var(--border-color); }

        /* ── RESPONSIVE ────────────────────────────────────────────── */
        @media (max-width: 992px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.mobile-open { transform: translateX(0); }
            .main-wrapper { margin-left: 0; padding: 20px; }
        }
    </style>
</head>
