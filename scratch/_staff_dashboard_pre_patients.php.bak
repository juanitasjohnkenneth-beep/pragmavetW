                                            <form method="POST">
                                                <input type="hidden" name="action" value="boarding_decision">
                                                <input type="hidden" name="b_id" value="<?= $b['id'] ?>">
                                                <input type="hidden" name="decision" value="Approved">
                                                <div class="modal-header">
