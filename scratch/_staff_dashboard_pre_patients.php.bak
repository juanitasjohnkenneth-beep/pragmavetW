                            <div class="text-muted text-truncate" style="font-size:11px;"><?= htmlspecialchars($t_row['client_name']) ?> · <?= date("h:i A", strtotime($t_row['appointment_time'])) ?></div>
                        </div>
                    </div>
                <?php endwhile; else: ?>
                    <p class="text-muted small" style="font-size:11px;">No remaining appointments today.</p>
                <?php endif; ?>
            </div>
