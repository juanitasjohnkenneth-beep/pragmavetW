                                                            <option value="<?= $c ?>" <?= ($is_occ) ? 'disabled' : '' ?>>
                                                                Cage #<?= $c ?> <?= ($is_occ) ? '(Occupied)' : '(Vacant)' ?>
                                                            </option>
                                                        <?php endfor; ?>
                                                    </select>
